-              "maxCombinedShaderStorageBlocks must be greater than maxCombinedUniformBlocks");
-using ProgramBufferBlockMask  = angle::BitSet<IMPLEMENTATION_MAX_SHADER_STORAGE_BUFFER_BINDINGS>;
