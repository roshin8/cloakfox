+diff --git a/third_party/rust/neqo-http3/src/conn_params.rs b/third_party/rust/neqo-http3/src/conn_params.rs
+--- a/third_party/rust/neqo-http3/src/conn_params.rs
++++ b/third_party/rust/neqo-http3/src/conn_params.rs
+@@ -13,6 +13,31 @@
+ /// Do not support HTTP Extended CONNECT by default.
+ const CONNECT_DEFAULT: bool = false;
+ const HTTP3_DATAGRAM_DEFAULT: bool = true;
++
++/// Cloakfox: HTTP/3 fingerprint profile (Akamai h3fp / JA4H input).
++/// Selects which SETTINGS frame shape the client emits on its control
++/// stream. Matches `network.http.http3.fingerprint_profile`:
++///   0 => Firefox (default — original neqo emission order and set)
++///   1 => Chrome  (different order, extra max_header_list_size)
++///   2 => Safari  (sparse, just QPACK_MAX_TABLE_CAPACITY + BLOCKED_STREAMS)
++#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
++pub enum H3FingerprintProfile {
++    #[default]
++    Firefox,
++    Chrome,
++    Safari,
++}
++
++impl H3FingerprintProfile {
++    #[must_use]
++    pub const fn from_pref(v: u32) -> Self {
++        match v {
++            1 => Self::Chrome,
++            2 => Self::Safari,
++            _ => Self::Firefox,
++        }
++    }
++}
+ 
+ #[derive(Debug, Clone)]
+ pub struct Http3Parameters {
+@@ -23,6 +48,8 @@
+     /// HTTP Extended CONNECT
+     connect: bool,
+     http3_datagram: bool,
++    /// Cloakfox: which browser's SETTINGS frame shape to emit.
++    fingerprint_profile: H3FingerprintProfile,
+ }
+ 
+ impl Default for Http3Parameters {
+@@ -34,6 +61,7 @@
+             webtransport: WEBTRANSPORT_DEFAULT,
+             connect: CONNECT_DEFAULT,
+             http3_datagram: HTTP3_DATAGRAM_DEFAULT,
++            fingerprint_profile: H3FingerprintProfile::default(),
+         }
+     }
+ }
+@@ -144,6 +172,19 @@
+             );
+         }
+         self.http3_datagram
++    }
++
++    /// Cloakfox: set the H3 fingerprint profile to emit.
++    #[must_use]
++    pub const fn fingerprint_profile(mut self, profile: H3FingerprintProfile) -> Self {
++        self.fingerprint_profile = profile;
++        self
++    }
++
++    /// Cloakfox: read the H3 fingerprint profile currently set.
++    #[must_use]
++    pub const fn get_fingerprint_profile(&self) -> H3FingerprintProfile {
++        self.fingerprint_profile
+     }
+ }
+ 
