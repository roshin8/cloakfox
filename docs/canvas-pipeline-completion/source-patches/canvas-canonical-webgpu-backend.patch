+fn create_canonical_gpu_instance(path: &str) -> Result<Arc<wgc::instance::Instance>, String> {
+    if !std::path::Path::new(path).is_absolute()
+        || !path.ends_with("/canonical-gpu/libvk_swiftshader.dylib")
+    {
+        return Err("canonical GPU library must have an absolute app-bundle path".into());
+    }
+    if !unsafe { wgpu_parent_verify_canonical_libraries() } {
+        return Err("canonical GPU bundle integrity check failed".into());
+    }
+    // SAFETY: native Gecko supplies this app-bundle path, never page content.
+    // ash owns the library and transfers its lifetime into the HAL instance.
+    let entry = unsafe { ash::Entry::load_from(path) }.map_err(|e| e.to_string())?;
+    let flags = wgt::InstanceFlags::from_build_config()
+        | wgt::InstanceFlags::AUTOMATIC_TIMESTAMP_NORMALIZATION
+        | wgt::InstanceFlags::STRICT_WEBGPU_COMPLIANCE
+        | wgt::InstanceFlags::DISCARD_HAL_LABELS;
+    let desc = wgh::InstanceDescriptor {
+        name: "Cloakfox canonical CPU Vulkan v1",
+        flags,
+        memory_budget_thresholds: wgt::MemoryBudgetThresholds {
+            for_resource_creation: Some(95),
+            for_device_loss: Some(99),
+        },
+        backend_options: Default::default(),
+        telemetry: Some(build_telemetry_struct()),
+        display: None,
+    };
+    let hal = unsafe { wgh::vulkan::Instance::init_with_entry(&desc, entry, None) }
+        .map_err(|e| format!("canonical Vulkan initialization failed: {e}"))?;
+    let mut instance = wgc::instance::Instance::from_hal_instance::<wgh::api::Vulkan>(
+        "Cloakfox canonical CPU Vulkan v1".into(),
+        hal,
+    );
+    // from_hal_instance initializes core flags to defaults. This sole Arc has
+    // no adapters/devices yet; preserve the same strict validation policy.
+    Arc::get_mut(&mut instance).unwrap().flags = flags;
+    Ok(instance)
+}
