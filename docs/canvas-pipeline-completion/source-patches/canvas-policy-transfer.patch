+template <>
+struct ParamTraits<mozilla::gfx::CanvasPrivacyMetadata> {
+  using paramType = mozilla::gfx::CanvasPrivacyMetadata;
+  static void Write(MessageWriter* aWriter, const paramType& aParam) {
+    const auto p = mozilla::gfx::NormalizeCanvasPrivacyMetadata(aParam);
+    WriteParams(aWriter, p.version, p.userContextId, p.ownerHi, p.ownerLo,
+                p.sources);
+  }
+  static bool Read(MessageReader* aReader, paramType* aResult) {
+    paramType p;
+    if (!ReadParams(aReader, p.version, p.userContextId, p.ownerHi, p.ownerLo,
+                    p.sources))
+      return false;
+    *aResult = mozilla::gfx::NormalizeCanvasPrivacyMetadata(p);
+    return true;
+  }
+};
