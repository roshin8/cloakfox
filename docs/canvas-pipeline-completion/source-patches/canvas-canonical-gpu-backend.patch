+    const int fd = open(path.get(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return -1;
+    struct stat status;
+    char resolvedFile[PATH_MAX];
+    if (fstat(fd, &status) || !S_ISREG(status.st_mode) || status.st_size < 0 ||
+        status.st_size > limit || !realpath(path.get(), resolvedFile) ||
+        strncmp(resolvedFile, resolvedBase, baseLength) ||
+        resolvedFile[baseLength] != '/' ||
+        strchr(resolvedFile + baseLength + 1, '/')) {
+      close(fd);
+      return -1;
+    }
+    *size = status.st_size;
+    return fd;
+  };
+  off_t size = 0;
+  const int manifestFd = openFile("manifest.json", 4 * 1024 * 1024, &size);
+  if (manifestFd < 0) return false;
