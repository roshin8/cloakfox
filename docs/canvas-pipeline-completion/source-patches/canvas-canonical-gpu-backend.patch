+  base.AppendLiteral("/canonical-gpu");
+  struct stat directory;
+  if (lstat(base.get(), &directory) || !S_ISDIR(directory.st_mode))
+    return false;
+  char resolvedBase[PATH_MAX];
+  if (!realpath(base.get(), resolvedBase)) return false;
+  const size_t baseLength = strlen(resolvedBase);
+  const auto openFile = [&](const char* name, off_t limit, off_t* size) {
+    nsAutoCString path(base);
+    path.Append('/');
+    path.Append(name);
