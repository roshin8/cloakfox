+  size_t offset = 0;
+  while (offset < content.size()) {
+    const auto n =
+        read(manifestFd, content.data() + offset, content.size() - offset);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) {
+      close(manifestFd);
+      return false;
+    }
+    offset += static_cast<size_t>(n);
+  }
+  close(manifestFd);
+  const auto manifest = nlohmann::json::parse(content, nullptr, false);
+  if (!manifest.is_object()) return false;
+  const auto version = manifest.find("rendererVersion");
+  if (version == manifest.end() || !version->is_number_integer() ||
+      version->get<uint64_t>() != 1)
+    return false;
