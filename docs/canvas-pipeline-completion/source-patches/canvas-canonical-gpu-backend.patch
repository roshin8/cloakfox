+/* static */
+RefPtr<GLLibraryEGL> GLLibraryEGL::GetCanonical(
+    nsACString* const out_failureId) {
+  StaticMutexAutoLock lock(sMutex);
+  if (!sCanonicalInstance) {
+    if (!VerifyCanonicalLibraries(out_failureId)) return nullptr;
+    RefPtr<GLLibraryEGL> candidate = new GLLibraryEGL;
+    candidate->mCanonicalGpu = true;
+#ifdef XP_MACOSX
+    // A separate dispatch-library suffix prevents dyld from reusing the native
+    // ANGLE GLES implementation. Never use PATH, a system library or an env
+    // var.
+    const auto load = [](const char* name) -> PRLibrary* {
+      nsAutoCString path{NS_ConvertUTF16toUTF8(gfx::gfxVars::GREDirectory())};
+      if (path.IsEmpty() || path.First() != '/') return nullptr;
+      path.Append("/canonical-gpu/");
+      path.Append(name);
+      PRLibSpec spec;
+      spec.type = PR_LibSpec_Pathname;
+      spec.value.pathname = path.get();
+      return PR_LoadLibraryWithFlags(spec, PR_LD_NOW | PR_LD_LOCAL);
+    };
+    candidate->mGLLibrary = load("libGLESv2_cloakfox_canonical.dylib");
+    candidate->mEGLLibrary = load("libEGL_cloakfox_canonical.dylib");
+#endif
+    if (!candidate->mGLLibrary || !candidate->mEGLLibrary) {
+      *out_failureId = "FEATURE_FAILURE_CANONICAL_GPU_LIBRARY"_ns;
+      return nullptr;
+    }
+    if (!candidate->Init(out_failureId) || !candidate->IsANGLE()) {
+      *out_failureId = "FEATURE_FAILURE_CANONICAL_GPU_EGL"_ns;
+      return nullptr;
+    }
+    sCanonicalInstance = candidate;
+  }
+  return sCanonicalInstance;
+}
