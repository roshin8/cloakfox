+    const auto expected = files->find(name);
+    if (expected == files->end() || !expected->is_string()) return false;
+    const auto& expectedHex = expected->get_ref<const std::string&>();
+    if (expectedHex.size() != 64) return false;
+    const int fd = openFile(name, 256 * 1024 * 1024, &size);
+    if (fd < 0) return false;
