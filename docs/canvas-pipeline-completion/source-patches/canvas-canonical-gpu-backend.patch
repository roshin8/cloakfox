+bool GLLibraryEGL::VerifyCanonicalLibraries(nsACString* const out_failureId) {
+  *out_failureId = "FEATURE_FAILURE_CANONICAL_GPU_INTEGRITY"_ns;
+#ifdef XP_MACOSX
+  nsAutoCString base{NS_ConvertUTF16toUTF8(gfx::gfxVars::GREDirectory())};
