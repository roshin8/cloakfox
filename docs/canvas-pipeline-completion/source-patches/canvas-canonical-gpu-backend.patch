+      return false;
+    }
+    uint8_t bytes[16384];
+    off_t total = 0;
+    while (true) {
+      const auto n = read(fd, bytes, sizeof(bytes));
+      if (n < 0 && errno == EINTR) continue;
+      if (n < 0) {
+        close(fd);
+        return false;
+      }
+      if (!n) break;
+      total += n;
