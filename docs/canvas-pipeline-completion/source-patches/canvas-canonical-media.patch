+// P010/P210 storage bits are not additional signal precision. Unpack before
+// range normalization so all transports of a logical 10-bit sample agree.
+static void CopyP010PlaneToPlanar10(const uint8_t* source, size_t stride,
+                                   uint16_t* dest, size_t width, size_t height,
+                                   size_t step, size_t offset) {
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      uint16_t sample;
+      memcpy(&sample, source + y * stride +
+                          (x * step + offset) * sizeof(sample), sizeof(sample));
+      *dest++ = sample >> 6;
+    }
+  }
+}
