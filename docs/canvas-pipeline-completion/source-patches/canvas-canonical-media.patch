+static nsresult ConvertCanonicalYCbCr(const layers::PlanarYCbCrData& d,
+                                      SurfaceFormat format, IntSize size,
+                                      uint8_t* output, int32_t stride,
+                                      canonical::AlphaOperation alphaOperation) {
+  using namespace canonical;
+  const unsigned depth = BitDepthForColorDepth(d.mColorDepth);
+  const unsigned bytes = depth == 8 ? 1 : 2;
+  const bool rgb =
+      format == SurfaceFormat::R8G8B8A8 || format == SurfaceFormat::R8G8B8X8;
+  const bool alpha =
+      format == SurfaceFormat::R8G8B8A8 || format == SurfaceFormat::B8G8R8A8;
+  const bool rgb565 = format == SurfaceFormat::R5G6B5_UINT16;
+  const int64_t yStride = d.mYStride < 0 ? -int64_t(d.mYStride) : d.mYStride;
+  const int64_t uvStride =
+      d.mCbCrStride < 0 ? -int64_t(d.mCbCrStride) : d.mCbCrStride;
+  if ((!rgb565 && !rgb && format != SurfaceFormat::B8G8R8A8 &&
+       format != SurfaceFormat::B8G8R8X8) ||
+      !output || !d.mYChannel || size.width <= 0 || size.height <= 0 ||
+      size.width > layers::PlanarYCbCrImage::MAX_DIMENSION ||
+      size.height > layers::PlanarYCbCrImage::MAX_DIMENSION ||
+      d.mPictureRect.IsEmpty() || d.mPictureRect.x < 0 ||
+      d.mPictureRect.y < 0 ||
+      d.mPictureRect.XMost() > layers::PlanarYCbCrImage::MAX_DIMENSION ||
+      d.mPictureRect.YMost() > layers::PlanarYCbCrImage::MAX_DIMENSION ||
+      (depth != 8 && depth != 10 && depth != 12 && depth != 16) ||
+      d.mYSkip < 0 || d.mCbSkip < 0 || d.mCrSkip < 0 ||
+      int64_t(stride) < int64_t(size.width) * (rgb565 ? 2 : 4) ||
+      yStride < int64_t(d.mPictureRect.XMost()) * (int64_t(bytes) + d.mYSkip))
+    return NS_ERROR_INVALID_ARG;
+  const bool mono = !d.mCbChannel || !d.mCrChannel || d.mCbCrStride == 0;
+  const unsigned xShift =
+      d.mChromaSubsampling == ChromaSubsampling::FULL ? 0 : 1;
+  const unsigned yShift =
+      d.mChromaSubsampling == ChromaSubsampling::HALF_WIDTH_AND_HEIGHT ? 1 : 0;
+  const int64_t chromaWidth =
+      (d.mPictureRect.XMost() + (1u << xShift) - 1) >> xShift;
+  if ((!d.mCbChannel != !d.mCrChannel) ||
+      (!mono && (uvStride < chromaWidth * (int64_t(bytes) + d.mCbSkip) ||
+                 uvStride < chromaWidth * (int64_t(bytes) + d.mCrSkip))))
+    return NS_ERROR_INVALID_ARG;
+  if (d.mAlpha &&
+      (!d.mAlpha->mChannel || d.mAlpha->mSize.width < d.mPictureRect.XMost() ||
+       d.mAlpha->mSize.height < d.mPictureRect.YMost()))
+    return NS_ERROR_INVALID_ARG;
+  const auto policy = CanonicalColorPolicy(d);
+  const uint32_t center = 128u << (depth - 8);
+  for (int32_t y = 0; y < size.height; y++) {
+    const uint32_t sy = d.mPictureRect.y + uint64_t(2 * y + 1) *
+                                               d.mPictureRect.height /
+                                               (uint64_t(2) * size.height);
+    auto* row = output + size_t(y) * stride;
+    for (int32_t x = 0; x < size.width; x++) {
+      const uint32_t sx = d.mPictureRect.x + uint64_t(2 * x + 1) *
+                                                 d.mPictureRect.width /
+                                                 (uint64_t(2) * size.width);
+      auto encoded =
+          Decode(Sample(d.mYChannel, d.mYStride, sx, sy, depth, d.mYSkip),
+                  mono ? center
+                       : Sample(d.mCbChannel, d.mCbCrStride, sx >> xShift,
+                                sy >> yShift, depth, d.mCbSkip),
+                  mono ? center
+                       : Sample(d.mCrChannel, d.mCbCrStride, sx >> xShift,
+                                sy >> yShift, depth, d.mCrSkip),
+                  depth, policy);
+      uint8_t a = 255;
+      if (d.mAlpha) {
+        const unsigned ad = BitDepthForColorDepth(d.mAlpha->mDepth);
+        if (ad != 8 && ad != 10 && ad != 12 && ad != 16)
+          return NS_ERROR_INVALID_ARG;
+        a = uint8_t(
+            (uint64_t(Sample(d.mAlpha->mChannel, d.mYStride, sx, sy, ad, 0)) *
+                 255 +
+             ((1u << ad) - 1) / 2) /
+            ((1u << ad) - 1));
+      }
+      const bool sourcePremultiplied = d.mAlpha && d.mAlpha->mPremultiplied;
+      if (sourcePremultiplied) {
+        for (auto& channel : encoded)
+          channel = a ? channel * 255.0 / a : 0.0;
+      }
+      auto pixel = Transform(encoded[0], encoded[1], encoded[2], policy);
+      const bool outputPremultiplied =
+          alphaOperation == AlphaOperation::Premultiply ||
+          (alphaOperation == AlphaOperation::None && sourcePremultiplied);
+      if (outputPremultiplied)
+        for (auto& channel : pixel)
+          channel = (uint32_t(channel) * a + 127) / 255;
+      if (rgb565) {
+        const uint16_t packed = (uint16_t(pixel[0] >> 3) << 11) |
+                                (uint16_t(pixel[1] >> 2) << 5) |
+                                (pixel[2] >> 3);
+        memcpy(row + x * 2, &packed, sizeof(packed));
+      } else {
+        row[x * 4] = pixel[rgb ? 0 : 2];
+        row[x * 4 + 1] = pixel[1];
+        row[x * 4 + 2] = pixel[rgb ? 2 : 0];
+        row[x * 4 + 3] = alpha ? a : 255;
+      }
+    }
+  }
+  return NS_OK;
+}
