+void VectorImage::RefreshCloakfoxRenderPolicy() {
+  MOZ_ASSERT(NS_IsMainThread());
+  const bool canonical = StaticPrefs::cloakfox_enabled() &&
+                         StaticPrefs::cloakfox_experimental_canvas_pipeline();
+  auto* doc =
+      mSVGDocumentWrapper ? mSVGDocumentWrapper->GetDocument() : nullptr;
+  auto* context = doc ? doc->GetPresContext() : nullptr;
+  const auto identity =
+      context ? context->GetCloakfoxFontIdentity() : Nothing();
+  const uint64_t fontIdentity = identity.valueOr(0);
+  if (mCloakfoxRenderPolicy && (*mCloakfoxRenderPolicy != canonical ||
+                                mCloakfoxFontIdentity != fontIdentity)) {
+    // VectorSurfaceKey predates renderer policies. Its cached pixels must not
+    // survive a producer change, even when the site's font seed is unchanged.
+    SurfaceCache::RemoveImage(ImageKey(this));
+  }
+  mCloakfoxRenderPolicy = Some(canonical);
+  mCloakfoxFontIdentity = fontIdentity;
+  if (doc) mSVGDocumentWrapper->FlushLayout();
+}
+
+static gfx::CanvasPrivacyMetadata CloakfoxSVGOwner(
+    SVGDocumentWrapper* wrapper) {
+  auto* doc = wrapper ? wrapper->GetDocument() : nullptr;
+  if (!StaticPrefs::cloakfox_enabled() ||
+      !StaticPrefs::cloakfox_experimental_canvas_pipeline() || !doc ||
+      doc->NodePrincipal()->IsSystemPrincipal())
+    return {};
+  const uint32_t context =
+      doc->NodePrincipal()->OriginAttributesRef().mUserContextId;
+  if (const auto owner =
+          CloakfoxSiteSeed::OwnerKey(context, doc->CookieJarSettings())) {
+    return {gfx::kCanvasPrivacyVersion, context, (*owner)[0], (*owner)[1], 0};
+  }
+  return {};
+}
+
+static bool CloakfoxSVGHasUntrackedContent(SVGDocumentWrapper* wrapper) {
+  auto* doc = wrapper ? wrapper->GetDocument() : nullptr;
+  if (!doc) return true;
+  for (nsINode* node : dom::ShadowIncludingTreeIterator(*doc)) {
+    // HTML subtrees can contain canvases, video, themed controls and other
+    // producers outside the SVG font/image observation hooks.
+    if (node->IsContent() &&
+        node->AsContent()->IsSVGElement(nsGkAtoms::foreignObject))
+      return true;
+  }
+  return false;
+}
