+// The exact color policy participates in the cache key before lookup and
+// decoder creation, including images drawn from inside SVG/filter documents.
+static uint32_t CloakfoxRasterDecodeFlags(uint32_t aFlags, bool aCanonical) {
+  if (aFlags & imgIContainer::FLAG_DECODE_NO_COLORSPACE_CONVERSION) {
+    return aFlags & ~imgIContainer::FLAG_DECODE_TO_SRGB_COLORSPACE;
+  }
+  return aCanonical ? aFlags | imgIContainer::FLAG_DECODE_TO_SRGB_COLORSPACE
+                    : aFlags;
+}
+// End Cloakfox raster producer policy.
+
+void RasterImage::RefreshCloakfoxDecodePolicy() {
+  MOZ_ASSERT(NS_IsMainThread());
+  const bool canonical = StaticPrefs::cloakfox_enabled() &&
+                         StaticPrefs::cloakfox_experimental_canvas_pipeline();
+  if (canonical != mCloakfoxCanonicalDecode) {
+    mCloakfoxCanonicalDecode = canonical;
+    mCloakfoxColorPolicyChanged = true;
+    // Animation providers use distinct color-policy cache keys. Retain timing
+    // and loop position but discard the bookkeeping for the previous decoder.
+    if (mAnimationState) mAnimationState->ResetDecoderStateForColorPolicy();
+  }
+}
+
+SurfaceFlags RasterImage::CloakfoxAnimationSurfaceFlags() const {
+  return mCloakfoxCanonicalDecode ? SurfaceFlags::TO_SRGB_COLORSPACE
+                                  : DefaultSurfaceFlags();
+}
