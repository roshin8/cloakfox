+// Cloakfox exact-owner WebGL config. Legacy MaskConfig nested getters infer
+// ctx0 on worker threads; GPU tables must follow the context's actual owner.
+static std::optional<nlohmann::json> CloakfoxWebGLValue(
+    uint32_t owner, const std::string& key) {
+  if (!StaticPrefs::cloakfox_enabled()) return std::nullopt;
+  const auto cfg = CloakfoxSiteSeed::ExactConfig(owner);
+  if (const auto value = cfg.find(key); value != cfg.end()) return *value;
+  const auto& base = MaskConfig::GetJson();
+  if (const auto value = base.find(key); value != base.end()) return *value;
+  return std::nullopt;
+}
+static std::vector<std::string> CloakfoxWebGLStringList(
+    uint32_t owner, const std::string& key) {
+  std::vector<std::string> out;
+  if (const auto values = CloakfoxWebGLValue(owner, key); values && values->is_array()) {
+    for (const auto& value : *values) {
+      if (value.is_string()) out.push_back(value.get<std::string>());
+    }
+  }
+  return out;
+}
+static std::optional<std::string> CloakfoxWebGLString(
+    uint32_t owner, const std::string& key) {
+  const auto value = CloakfoxWebGLValue(owner, key);
+  if (value && value->is_string()) return value->get<std::string>();
+  return std::nullopt;
+}
+static std::optional<nlohmann::json> CloakfoxWebGLNested(
+    uint32_t owner, const std::string& domain, const std::string& key) {
+  if (!StaticPrefs::cloakfox_enabled()) return std::nullopt;
+  const auto cfg = CloakfoxSiteSeed::ExactConfig(owner);
+  const auto lookup = [&](const nlohmann::json& source) -> std::optional<nlohmann::json> {
+    const auto table = source.find(domain);
+    if (table == source.end() || !table->is_object()) return std::nullopt;
+    const auto value = table->find(key);
+    if (value == table->end()) return std::nullopt;
+    return *value;
+  };
+  if (const auto value = lookup(cfg)) return value;
+  return lookup(MaskConfig::GetJson());
+}
+static decltype(MaskConfig::GLParam(0, false)) CloakfoxGLParam(
+    uint32_t owner, uint32_t pname, bool gl2) {
+  const auto value = CloakfoxWebGLNested(owner,
+      gl2 ? "webGl2:parameters" : "webGl:parameters", std::to_string(pname));
+  if (!value) return std::nullopt;
+  if (value->is_null()) return nullptr;
+  if (value->is_number_integer()) return value->get<int64_t>();
+  if (value->is_boolean()) return value->get<bool>();
+  if (value->is_number_float()) return value->get<double>();
+  if (value->is_string()) return value->get<std::string>();
+  return std::nullopt;
+}
+// End Cloakfox exact-owner WebGL config.
 
