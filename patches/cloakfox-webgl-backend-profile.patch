+// Cloakfox backend precision baseline. Desktop Gecko itself conservatively
+// reports integer range24/24 via GetShaderPrecisionFormatNonES2; require only
+// this shared floor, never a larger synthetic31/30 tuple unsupported by Gecko.
+static bool CloakfoxPrecisionBaseline(
+    const webgl::ShaderPrecisionFormat& native, const bool isFloat,
+    webgl::ShaderPrecisionFormat* out) {
+  const webgl::ShaderPrecisionFormat baseline = isFloat
+      ? webgl::ShaderPrecisionFormat{127, 127, 23}
+      : webgl::ShaderPrecisionFormat{24, 24, 0};
+  if (native.rangeMin < baseline.rangeMin ||
+      native.rangeMax < baseline.rangeMax ||
+      native.precision < baseline.precision) return false;
+  *out = baseline;
+  return true;
+}
+// End Cloakfox backend precision baseline.
