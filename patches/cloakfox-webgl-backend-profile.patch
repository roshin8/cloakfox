+// Cloakfox validated precision tuple. Unsupported/invalid configured fields
+// fall through to the configured missing-value policy. Legacy mode preserves
+// its valid configured mask verbatim;
+// clipping it to native precision would expose a new backend-dependent signal.
+static std::optional<webgl::ShaderPrecisionFormat> CloakfoxConfiguredPrecision(
+    const webgl::ShaderPrecisionFormat&, const nlohmann::json& configured) {
+  if (!configured.is_object()) return std::nullopt;
+  std::array<uint8_t, 3> values;
+  const char* names[] = {"rangeMin", "rangeMax", "precision"};
+  for (size_t i = 0; i < values.size(); ++i) {
+    const auto value = configured.find(names[i]);
+    if (value == configured.end() || !value->is_number_integer() ||
+        *value < 0 || *value > 255) return std::nullopt;
+    values[i] = value->get<uint8_t>();
+  }
+  return webgl::ShaderPrecisionFormat{values[0], values[1], values[2]};
+}
