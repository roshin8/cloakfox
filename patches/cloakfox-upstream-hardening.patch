+// A content allowlist must never prune the process-wide font list: the
+// browser UI and other containers share it. Providers carry a stable container
+// snapshot during parallel styling; worker paths retain their scoped context.
+/* static */
+bool gfxPlatformFontList::MaskedFontListAppliesTo(FontVisibilityProvider* provider) {
+  return StaticPrefs::cloakfox_enabled() && provider && !provider->IsChrome();
+}
+
+/* static */
+bool gfxPlatformFontList::MaskedFontListBlocks(FontVisibilityProvider* provider,
+                                               const nsACString& family) {
+  if (!MaskedFontListAppliesTo(provider)) return false;
+  uint32_t context = mozilla::dom::FontListManager::GetCurrentContext();
+  if (auto identity = provider->GetCloakfoxFontIdentity()) {
+    context = uint32_t(identity.value() >> 32);
+  }
+  nsAutoCString key(family);
+  ToLowerCase(key);
+  if (mozilla::dom::FontListManager::HasFontList(context)) {
+    return !mozilla::dom::FontListManager::IsFontAllowed(context, key);
+  }
+  // Preserve the supported environment-config fallback when a container has
+  // no font list of its own. Overlay lists still take precedence above.
+  const auto& environment = MaskConfig::GetJson();
+  if (environment.contains("fonts") && environment["fonts"].is_array()) {
+    bool hasNames = false;
+    for (const auto& name : environment["fonts"]) {
+      if (!name.is_string()) continue;
+      hasNames = true;
+      nsAutoCString allowed(name.get<std::string>().c_str());
+      ToLowerCase(allowed);
+      if (key.Equals(allowed)) return false;
+    }
+    if (hasNames) return true;
+  }
+  // Fresh profiles can render before their first persona is ready. Keep the
+  // previous conservative startup set, now restricted to content lookups.
+  static const char* const startupFonts[] = {
+    "arial", "arial black", "comic sans ms", "courier new", "georgia", "impact",
+    "times new roman", "trebuchet ms", "verdana", "tahoma", "courier", "helvetica",
+    "times", "dejavu serif", "dejavu sans", "menlo", "consolas", "dejavu sans mono"
+  };
+  for (const char* name : startupFonts) {
+    if (key.EqualsASCII(name)) return false;
+  }
+  return true;
+}
