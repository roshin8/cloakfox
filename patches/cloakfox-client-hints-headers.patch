+void HttpBaseChannel::UpdateCloakfoxClientHints() {
+  // Channel origin attributes resolved the request UA; no ambient JS caller,
+  // config cache or extension warmup is involved. Parse the *actual* UA after
+  // docshell and observer overrides, rather than rereading navigator config.
+  nsAutoCString ua;
