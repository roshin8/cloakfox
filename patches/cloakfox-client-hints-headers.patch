+// Shared, realm-independent identity parsing. Never interpolate arbitrary UA
+// bytes into structured fields: only fixed brands/platforms and numeric tokens.
+inline std::string ProductVersion(const std::string& aUA,
+                                  const std::string& aProduct) {
+  size_t at = aUA.find(aProduct + "/");
+  if (at == std::string::npos || (at && aUA[at - 1] != ' ')) return "";
+  at += aProduct.size() + 1;
+  size_t end = aUA.find(' ', at);
+  std::string version = aUA.substr(at, end - at);
+  bool digit = false;
+  for (char c : version) {
+    if (c >= '0' && c <= '9') {
+      digit = true;
+    } else if (c == '.' && digit) {
+      digit = false;
+    } else {
+      return "";
+    }
+  }
+  return digit ? version : "";
+}
+
+inline bool IsChromiumUA(const std::string& aUA) {
+  // Reject controls before parsing, including NUL (not a C-string terminator).
+  for (unsigned char c : aUA) {
+    if (c < 0x20 || c == 0x7f) return false;
+  }
+  return aUA.find("Firefox/") == std::string::npos &&
+         aUA.find("iPhone") == std::string::npos &&
+         aUA.find("iPad") == std::string::npos &&
+         (!ProductVersion(aUA, "Chrome").empty() ||
+          !ProductVersion(aUA, "Chromium").empty());
+}
+
+struct LowEntropy {
+  std::string brands;
+  std::string mobile;
+  std::string platform;
+  explicit LowEntropy(const std::string& aUA) {
+    if (!IsChromiumUA(aUA)) return;
+    std::string chromium = ProductVersion(aUA, "Chrome");
+    const bool chrome = !chromium.empty();
+    if (!chrome) chromium = ProductVersion(aUA, "Chromium");
+    std::string edge = ProductVersion(aUA, "Edg");
+    if (edge.empty()) edge = ProductVersion(aUA, "EdgA");
+    brands = "\"Not_A Brand\";v=\"99\", \"Chromium\";v=\"" +
+             chromium.substr(0, chromium.find('.')) + "\"";
+    if (chrome || !edge.empty()) {
+      const std::string& browser = edge.empty() ? chromium : edge;
+      brands += std::string(", \"") +
+                (edge.empty() ? "Google Chrome" : "Microsoft Edge") +
+                "\";v=\"" + browser.substr(0, browser.find('.')) + "\"";
+    }
+    mobile = aUA.find("Mobile") == std::string::npos ? "?0" : "?1";
+    const char* platformName = "";
+    if (aUA.find("Android") != std::string::npos)
+      platformName = "Android";
+    else if (aUA.find("Windows") != std::string::npos)
+      platformName = "Windows";
+    else if (aUA.find("Macintosh") != std::string::npos)
+      platformName = "macOS";
+    else if (aUA.find("CrOS") != std::string::npos)
+      platformName = "Chrome OS";
+    else if (aUA.find("Linux") != std::string::npos)
+      platformName = "Linux";
+    platform = std::string("\"") + platformName + "\"";
+  }
+};
+}  // namespace mozilla::net::cloakfoxhints
+#endif
