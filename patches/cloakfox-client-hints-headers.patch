+  const auto type = mLoadInfo->GetExternalContentPolicyType();
+  nsCOMPtr<nsIPrincipal> loading;
+  mLoadInfo->GetLoadingPrincipal(getter_AddRefs(loading));
+  nsIPrincipal* triggering = mLoadInfo->TriggeringPrincipal();
+  const bool document = type == ExtContentPolicy::TYPE_DOCUMENT;
+  RefPtr<dom::BrowsingContext> bc;
+  mLoadInfo->GetBrowsingContext(getter_AddRefs(bc));
+  if (!bc) mLoadInfo->GetAssociatedBrowsingContext(getter_AddRefs(bc));
+  const bool content =
+      (!loading || !loading->IsSystemPrincipal()) &&
+      (document ? bc && bc->IsContent()
+                : triggering && !triggering->IsSystemPrincipal() &&
+                      triggering->GetIsOriginPotentiallyTrustworthy());
+  dom::WindowContext* context = bc ? (type == ExtContentPolicy::TYPE_SUBDOCUMENT
+                                          ? bc->GetParentWindowContext()
+                                          : bc->GetCurrentWindowContext())
+                                   : nullptr;
+  // Existing documents include ancestor trust in their secure-context bit.
+  // Workers without a browsing context retain the principal trust gate above.
+  const bool secureCaller =
+      document || !context || context->GetIsSecureContext();
