 /* static */
+void PermissionsPolicyUtils::ApplyClientHintsDenial(Document* aDocument,
+                                                    const nsACString& aHeader) {
+  nsCOMPtr<nsISFVService> service = mozilla::net::GetSFVService();
+  nsCOMPtr<nsISFVDictionary> dictionary;
+  if (!service ||
+      NS_FAILED(service->ParseDictionary(aHeader, getter_AddRefs(dictionary))))
+    return;
+  for (const char* name : {"ch-ua", "ch-ua-mobile", "ch-ua-platform"}) {
+    nsCOMPtr<nsISFVItemOrInnerList> entry;
+    if (NS_FAILED(
+            dictionary->Get(nsDependentCString(name), getter_AddRefs(entry))))
+      continue;
+    nsCOMPtr<nsISFVInnerList> list = do_QueryInterface(entry);
+    if (!list) continue;
+    nsTArray<RefPtr<nsISFVItem>> items;
+    if (NS_SUCCEEDED(list->GetItems(items)) && items.IsEmpty()) {
+      aDocument->PermissionsPolicy()->DenyFeatureByHeader(
+          NS_ConvertASCIItoUTF16(name));
+    }
+  }
+}
