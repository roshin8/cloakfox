+// Publish policy for channel documents and the initial empty about:blank path.
+// Existing native policy objects retain their sharing; only metadata is owned.
+static void PublishCloakfoxClientHintsPolicy(Document* aDocument) {
+  RefPtr<PolicyContainer> container =
+      PolicyContainer::Cast(aDocument->GetPolicyContainer());
+  nsTArray<nsString> allowed;
+  aDocument->PermissionsPolicy()->AllowedFeatures(allowed);
+  uint8_t denied = container ? container->GetCloakfoxClientHintsDenied() : 0;
+  const char16_t* names[] = {u"ch-ua", u"ch-ua-mobile", u"ch-ua-platform"};
+  for (uint8_t i = 0; i < 3; ++i) {
+    if (!allowed.Contains(nsDependentString(names[i]))) denied |= 1 << i;
+  }
+  if (!container && !denied) return;
+  if (!container || denied != container->GetCloakfoxClientHintsDenied()) {
+    if (container)
+      container = container->CloneContainerForClientHints();
+    else
+      container = new PolicyContainer();
+    container->SetCloakfoxClientHintsDenied(denied);
+    aDocument->SetPolicyContainer(container);
+  }
+  // nsDocShell initializes an initial empty document's policy after Embed(),
+  // when its client may already exist. Refresh that client's IPC snapshot too.
+  if (nsPIDOMWindowInner* inner = aDocument->GetInnerWindow()) {
+    if (ClientSource* client = inner->GetClientSource()) {
+      client->SetPolicyContainer(container);
+      if (auto* child = aDocument->GetWindowGlobalChild()) {
+        child->SendSetClientInfo(client->Info().ToIPC());
+      }
+    }
+  }
+}
