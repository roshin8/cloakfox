+  // Permissions-Policy delegation need a separate native implementation.
+  const bool eligible =
+      StaticPrefs::cloakfox_enabled() && content && secureCaller &&
+      type != ExtContentPolicy::TYPE_WEBSOCKET &&
+      (mURI->SchemeIs("https") ||
+       (mURI->SchemeIs("http") &&
+        nsMixedContentBlocker::IsPotentiallyTrustworthyLoopbackURL(mURI))) &&
+      !nsContentUtils::ShouldResistFingerprinting(this,
+                                                  RFPTarget::HttpUserAgent);
+  const cloakfoxhints::LowEntropy hints(
+      eligible ? std::string(ua.BeginReading(), ua.Length()) : std::string());
+  const char* names[] = {"Sec-CH-UA", "Sec-CH-UA-Mobile", "Sec-CH-UA-Platform"};
+  const std::string* values[] = {&hints.brands, &hints.mobile, &hints.platform};
+  uint8_t denied = 0;
+  if (!document) {
+    nsCOMPtr<nsIPolicyContainer> policy = mLoadInfo->GetPolicyContainer();
+    if (policy) {
+      denied = PolicyContainer::Cast(policy)->GetCloakfoxClientHintsDenied();
+    }
+  }
+  for (uint8_t i = 0; i < 3; ++i) {
+    if (mCloakfoxClientHintsModified & (1 << i)) continue;
+    // Internal redirect copies explicitly skip these synthesized defaults;
+    // each new channel evaluates its own identity and trust eligibility.
+    nsresult rv = mRequestHead.SetHeader(
+        nsDependentCString(names[i]),
+        nsDependentCString((denied & (1 << i)) ? "" : values[i]->c_str()),
+        false, nsHttpHeaderArray::eVarietyRequestEnforceDefault);
+    MOZ_ASSERT(NS_SUCCEEDED(rv));
+    (void)rv;
+  }
 }
 
