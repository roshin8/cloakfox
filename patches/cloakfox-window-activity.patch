+    nsContentUtils::AddScriptRunner(NS_NewRunnableFunction(
+        "nsFocusManager::CloakfoxLogicalBlur",
+        [doc = RefPtr<Document>(&aDocument), target = RefPtr<Element>(element)] {
+          auto* fm = nsFocusManager::GetFocusManager();
+          RefPtr<PresShell> shell = doc->GetPresShell();
+          if (fm && shell && doc->ShouldMaskWindowActivity() &&
+              target->GetComposedDoc() == doc) {
