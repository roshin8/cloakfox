+bool Document::ShouldMaskWindowActivity() const {
+  // Exclude chrome, detached documents, replaced documents and the BFCache.
+  // Include parser-time scripts in newly opened background tabs. IsActive()
+  // checks attachment/BFCache membership, independently of tab visibility.
+  return ShouldMaskWindowActivityForStyle() && IsCurrentActiveDocument() &&
+         IsActive();
+}
+
+bool Document::ShouldMaskWindowActivityForStyle() const {
+  return StaticPrefs::cloakfox_enabled() &&
+         StaticPrefs::cloakfox_opt_focus_masking() && IsContentDocument() &&
+         !NodePrincipal()->IsSystemPrincipal();
+}
+
+bool Document::FullscreenForBindings(CallerType aCallerType) const {
+  return aCallerType != CallerType::System && ShouldMaskWindowActivity()
+             ? true
+             : Fullscreen();
+}
+
+bool Document::HasFocusForBindings(CallerType aCallerType,
