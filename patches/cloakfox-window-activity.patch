+void BrowsingContext::DidSet(FieldIndex<IDX_CloakfoxLogicalFocusedContextId>) {
+  // SyncedContext delivers this in each process in parent-resolved order.
+  // Only update logical CSS state; native focus, IME and stored elements stay
+  // under the existing focus action/permission machinery.
+  if (auto* fm = nsFocusManager::GetFocusManager()) {
+    PreOrderWalk([fm](BrowsingContext* bc) {
+      if (RefPtr<Document> doc = bc->GetExtantDocument();
+          doc && doc->ShouldMaskWindowActivity()) {
+        fm->RefreshCloakfoxFocusState(*doc);
+      }
+    });
+  }
+}
