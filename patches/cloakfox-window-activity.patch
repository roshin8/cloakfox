+
+bool Document::ShouldMaskWindowActivity() const {
+  // Exclude chrome, detached documents, replaced documents and the BFCache.
+  // Include parser-time scripts in newly opened background tabs. IsActive()
+  // checks attachment/BFCache membership, independently of tab visibility.
+  return ShouldMaskWindowActivityForStyle() && IsCurrentActiveDocument() &&
+         IsActive();
+}
+
+bool Document::ShouldMaskWindowActivityForStyle() const {
+  return StaticPrefs::cloakfox_enabled() &&
+         StaticPrefs::cloakfox_opt_focus_masking() && IsContentDocument() &&
+         !NodePrincipal()->IsSystemPrincipal();
+}
+
+bool Document::FullscreenForBindings(CallerType aCallerType) const {
+  return aCallerType != CallerType::System && ShouldMaskWindowActivity()
+             ? true
+             : Fullscreen();
+}
+
+bool Document::HasFocusForBindings(CallerType aCallerType,
+                                    ErrorResult& aRv) const {
+  return aCallerType != CallerType::System && ShouldMaskWindowActivity()
+             ? true
+             : HasFocus(aRv);
+}
+
+bool Document::HiddenForBindings(CallerType aCallerType) const {
+  return aCallerType != CallerType::System && ShouldMaskWindowActivity()
+             ? false
+             : Hidden();
+}
+
+dom::VisibilityState Document::VisibilityStateForBindings(
+    CallerType aCallerType) const {
+  return aCallerType != CallerType::System && ShouldMaskWindowActivity()
+             ? dom::VisibilityState::Visible
+             : VisibilityState();
+}
+
+void Document::CloakfoxActivityPrefChanged(const char*, void* aData) {
+  auto* doc = static_cast<Document*>(aData);
+  // Apply after static-pref mirrors have updated, without running page script
+  // reentrantly inside the pref notification. The runnable owns the document.
+  if (doc->IsContentDocument() && !doc->mIsGoingAway) {
+    doc->Dispatch(NewRunnableMethod("Document::RefreshCloakfoxActivityMask",
+                                   doc, &Document::RefreshCloakfoxActivityMask));
+  }
+}
+
+void Document::RefreshCloakfoxActivityMask() {
+  if (!IsContentDocument() || !IsCurrentActiveDocument() || !IsActive()) {
+    return;
+  }
+  UpdateDocumentStates(DocumentState::WINDOW_INACTIVE, true);
+  if (auto* fm = nsFocusManager::GetFocusManager()) {
+    fm->RefreshCloakfoxFocusState(*this);
+  }
+  if (auto* inner = nsGlobalWindowInner::Cast(GetInnerWindow())) {
+    inner->UpdateBackgroundState();
+  }
+  if (mPresShell) {
+    // Fullscreen selector results change with the policy even if the native
+    // FULLSCREEN bit doesn't. Invalidate cached styles on live switches.
+    if (Element* root = GetRootElement()) {
+      nsLayoutUtils::PostRestyleEvent(root, RestyleHint::RestyleSubtree(),
+                                     nsChangeHint(0));
+    }
+    mPresShell->GetPresContext()->RefreshDriver()->RefreshCloakfoxActivityMask();
+    MaybeScheduleFrameRequestCallbacks();
+  }
 }
 
