+Element* DocumentOrShadowRoot::GetFullscreenElementForBindings(
+    CallerType aCallerType) const {
+  Element* element = GetFullscreenElement();
+  if (element || aCallerType == CallerType::System || !AsNode().IsDocument() ||
+      !AsNode().OwnerDoc()->ShouldMaskWindowActivity()) {
+    return element;
+  }
+  // A windowed document reports its root as the logical fullscreen target.
+  // Shadow roots remain empty unless they contain a real fullscreen target.
+  return AsNode().OwnerDoc()->GetRootElement();
+}
