+// Layout evaluation often has no JS caller (or a caller in another container).
+// Never use MaskConfig's ambient-container getters here, including for ucid 0.
+static std::optional<nlohmann::json> CloakfoxMediaConfig(const Document* aDoc) {
+  if (!StaticPrefs::cloakfox_enabled() || aDoc->IsInChromeDocShell() ||
+      aDoc->NodePrincipal()->IsSystemPrincipal()) {
+    return std::nullopt;
+  }
+  auto cfg = MaskConfig::GetJson();
+  if (!cfg.is_object()) cfg = nlohmann::json::object();
+  cfg.update(CloakfoxSiteSeed::ExactConfig(
+      aDoc->NodePrincipal()->OriginAttributesRef().mUserContextId));
+  return cfg;
+}
+
+static int32_t CloakfoxMediaInt(const nlohmann::json& aConfig,
+                                const char* aKey, int32_t aDefault,
+                                int32_t aMin, int32_t aMax) {
+  auto at = aConfig.find(aKey);
+  if (at == aConfig.end() || !at->is_number()) return aDefault;
+  const double value = at->get<double>();
+  if (!std::isfinite(value) || std::trunc(value) != value ||
+      value < aMin || value > aMax) return aDefault;
+  return static_cast<int32_t>(value);
+}
+
+static bool CloakfoxMediaBool(const nlohmann::json& aConfig, const char* aKey) {
+  auto at = aConfig.find(aKey);
+  return at != aConfig.end() && at->is_boolean() && at->get<bool>();
+}
 
