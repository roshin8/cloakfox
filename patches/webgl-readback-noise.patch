-  return gfxUtils::GetImageBuffer(dataSurface, premultAlpha, out_format);
+  auto buffer = gfxUtils::GetImageBuffer(dataSurface, premultAlpha, out_format);
+
+  // Cloakfox: noise WebGL pixel readback the same way the 2D context is noised
+  // (CanvasRenderingContext2D.cpp). Without this the classic "webglHash" —
+  // draw a scene, then canvas.toDataURL()/toBlob() on the WebGL context — was
+  // completely unnoised and identical across containers, while the 2D canvas
+  // beside it was per-container. Uses the same canvas:seed so both surfaces
+  // stay consistent for a container, and is deterministic (unlike Gecko's
+  // Randomize path above, which re-randomises per call and would break the
+  // same-container-same-fingerprint invariant).
+  if (buffer) {
+    const uint32_t seed = MaskConfig::GetUint32("canvas:seed").value_or(0);
+    const auto size = *out_imageSize;
+    if (seed && size.width > 0 && size.height > 0) {
+      CheckedInt<uint32_t> len =
+          CheckedInt<uint32_t>(size.width) * size.height * 4;
+      if (len.isValid()) {
+        CanvasFingerprintManager::ApplyCanvasNoise(buffer.get(), len.value(),
+                                                   seed);
+      }
+    }
+  }
+  return buffer;
 }
 
