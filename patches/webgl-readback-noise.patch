   if (inProcess) {
     inProcess->ReadPixelsInto(desc, dest);
+    CloakfoxNoiseReadPixels(desc, dest);
     return true;
   }
   const auto& child = notLost->outOfProcess;
@@ -5631,6 +5675,7 @@
     Memcpy(&destRow, srcRow);
   }
 
