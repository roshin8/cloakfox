   aName.Assign(GetPermissionType());
 }
 
 already_AddRefed<PermissionStatusSink> PermissionStatus::CreateSink() {
   return MakeAndAddRef<PermissionStatusSink>(this, mName, GetPermissionType());
 }
 
 PermissionState PermissionStatus::ComputeStateFromAction(uint32_t aAction) {
+  // Capture permission status drives stream setup and revocation handling.
+  // Keep camera/microphone states and change events native: reporting prompt
+  // after a real grant makes applications discard their authorized streams.
+  // Other permissions retain the configured fingerprint privacy behavior.
+  if (mName != PermissionName::Camera &&
+      mName != PermissionName::Microphone &&
+      MaskConfig::GetBool("permissions:spoof").value_or(false)) {
+    return PermissionState::Prompt;
+  }
   nsCOMPtr<nsIGlobalObject> global = GetRelevantGlobal();
   if (NS_WARN_IF(!global)) {
     return PermissionState::Denied;
   }
 
   return ActionToPermissionState(aAction, mName, global);
 }
 
