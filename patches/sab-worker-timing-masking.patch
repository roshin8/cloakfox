+bool WorkerPrivate::ShouldUseCloakfoxTimingMasking() const {
+  AssertIsOnWorkerThread();
+  return StaticPrefs::cloakfox_enabled() &&
+         StaticPrefs::cloakfox_sab_worker_timing_masking() &&
+         !IsChromeWorker() && !mIsPrivilegedAddonGlobal &&
+         IsSharedMemoryAllowed() && CrossOriginIsolated();
+}
+
+void WorkerPrivate::StartCloakfoxTimingMasking() {
+  AssertIsOnWorkerThread();
+  MOZ_DIAGNOSTIC_ASSERT(!mCloakfoxTimingMaskingActive);
+  MOZ_DIAGNOSTIC_ASSERT(!mCloakfoxTimingTimer);
+  MOZ_DIAGNOSTIC_ASSERT(!mCloakfoxTimingState);
+  MOZ_DIAGNOSTIC_ASSERT(mCloakfoxTimingInterruptDelayMs == 0);
+  MOZ_DIAGNOSTIC_ASSERT(mCloakfoxTimingYieldDelayUs == 0);
+
+  if (!ShouldUseCloakfoxTimingMasking()) {
+    return;
+  }
+
+  const CloakfoxTiming::Key key =
+      CloakfoxTiming::LoadKey(GetOriginAttributes().mUserContextId);
+  if (!key.IsValid()) {
+    return;
+  }
+
+  const nsString& id = Id();
+  const uint64_t streamId =
+      CloakfoxWorkerTiming::HashWorkerId(id.get(), id.Length());
+  mCloakfoxTimingState = MakeUnique<CloakfoxWorkerTiming::State>(key, streamId);
+  mCloakfoxTimingInterruptDelayMs =
+      mCloakfoxTimingState->NextInterruptDelayMs();
+  mCloakfoxTimingYieldDelayUs = mCloakfoxTimingState->NextYieldUs();
+  MOZ_ASSERT(mCloakfoxTimingInterruptDelayMs >=
+             CloakfoxWorkerTiming::kMinInterruptMs);
+  MOZ_ASSERT(mCloakfoxTimingInterruptDelayMs <=
+             CloakfoxWorkerTiming::kMaxInterruptMs);
+  MOZ_ASSERT(mCloakfoxTimingYieldDelayUs <= CloakfoxWorkerTiming::kMaxYieldUs);
+  mCloakfoxTimingTimer = NS_NewTimer();
+  if (!mCloakfoxTimingTimer) {
+    mCloakfoxTimingState = nullptr;
+    mCloakfoxTimingInterruptDelayMs = 0;
+    mCloakfoxTimingYieldDelayUs = 0;
+    return;
+  }
+  if (NS_FAILED(mCloakfoxTimingTimer->SetTarget(mWorkerControlEventTarget))) {
+    mCloakfoxTimingTimer = nullptr;
+    mCloakfoxTimingState = nullptr;
+    mCloakfoxTimingInterruptDelayMs = 0;
+    mCloakfoxTimingYieldDelayUs = 0;
+    return;
+  }
+  mCloakfoxTimingMaskingActive = true;
+  if (!ArmCloakfoxTimingTimer(mCloakfoxTimingInterruptDelayMs)) {
+    StopCloakfoxTimingMasking();
+  }
+}
+
+void WorkerPrivate::StopCloakfoxTimingMasking() {
+  AssertIsOnWorkerThread();
+
+  // Callbacks and shutdown are serialized on the worker thread. Close the
+  // re-arm gate first so a callback already queued on the control target is a
+  // no-op even if timer cancellation cannot retract that queued runnable.
+  mCloakfoxTimingMaskingActive = false;
+  if (mCloakfoxTimingTimer) {
+    MOZ_ALWAYS_SUCCEEDS(mCloakfoxTimingTimer->Cancel());
+    mCloakfoxTimingTimer = nullptr;
+  }
+  mCloakfoxTimingState = nullptr;
+  mCloakfoxTimingInterruptDelayMs = 0;
+  mCloakfoxTimingYieldDelayUs = 0;
+}
+
+bool WorkerPrivate::ArmCloakfoxTimingTimer(uint32_t aDelayMs) {
+  AssertIsOnWorkerThread();
+  if (!mCloakfoxTimingMaskingActive || !mCloakfoxTimingTimer ||
+      !mCloakfoxTimingState) {
+    return false;
+  }
+
+  return NS_SUCCEEDED(mCloakfoxTimingTimer->InitWithNamedFuncCallback(
+      CloakfoxTimingTimerCallback, nullptr, aDelayMs, nsITimer::TYPE_ONE_SHOT,
+      "CloakfoxWorkerTimingTimer"_ns));
+}
+
+void WorkerPrivate::RealizeCloakfoxTimingDelay(uint32_t aDelayUs) {
+  MOZ_ASSERT(aDelayUs <= CloakfoxWorkerTiming::kMaxYieldUs);
+  if (!aDelayUs) {
+    return;
+  }
+
+  // NSPR uses 1 kHz intervals on Darwin, where converting 1..250 us yields
+  // zero, reducing the intended pause to a scheduler yield. A monotonic
+  // deadline realizes the already-keyed bounded delay without using wall time
+  // as PRNG input or intentionally introducing an unbounded OS-sleep overshoot.
+  const TimeStamp deadline =
+      TimeStamp::Now() + TimeDuration::FromMicroseconds(aDelayUs);
+  while (TimeStamp::Now() < deadline) {
+  }
+}
+
+void WorkerPrivate::RunCloakfoxTimingBoundary() {
+  AssertIsOnWorkerThread();
+  if (!mCloakfoxTimingMaskingActive || !mCloakfoxTimingTimer ||
+      !mCloakfoxTimingState) {
+    return;
+  }
+
+  RealizeCloakfoxTimingDelay(mCloakfoxTimingYieldDelayUs);
+
+  // Stop() can only run on this same worker thread, so the active check in Arm
+  // is sufficient to prevent shutdown-time re-arming without taking mMutex.
+  if (!ArmCloakfoxTimingTimer(mCloakfoxTimingInterruptDelayMs)) {
+    StopCloakfoxTimingMasking();
+  }
+}
