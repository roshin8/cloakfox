 }
 
 /* static */ bool
 RoverfoxStorageManager::GetUint(const nsAString& key, uint32_t& outValue) {
+  // cpp-first priority: cloakfox.s.<key> wins over the extension-
+  // populated roverfox.s.<key>. Lets about:cloakfox set authoritative
+  // values without racing the extension's setCanvasSeed calls.
+  {
+    nsAutoCString cppFirst;
+    if (TryGetCppFirstPref(key, cppFirst)) {
+      nsresult parseRv;
+      int64_t parsed = cppFirst.ToInteger64(&parseRv);
+      if (NS_SUCCEEDED(parseRv) && parsed >= 0) {
+        outValue = static_cast<uint32_t>(parsed);
+        return true;
+      }
+    }
+  }
   nsCString prefName = MakePrefName(key);
   nsAutoCString strValue;
   // Check local cache first (immediate reads for values set in this process)
   {
     MutexAutoLock lock(GetLocalCacheMutex());
     if (auto entry = GetLocalCache().Lookup(prefName)) {
       strValue = entry.Data();
     }
@@ -94,16 +155,25 @@
