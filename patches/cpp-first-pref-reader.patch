diff --git a/dom/base/RoverfoxStorageManager.cpp b/dom/base/RoverfoxStorageManager.cpp
--- a/dom/base/RoverfoxStorageManager.cpp
+++ b/dom/base/RoverfoxStorageManager.cpp
@@ -21,16 +21,63 @@
 
 /* static */ nsCString
 RoverfoxStorageManager::MakePrefName(const nsAString& key) {
   nsAutoCString prefName("roverfox.s.");
   AppendUTF16toUTF8(key, prefName);
   return nsCString(prefName);
 }
 
+/* static */ nsCString
+RoverfoxStorageManager::MakeCppFirstPrefName(const nsAString& key) {
+  // cpp-first pref namespace — written by about:cloakfox (chrome-
+  // privileged). Takes priority over roverfox.s.* (extension-written).
+  nsAutoCString prefName("cloakfox.s.");
+  AppendUTF16toUTF8(key, prefName);
+  return nsCString(prefName);
+}
+
+/* static */ bool
+RoverfoxStorageManager::TryGetCppFirstPref(const nsAString& key,
+                                            nsACString& outValue) {
+  nsCString prefName = MakeCppFirstPrefName(key);
+  // Worker construction warms this namespace on the main thread. Workers
+  // must read that snapshot without accessing Preferences or synchronous IPC.
+  if (!NS_IsMainThread()) {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (auto entry = GetLocalCache().Lookup(prefName)) {
+      outValue = entry.Data();
+      return true;
+    }
+    return false;
+  }
+
+  nsAutoCString v;
+  Preferences::GetCString(prefName.get(), v);
+  if (v.IsEmpty() && !XRE_IsParentProcess() && NS_IsMainThread()) {
+    ContentChild* cc = ContentChild::GetSingleton();
+    if (cc) {
+      cc->SendRoverfoxStorageGet(prefName, &v);
+    }
+  }
+  // Refresh on every main-thread lookup rather than reusing a stale snapshot.
+  // GetString returns early for cpp-first values, before its legacy cache path.
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (v.IsEmpty()) {
+      GetLocalCache().Remove(prefName);
+    } else {
+      GetLocalCache().InsertOrUpdate(prefName, nsCString(v));
+    }
+  }
+  if (v.IsEmpty()) return false;
+  outValue = v;
+  return true;
+}
+
 /* static */ void
 RoverfoxStorageManager::SetPrefValue(const nsCString& prefName,
                                       const nsCString& value) {
   // Always store locally for immediate reads in this process
   {
     MutexAutoLock lock(GetLocalCacheMutex());
     GetLocalCache().InsertOrUpdate(prefName, nsCString(value));
   }
@@ -50,16 +97,30 @@
