+// Cloakfox canonical policy. An experimental backing choice, not certification
+// of canonical fonts, image producers or GPU-derived pixels.
+static bool CloakfoxCanonicalCanvasPolicy(const nlohmann::json& aConfig,
+                                          bool aEnabled, bool aContent) {
+  const auto policy = aConfig.find("canvas:canonical_2d");
+  return aEnabled && aContent && policy != aConfig.end() &&
+         policy->is_boolean() && policy->get<bool>();
+}
+// End Cloakfox canonical policy.
+
+void CanvasRenderingContext2D::CaptureCanonicalCanvasPolicy() {
+  if (mCanonicalCanvasPolicyCaptured) return;
+  mCanonicalCanvasPolicyCaptured = true;
+  nsIPrincipal* principal = PrincipalOrNull();
+  if (!principal || principal->IsSystemPrincipal()) return;
+  mCanonicalCanvasBacking = CloakfoxCanonicalCanvasPolicy(
+      CloakfoxSiteSeed::ExactConfig(
+          principal->OriginAttributesRef().mUserContextId),
+      StaticPrefs::cloakfox_enabled(), true);
+}
