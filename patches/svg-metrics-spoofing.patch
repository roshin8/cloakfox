 float SVGTextContentElement::GetComputedTextLength() {
   SVGTextFrame* textFrame = GetSVGTextFrame();
-  return textFrame ? textFrame->GetComputedTextLength(this) : 0.0f;
+  float length = textFrame ? textFrame->GetComputedTextLength(this) : 0.0f;
+  // Cloakfox: sub-pixel noise to defeat SVG text-based font fingerprinting.
+  if (auto seed = MaskConfig::GetUint32("canvas:seed"); seed.value_or(0)) {
+    uint32_t s = seed.value() ^ static_cast<uint32_t>(length * 1000);
+    s = s * 1664525u + 1013904223u;
+    length += (static_cast<float>(s) / 4294967295.0f - 0.5f) * 0.4f;
+  }
+  return length;
 }
 
 void SVGTextContentElement::SelectSubString(uint32_t charnum, uint32_t nchars,
