--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -16657,6 +16657,19 @@
   mirror: always
   rust: true
 
+# Cloakfox: HTTP/3 fingerprint profile (Akamai h3fp / JA4H).
+# Reshapes the SETTINGS frame emitted on the H3 control stream and the
+# QPACK transport parameters to match the target browser.
+#   0 => firefox (default, no change)
+#   1 => chrome
+#   2 => safari
+# See patches/http3-fingerprint-spoofing.patch for the emitted shapes.
+- name: network.http.http3.fingerprint_profile
+  type: RelaxedAtomicUint32
+  value: 0
+  mirror: always
+  rust: true
+
 # Whether to send an mlkem768x25519 key share in HTTP/3 TLS handshakes.
 # Has no effect unless security.tls.enable_kyber is true.
 - name: network.http.http3.enable_kyber
