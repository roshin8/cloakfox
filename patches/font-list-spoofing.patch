+/* Cloakfox: Per-context font list manager */
+#include "FontListManager.h"
+
+#include <algorithm>
+#include "mozilla/Mutex.h"
+#include "mozilla/StaticPrefs_cloakfox.h"
+#include "mozilla/dom/BrowsingContext.h"
+#include "nsGlobalWindowInner.h"
+#include "xpcpublic.h"
+#include "MaskConfig.hpp"
+
+namespace mozilla {
+namespace dom {
+
+static Mutex sFontListMutex("FontListManager");
+static nsTHashMap<nsUint32HashKey, nsTHashSet<nsCString>> sFontLists;
+// Negative cache: userContextIds known to have NO per-container list (overlay
+// absent, unparseable, or without a "fonts" array). Without it, every font
+// lookup for such a container re-runs CloakConfigOverlay_Get + a full JSON
+// parse under two mutexes — thousands of parses per page on stylo threads.
+static nsTHashSet<uint32_t> sNoFontList;
+static thread_local uint32_t sCurrentContextId = 0;
+
+nsString FontListManager::DisabledKeyForUserContext(uint32_t aId) {
+  nsAutoString key;
+  key.AppendPrintf("fontlist_d_%u", aId);
+  return key;
+}
+
+void FontListManager::SetFontList(uint32_t aId, const nsAString& aFontList) {
+  nsTHashSet<nsCString> fontSet;
+  nsAutoString remaining(aFontList);
+  while (!remaining.IsEmpty()) {
+    int32_t commaPos = remaining.FindChar(',');
+    nsAutoString fontName;
+    if (commaPos >= 0) {
+      fontName = Substring(remaining, 0, commaPos);
+      remaining.Cut(0, commaPos + 1);
+    } else {
+      fontName = remaining;
+      remaining.Truncate();
+    }
+    fontName.Trim(" \t");
+    if (fontName.IsEmpty()) continue;
+    nsAutoCString utf8;
+    CopyUTF16toUTF8(fontName, utf8);
+    ToLowerCase(utf8);
+    fontSet.Insert(utf8);
+  }
+  MutexAutoLock lock(sFontListMutex);
+  sNoFontList.Remove(aId);
+  sFontLists.InsertOrUpdate(aId, std::move(fontSet));
+}
+
+// Cloakfox: lazily load the per-container font allowlist from the cloak_cfg
+// overlay ("fonts" key the persona writes for each userContextId), caching it
+// in sFontLists. This is the live cpp-first source; the legacy
+// window.setFontList() path (dormant here) still wins if it populated
+// sFontLists first. Caller must hold sFontListMutex.
+static bool EnsureFontListLoaded(uint32_t aId) {
+  if (sFontLists.Contains(aId)) return true;
+  if (sNoFontList.Contains(aId)) return false;  // negative cache: no re-parse
+  std::string js = ::CloakConfigOverlay_Get(aId);
+  if (js.empty()) {
+    // Do NOT negative-cache an ABSENT overlay. It may simply not be written
+    // yet: gfxPlatformFontList is constructed very early, before cloak_cfg_0
+    // lands on a fresh profile, and caching "no list" here would strand that
+    // container (incl. ctx 0) for the whole session even after its overlay
+    // appears. Re-checking an absent overlay is cheap (no JSON parse). Only
+    // overlays that EXIST but lack a usable fonts array are cached below —
+    // those change only via a persona regen, which (like the positive cache)
+    // is picked up on the next restart.
+    return false;
+  }
+  nlohmann::json ov = nlohmann::json::parse(js, nullptr, /*allow_exceptions*/ false);
+  if (ov.is_discarded() || !ov.contains("fonts") || !ov["fonts"].is_array()) {
+    sNoFontList.Insert(aId);
+    return false;
+  }
+  nsTHashSet<nsCString> fontSet;
+  for (const auto& f : ov["fonts"]) {
+    if (!f.is_string()) continue;
+    std::string s = f.get<std::string>();
+    std::transform(s.begin(), s.end(), s.begin(),
+                   [](unsigned char c) { return std::tolower(c); });
+    fontSet.Insert(nsCString(s.data(), s.size()));
+  }
+  if (fontSet.IsEmpty()) {
+    sNoFontList.Insert(aId);
+    return false;
+  }
+  sFontLists.InsertOrUpdate(aId, std::move(fontSet));
+  return true;
+}
+
+bool FontListManager::HasFontList(uint32_t aId) {
+  // Master switch: when cloakfox is disabled at runtime, report no list so font
+  // enumeration/rendering falls through to the real host set immediately — the
+  // cached allowlist must not keep filtering after the kill-switch is off.
+  if (!StaticPrefs::cloakfox_enabled()) return false;
+  MutexAutoLock lock(sFontListMutex);
+  return EnsureFontListLoaded(aId);
+}
+
+bool FontListManager::IsFontAllowed(uint32_t aId,
+                                     const nsACString& aFontName) {
+  if (!StaticPrefs::cloakfox_enabled()) return true;  // disabled → allow all
+  MutexAutoLock lock(sFontListMutex);
+  if (!EnsureFontListLoaded(aId)) return true;  // no per-container list → allow
+  auto entry = sFontLists.Lookup(aId);
+  return entry ? entry.Data().Contains(aFontName) : true;
+}
+
+void FontListManager::SetCurrentContext(uint32_t aId) {
+  sCurrentContextId = aId;
+}
+
+uint32_t FontListManager::GetCurrentContext() {
+  return sCurrentContextId;
+}
+
+void FontListManager::DisableFunction(uint32_t aId) {
+  RoverfoxStorageManager::PutBool(DisabledKeyForUserContext(aId), true);
+}
+
+bool FontListManager::IsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                  JSObject* aObj) {
+  // Cloakfox stealth: gate WebIDL on cloakfox-shield caller.
+  if (!nsGlobalWindowInner::IsCloakfoxShieldCaller(aCx, aObj)) return false;
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return false;
+  uint32_t id = 0;
+  if (BrowsingContext* bc = win->GetBrowsingContext()) {
+    id = bc->OriginAttributesRef().mUserContextId;
+  }
+  bool disabled = false;
+  RoverfoxStorageManager::GetBool(DisabledKeyForUserContext(id), disabled);
+  return !disabled;
+}
+
+}  // namespace dom
+}  // namespace mozilla
