-  #clearSiteData() {
-    let baseDomain = SiteDataManager.getBaseDomainFromHost(this.#uri.host);
-    SiteDataManager.remove(baseDomain);
-    this.#hidePopup();
+  async #clearSiteData() {
+    const target = this.#clearSiteDataTarget;
+    const scope = document.getElementById("trustpanel-clear-cookie-scope").value;
+    if (!target || target.browser !== gBrowser.selectedBrowser ||
+        !["container", "all"].includes(scope)) {
+      return;
+    }
+    const button = document.getElementById("trustpanel-clear-cookie-clear");
+    if (button.disabled) {
+      return;
+    }
+    button.disabled = true;
+    try {
+      if (scope === "all") {
+        await SiteDataManager.remove(target.baseDomain);
+      } else {
+        // Full-clear also includes cleaners that ignore container patterns.
+        // Use only container-aware cookies and storage cleaners here.
+        await new Promise((resolve, reject) => {
+          Services.clearData.deleteDataFromSite(
+            target.baseDomain,
+            { userContextId: target.userContextId, privateBrowsingId: target.privateBrowsingId },
+            true,
+            Ci.nsIClearDataService.CLEAR_COOKIES |
+              Ci.nsIClearDataService.CLEAR_DOM_STORAGES,
+            failedFlags => {
+              if (failedFlags) {
+                reject(new Error(`Site data clearing failed: ${failedFlags}`));
+              } else {
+                resolve();
+              }
+            }
+          );
+        });
+        await SiteDataManager.updateSites();
+      }
+      this.#clearSiteDataTarget = null;
+      this.#hidePopup();
+    } catch (error) {
+      console.error(error);
+      Services.prompt.alert(window, "Could not clear site data",
+        "Some website data could not be cleared. Please try again.");
+    } finally {
+      button.disabled = false;
+    }
   }
 
