 void HTMLMediaElement::CanPlayType(const nsAString& aType, nsAString& aResult) {
+  // Cloakfox: return a generic 'probably' for common media MIME types to
+  // hide the per-install codec support matrix (a known fingerprint vector).
+  if (MaskConfig::GetBool("codecs:spoof").value_or(false)) {
+    NS_ConvertUTF16toUTF8 t(aType);
+    if (StringBeginsWith(t, "video/mp4"_ns) ||
+        StringBeginsWith(t, "video/webm"_ns) ||
+        StringBeginsWith(t, "video/ogg"_ns) ||
+        StringBeginsWith(t, "audio/mp4"_ns) ||
+        StringBeginsWith(t, "audio/webm"_ns) ||
+        StringBeginsWith(t, "audio/ogg"_ns) ||
+        StringBeginsWith(t, "audio/mpeg"_ns) ||
+        StringBeginsWith(t, "audio/wav"_ns) ||
+        StringBeginsWith(t, "audio/flac"_ns)) {
+      // Per spec (and real Gecko) "probably" is only returned when the
+      // type carries a codecs= parameter AND every listed codec is
+      // supported; a bare container type yields "maybe". Returning
+      // "probably" for canPlayType("video/mp4") is a value no stock
+      // Firefox ever produces, so the spoof itself became a two-call
+      // browser detector.
+      if (t.Find("codecs") != kNotFound) {
+        aResult.AssignLiteral("probably");
+      } else {
+        aResult.AssignLiteral("maybe");
+      }
+      return;
+    }
+    aResult.Truncate();
+    return;
+  }
   DecoderDoctorDiagnostics diagnostics;
   CanPlayStatus canPlay = GetCanPlay(aType, &diagnostics);
   diagnostics.StoreFormatDiagnostics(OwnerDoc(), aType, canPlay != CANPLAY_NO,
                                      __func__);
   switch (canPlay) {
     case CANPLAY_NO:
       aResult.Truncate();
       break;
