+      ShouldForceProxy()) {
+    gather(false);
+    return;
+  }
+
+  nsTArray<nsCOMPtr<nsIURI>> targets;
+  for (const auto& server : mJsConfiguration.mIceServers) {
+    for (const auto& url : server.mUrls) {
+      nsAutoCString value = NS_ConvertUTF16toUTF8(url);
+      const bool tls = StringBeginsWith(value, "turns:"_ns) ||
+                       StringBeginsWith(value, "stuns:"_ns);
+      int32_t colon = value.FindChar(':');
+      if (colon < 0) {
+        gather(true);  // malformed/unresolvable routes must not become direct
+        return;
+      }
+      nsAutoCString authority(Substring(value, colon + 1));
+      int32_t query = authority.FindChar('?');
+      if (query >= 0) {
+        authority.Truncate(query);
+      }
+      nsAutoCString spec(tls ? "https://"_ns : "http://"_ns);
+      spec.Append(authority);
+      nsCOMPtr<nsIURI> uri;
+      if (NS_FAILED(NS_NewURI(getter_AddRefs(uri), spec))) {
+        gather(true);
+        return;
+      }
+      int32_t port;
+      if (NS_FAILED(uri->GetPort(&port))) {
+        gather(true);
+        return;
+      }
+      if (port == -1 && NS_FAILED(NS_MutateURI(uri).SetPort(tls ? 5349 : 3478)
+                                     .Finalize(uri))) {
+        gather(true);
+        return;
+      }
+      targets.AppendElement(std::move(uri));
+    }
+  }
+  RefPtr<IceProxyRouteLookup> lookup =
+      new IceProxyRouteLookup(std::move(targets), std::move(gather));
+  lookup->Start();
 }
 
