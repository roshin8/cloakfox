+// A required proxy is a sticky transport constraint, independent of live
+// browser prefs and proxy resolver callbacks (fast paths/failover bypass them).
+static nsresult CloakfoxRequiredProxyRoute(uint32_t aFlags, nsIProxyInfo* aInfo) {
+  if (!(aFlags & nsIProtocolProxyService::RESOLVE_REQUIRE_PROXY)) return NS_OK;
+  nsAutoCString type;
+  if (!aInfo || NS_FAILED(aInfo->GetType(type)) ||
+      (type != "http" && type != "https" && type != "masque" &&
+       type != "socks" && type != "socks4")) {
+    return NS_ERROR_PROXY_CONNECTION_REFUSED;
+  }
+  return NS_OK;
+}
