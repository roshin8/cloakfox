+  const uint64_t lookupGeneration = ++mProxyLookupGeneration;
+  const nsCString proxyPreferences = IceProxyPreferenceSnapshot();
+  const nsString proxyTargets = IceProxyTargetSnapshot(mJsConfiguration);
+  auto gather = [self = RefPtr{this}, lookupGeneration, proxyPreferences, proxyTargets](bool aRouteUsesProxy) {
+    if (self->IsClosed() || lookupGeneration != self->mProxyLookupGeneration) {
+      return;
+    }
+    if (proxyPreferences != IceProxyPreferenceSnapshot() ||
