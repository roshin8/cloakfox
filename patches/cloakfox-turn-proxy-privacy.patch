+// Resolve ICE targets with the same URI schemes/flags as WebrtcTCPSocket.
+// A configured proxy can route TURN differently from the document (PAC/system).
+class IceProxyRouteLookup final : public nsIProtocolProxyCallback {
+ public:
+  NS_DECL_ISUPPORTS
+  IceProxyRouteLookup(nsTArray<nsCOMPtr<nsIURI>>&& aTargets,
+                      std::function<void(bool)> aDone)
+      : mTargets(std::move(aTargets)), mDone(std::move(aDone)) {}
+
+  void Start() {
+    if (mTargets.IsEmpty()) {
+      Finish(false);
+      return;
+    }
+    nsCOMPtr<nsIProtocolProxyService> service =
+        do_GetService(NS_PROTOCOLPROXYSERVICE_CONTRACTID);
+    if (!service) {
+      Finish(true);
+      return;
+    }
+    nsCOMPtr<nsICancelable> request;
+    nsresult rv = service->AsyncResolve(
+        mTargets.LastElement(),
+        nsIProtocolProxyService::RESOLVE_PREFER_HTTPS_PROXY |
+            nsIProtocolProxyService::RESOLVE_ALWAYS_TUNNEL |
+            nsIProtocolProxyService::RESOLVE_PRESERVE_PAC_ERRORS,
+        this, nullptr, getter_AddRefs(request));
+    if (NS_FAILED(rv)) {
+      Finish(true);
+    }
+  }
+
+  NS_IMETHOD OnProxyAvailable(nsICancelable*, nsIChannel*, nsIProxyInfo* aInfo,
+                              nsresult aStatus) override {
+    nsAutoCString type;
+    if (NS_FAILED(aStatus) ||
+        (aInfo && (NS_FAILED(aInfo->GetType(type)) || type != "direct"))) {
+      Finish(true);
+    } else {
+      mTargets.RemoveLastElement();
+      Start();
+    }
+    return NS_OK;
+  }
+
+ private:
+  ~IceProxyRouteLookup() = default;
+  void Finish(bool aForce) {
+    auto done = std::move(mDone);
+    if (done) {
+      done(aForce);
+    }
+  }
+  nsTArray<nsCOMPtr<nsIURI>> mTargets;
+  std::function<void(bool)> mDone;
+};
+NS_IMPL_ISUPPORTS(IceProxyRouteLookup, nsIProtocolProxyCallback)
