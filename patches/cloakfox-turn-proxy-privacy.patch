+static nsString IceProxyTargetSnapshot(const RTCConfigurationInternal& aConfig) {
+  nsString snapshot;
+  for (const auto& server : aConfig.mIceServers) {
+    for (const auto& url : server.mUrls) {
+      snapshot.AppendInt(uint64_t(url.Length()));
+      snapshot.Append(':');
+      snapshot.Append(url);
+    }
+  }
+  return snapshot;
+}
+
+static nsCString IceProxyPreferenceSnapshot() {
+  nsCString snapshot;
+  for (const char* pref : {"network.proxy.type", "network.proxy.http_port",
+                          "network.proxy.ssl_port", "network.proxy.socks_port",
+                          "network.proxy.socks_version"}) {
+    snapshot.AppendInt(Preferences::GetInt(pref, 0));
+    snapshot.Append('|');
+  }
+  for (const char* pref : {"network.proxy.http", "network.proxy.ssl",
+                          "network.proxy.socks", "network.proxy.no_proxies_on",
+                          "network.proxy.autoconfig_url"}) {
+    nsAutoCString value;
+    Preferences::GetCString(pref, value);
+    snapshot.AppendInt(uint64_t(value.Length()));
+    snapshot.Append(':');
+    snapshot.Append(value);
+  }
+  snapshot.AppendInt(Preferences::GetBool("network.proxy.share_proxy_settings", false));
+  snapshot.AppendInt(Preferences::GetBool("network.proxy.allow_hijacking_localhost", false));
+  return snapshot;
+}
