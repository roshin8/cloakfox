+void BrowsingContext::DidSet(FieldIndex<IDX_InnerSizeSpoofedForRFP>,
+                             CSSIntSize aOldValue) {
+  if (GetInnerSizeSpoofedForRFP() == aOldValue) {
+    return;
+  }
+
+  // Cloakfox device-size queries use the top viewport even in fixed-size
+  // frames. Invalidate them when this replicated value changes, including
+  // documents hosted in a different process from their top-level document.
+  WalkPresContexts([](nsPresContext* aPc) {
+    if (nsGlobalWindowInner::UseCloakfoxLetterboxing(aPc->Document())) {
+      aPc->MediaFeatureValuesChanged(
+          {MediaFeatureChangeReason::SystemMetricsChange},
+          MediaFeatureChangePropagation::JustThisDocument);
+    }
+  });
+}
