diff --git a/dom/base/CloakConfigOverlay.cpp b/dom/base/CloakConfigOverlay.cpp
--- /dev/null
+++ b/dom/base/CloakConfigOverlay.cpp
@@ -0,0 +1,74 @@
+/* Cloakfox: Per-context MaskConfig overlay via RoverfoxStorageManager. */
+#include "RoverfoxStorageManager.h"
+#include "nsPIDOMWindowInlines.h"
+#include "json.hpp"
+#include "nsString.h"
+#include "nsContentUtils.h"
+#include "nsGlobalWindowInner.h"
+#include "xpcpublic.h"
+#include "mozilla/dom/BrowsingContext.h"
+#include "mozilla/StaticPrefs_cloakfox.h"
+#include "nsThreadUtils.h"
+#include <string>
+
+std::string CloakConfigOverlay_Get(uint32_t userContextId) {
+  // Master switch. cloakfox.enabled=false disables ALL spoofing globally
+  // (documented intent in cloakfox.cfg). Every C++ MaskConfig getter reads
+  // its per-container persona through this overlay, so returning an empty
+  // overlay here makes the browser present its real, unspoofed identity —
+  // even when a persona cloak_cfg is still persisted from an enabled session.
+  // Read via the StaticPrefs atomic mirror so this is correct on every thread
+  // (main + worker), not just the main thread.
+  if (!mozilla::StaticPrefs::cloakfox_enabled()) {
+    return "";
+  }
+  nsAutoString key;
+  key.AppendPrintf("cloak_cfg_%u", userContextId);
+  nsAutoString value;
+  if (mozilla::dom::RoverfoxStorageManager::GetString(key, value)) {
+    NS_ConvertUTF16toUTF8 utf8(value);
+    return std::string(utf8.get());
+  }
+  return "";
+}
+
+void CloakConfigOverlay_Set(uint32_t userContextId, const std::string& jsonStr) {
+  nsAutoString key;
+  key.AppendPrintf("cloak_cfg_%u", userContextId);
+  NS_ConvertUTF8toUTF16 value(jsonStr.c_str());
+  mozilla::dom::RoverfoxStorageManager::PutString(key, value);
+}
+
+void CloakConfigOverlay_MergeUint(uint32_t userContextId, const std::string& key, uint32_t value) {
+  std::string current = CloakConfigOverlay_Get(userContextId);
+  nlohmann::json j = current.empty() ? nlohmann::json{} :
+    (nlohmann::json::accept(current) ? nlohmann::json::parse(current) : nlohmann::json{});
+  j[key] = value;
+  CloakConfigOverlay_Set(userContextId, j.dump());
+}
+
+void CloakConfigOverlay_MergeString(uint32_t userContextId, const std::string& key, const std::string& value) {
+  std::string current = CloakConfigOverlay_Get(userContextId);
+  nlohmann::json j = current.empty() ? nlohmann::json{} :
+    (nlohmann::json::accept(current) ? nlohmann::json::parse(current) : nlohmann::json{});
+  j[key] = value;
+  CloakConfigOverlay_Set(userContextId, j.dump());
+}
+
+uint32_t CloakConfigOverlay_CurrentUserContextId() {
+  // Window/container resolution is main-thread only; workers fall back
+  // to the ctx-0 / env overlay (their fingerprints come via other paths).
+  if (!NS_IsMainThread()) return 0;
+  // Container of the currently-executing window, so the context-blind
+  // MaskConfig getters resolve their own cloak_cfg_<ucid> instead of
+  // always reading ctx 0. Returns 0 in workers / no-JS contexts, which
+  // preserves the old ctx-0 / env fallback there.
+  if (JSContext* cx = nsContentUtils::GetCurrentJSContext()) {
+    if (nsGlobalWindowInner* win = xpc::CurrentWindowOrNull(cx)) {
+      if (mozilla::dom::BrowsingContext* bc = win->GetBrowsingContext()) {
+        return bc->OriginAttributesRef().mUserContextId;
+      }
+    }
+  }
+  return 0;
+}
