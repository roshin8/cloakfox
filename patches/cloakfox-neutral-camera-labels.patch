+
+already_AddRefed<Promise> MediaDevices::GetCloakfoxCameras(
+    CallerType aCallerType, ErrorResult& aRv) {
+  nsCOMPtr<nsIGlobalObject> global = xpc::NativeGlobal(GetWrapper());
+  RefPtr<Promise> promise = Promise::Create(global, aRv);
+  if (aRv.Failed()) return nullptr;
+  if (aCallerType != CallerType::System) {
+    promise->MaybeRejectWithNotAllowedError("Camera inventory is browser-only.");
+    return promise.forget();
+  }
+  // Inventory only: no stream is opened and no permission is granted.
+  MediaManager::Get()->GetPhysicalDevices()->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [promise](RefPtr<const MediaDeviceSetRefCnt> aDevices) {
+        nsTArray<CloakfoxCameraDevice> cameras;
+        for (const auto& device : *aDevices) {
+          if (device->mMediaSource != MediaSourceEnum::Camera) continue;
+          auto& camera = *cameras.AppendElement();
+          camera.mDeviceId = device->mRawID;
+          camera.mLabel = device->mRawName;
+        }
+        promise->MaybeResolve(cameras);
+      },
+      [promise](RefPtr<MediaMgrError>&&) {
+        promise->MaybeRejectWithNotReadableError("Could not list cameras.");
+      });
+  return promise.forget();
 }
 
