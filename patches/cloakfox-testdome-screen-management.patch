+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "ScreenDetails.h"
+
+#include "mozilla/dom/ScreenDetailsBinding.h"
+#include "nsGlobalWindowInner.h"
+namespace mozilla::dom {
+NS_IMPL_CYCLE_COLLECTION_INHERITED(CloakfoxScreenDetails, DOMEventTargetHelper,
+                                   mScreens)
+NS_IMPL_ADDREF_INHERITED(CloakfoxScreenDetails, DOMEventTargetHelper)
+NS_IMPL_RELEASE_INHERITED(CloakfoxScreenDetails, DOMEventTargetHelper)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(CloakfoxScreenDetails)
+NS_INTERFACE_MAP_END_INHERITING(DOMEventTargetHelper)
+CloakfoxScreenDetails::CloakfoxScreenDetails(nsPIDOMWindowInner* aWindow)
+    : DOMEventTargetHelper(aWindow) {
+  const uint32_t count =
+      nsGlobalWindowInner::Cast(aWindow)->GetCloakfoxVirtualScreenCount();
+  for (uint32_t index = 0; index < count; ++index)
+    mScreens.AppendElement(new ScreenDetailed(aWindow, index));
+}
+void CloakfoxScreenDetails::GetScreens(
+    nsTArray<RefPtr<ScreenDetailed>>& aResult) const {
+  aResult.AppendElements(mScreens);
+}
+JSObject* CloakfoxScreenDetails::WrapObject(JSContext* aCx,
+                                    JS::Handle<JSObject*> aGivenProto) {
+  return ScreenDetails_Binding::Wrap(aCx, this, aGivenProto);
+}
+}  // namespace mozilla::dom
