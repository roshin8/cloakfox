+#include "nsGlobalWindowInner.h"
+namespace mozilla::dom {
+NS_IMPL_CYCLE_COLLECTION_INHERITED(ScreenDetailed, nsScreen)
+NS_IMPL_ADDREF_INHERITED(ScreenDetailed, nsScreen)
+NS_IMPL_RELEASE_INHERITED(ScreenDetailed, nsScreen)
