+NS_INTERFACE_MAP_END_INHERITING(nsScreen)
+ScreenDetailed::ScreenDetailed(nsPIDOMWindowInner* aWindow,
+                               uint32_t aScreenIndex)
+    : nsScreen(aWindow, aScreenIndex),
+      mIndex(aScreenIndex),
+      mCount(
+          nsGlobalWindowInner::Cast(aWindow)->GetCloakfoxVirtualScreenCount()) {
+  InitScreenOrientation(aWindow);
+}
+void ScreenDetailed::GetLabel(nsAString& aResult) const {
+  aResult.AssignLiteral("Screen");
+  if (mCount > 1) {
+    aResult.Append(' ');
+    aResult.AppendInt(mIndex + 1);
+  }
+}
+double ScreenDetailed::DevicePixelRatio() const {
+  if (auto* value = GetVirtualPresentation()) return value->mDevicePixelRatio;
+  return 1.0;
+}
