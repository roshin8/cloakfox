+// Privacy enforcement is owner-scoped; reporting a fake device list is not
+// an access control. Preserve system callers and the global kill switch.
+static bool CloakfoxMediaDisabled(nsPIDOMWindowInner* owner) {
+  if (!owner || !Preferences::GetBool("cloakfox.enabled", false)) return false;
+  auto* bc = owner->GetBrowsingContext();
+  const uint32_t ucid = bc ? bc->OriginAttributesRef().mUserContextId : 0;
+  auto enabled = MaskConfig::GetBool("mediaDevices:enabled", ucid);
+  return enabled.has_value() && !enabled.value();
+}
