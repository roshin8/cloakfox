+# Cloakfox ships .icns icons; a precompiled Xcode asset catalog is optional.
+@depends(real_branding_directory, build_environment)
+@imports("os")
+def branding_has_asset_catalog(branding, build_env):
+    return os.path.isfile(os.path.join(build_env.topsrcdir, branding, "Assets.car"))
+
+
+set_config("MOZ_BRANDING_HAS_ASSET_CATALOG", branding_has_asset_catalog)
