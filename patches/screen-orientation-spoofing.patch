 OrientationType ScreenOrientation::GetType(CallerType aCallerType,
                                            ErrorResult& aRv) const {
+  // Cloakfox: always landscape-primary on desktop profiles
+  if (auto v = MaskConfig::GetString("screen:orientation:type")) {
+    const std::string& s = v.value();
+    if (s == "landscape-primary") return OrientationType::Landscape_primary;
+    if (s == "landscape-secondary") return OrientationType::Landscape_secondary;
+    if (s == "portrait-primary") return OrientationType::Portrait_primary;
+    if (s == "portrait-secondary") return OrientationType::Portrait_secondary;
+  }
   Document* doc = GetResponsibleDocument();
   BrowsingContext* bc = doc ? doc->GetBrowsingContext() : nullptr;
   if (!bc) {
     aRv.Throw(NS_ERROR_UNEXPECTED);
     return OrientationType::Portrait_primary;
   }
 
   OrientationType orientation = bc->GetCurrentOrientationType();
