+// Experimental additive glyph protection. Extraction and metric privacy remain
+// independent, including for unsupported non-text rendering operations.
+static uint32_t CloakfoxGlyphPolicySeed(const nlohmann::json& aConfig,
+                                       uint32_t aSeed) {
+  const auto policy = aConfig.find("canvas:render_privacy");
+  return policy != aConfig.end() && policy->is_boolean() &&
+                 policy->get<bool>()
+             ? aSeed
+             : 0;
+}
+
+static double CloakfoxGlyphOffset(uint32_t aSeed, uint32_t aAxis) {
+  if (!aSeed) return 0.0;
+  uint32_t mixed = aSeed ^ (0x9e3779b9u * (aAxis + 1));
+  mixed ^= mixed >> 16;
+  mixed *= 0x7feb352du;
+  mixed ^= mixed >> 15;
+  mixed *= 0x846ca68bu;
+  mixed ^= mixed >> 16;
+  const double magnitude = double(8 + (mixed & 7)) / 128.0;
+  return mixed & 8 ? magnitude : -magnitude;
+}
+
+void CanvasRenderingContext2D::CaptureGlyphPrivacyPolicy() {
+  if (mGlyphPrivacyPolicyCaptured) return;
+  mGlyphPrivacyPolicyCaptured = true;
+  nsIPrincipal* principal = PrincipalOrNull();
+  if (!principal || principal->IsSystemPrincipal()) return;
+  const uint32_t userContextId =
+      principal->OriginAttributesRef().mUserContextId;
+  const auto config = CloakfoxSiteSeed::ExactConfig(userContextId);
+  mGlyphPrivacySeed = CloakfoxGlyphPolicySeed(
+      config, CloakfoxSiteSeed::Derive(userContextId, "canvas:seed",
+                                     GetCookieJarSettings()));
+}
+
+gfx::Point CanvasRenderingContext2D::GlyphPrivacyOffset() const {
+  // A live master-off always wins; opt-in and identity remain frozen for this
+  // context through bitmap resets, save/restore and worker ownership.
+  if (!StaticPrefs::cloakfox_enabled()) return gfx::Point();
+  return gfx::Point(CloakfoxGlyphOffset(mGlyphPrivacySeed, 0),
+                    CloakfoxGlyphOffset(mGlyphPrivacySeed, 1));
+}
