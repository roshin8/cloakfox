         [NSWorkspaceOpenConfiguration configuration];
     [config setArguments:aArguments];
     [config setCreatesNewApplicationInstance:YES];
-    [config setEnvironment:[[NSProcessInfo processInfo] environment]];
+    // NSProcessInfo can cache the startup environment. Restart state (profile,
+    // headless and automation flags) is added later, so read the current one.
+    NSMutableDictionary* environment = [NSMutableDictionary dictionary];
+    for (char** entry = *_NSGetEnviron(); *entry; ++entry) {
+      NSString* variable = [NSString stringWithUTF8String:*entry];
+      NSRange separator = [variable rangeOfString:@"="];
+      if (separator.location != NSNotFound) {
+        environment[[variable substringToIndex:separator.location]] =
+            [variable substringFromIndex:separator.location + 1];
+      }
+    }
+    [environment removeObjectForKey:@"CLOAKFOX_RESTART_BUNDLE"];
+    [config setEnvironment:environment];
 
