+// Request identity must use the channel's origin attributes, never the current
+// JS window or process-wide header caches. Context 0 is an explicit container.
+static std::optional<std::string> CloakfoxRequestHeader(
+    const char* aKey, uint32_t aUserContextId) {
+  if (!mozilla::StaticPrefs::cloakfox_enabled()) return std::nullopt;
+  const auto cfg = nlohmann::json::parse(
+      ::CloakConfigOverlay_Get(aUserContextId), nullptr, false);
+  if (cfg.is_object()) {
+    const auto value = cfg.find(aKey);
+    if (value != cfg.end() && value->is_string()) {
+      return value->get<std::string>();
+    }
+  }
+  const auto& env = MaskConfig::GetJson();
+  const auto value = env.find(aKey);
+  if (value != env.end() && value->is_string()) {
+    return value->get<std::string>();
+  }
+  return std::nullopt;
+}
+
+nsCString nsHttpHandler::UserAgentForContainer(bool aShouldResistFingerprinting,
+                                              uint32_t aUserContextId) {
+  if (auto value = CloakfoxRequestHeader("headers.User-Agent", aUserContextId)) {
+    return nsCString(value->c_str());
+  }
+  if (auto value = CloakfoxRequestHeader("navigator.userAgent", aUserContextId)) {
+    return nsCString(value->c_str());
+  }
+  return nsCString(UserAgent(aShouldResistFingerprinting));
+}
