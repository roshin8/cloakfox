+    // A new local write supersedes the previous pending acknowledgement.
+    GetPendingCppFirstWrites().Remove(prefName);
+  }
+  UpdateCppFirstPrefCache(prefName, utf8Value);
+  if (!XRE_IsParentProcess()) {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    GetPendingCppFirstWrites().InsertOrUpdate(prefName, nsCString(utf8Value));
+  }
   SetPrefValue(prefName, utf8Value);
 }
 
