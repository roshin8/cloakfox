+// Cloakfox backend capacity policy. Only integer upper-bound capacities belong
+// here: never clamp minimum offsets, alignment requirements, timeouts or state.
+static bool CloakfoxIsUpperBoundCapacity(const GLenum pname) {
+  switch (pname) {
+    case LOCAL_GL_MAX_TEXTURE_SIZE:
+    case LOCAL_GL_MAX_CUBE_MAP_TEXTURE_SIZE:
+    case LOCAL_GL_MAX_RENDERBUFFER_SIZE:
+    case LOCAL_GL_MAX_VERTEX_ATTRIBS:
+    case LOCAL_GL_MAX_TEXTURE_IMAGE_UNITS:
+    case LOCAL_GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS:
+    case LOCAL_GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS:
+    case LOCAL_GL_MAX_VERTEX_UNIFORM_VECTORS:
+    case LOCAL_GL_MAX_FRAGMENT_UNIFORM_VECTORS:
+    case LOCAL_GL_MAX_VARYING_VECTORS:
+    case LOCAL_GL_MAX_3D_TEXTURE_SIZE:
+    case LOCAL_GL_MAX_ELEMENTS_VERTICES:
+    case LOCAL_GL_MAX_ELEMENTS_INDICES:
+    case LOCAL_GL_MAX_ARRAY_TEXTURE_LAYERS:
+    case LOCAL_GL_MAX_PROGRAM_TEXEL_OFFSET:
+    case LOCAL_GL_MAX_VERTEX_UNIFORM_BLOCKS:
+    case LOCAL_GL_MAX_FRAGMENT_UNIFORM_BLOCKS:
+    case LOCAL_GL_MAX_COMBINED_UNIFORM_BLOCKS:
+    case LOCAL_GL_MAX_UNIFORM_BUFFER_BINDINGS:
+    case LOCAL_GL_MAX_UNIFORM_BLOCK_SIZE:
+    case LOCAL_GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS:
+    case LOCAL_GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS:
+    case LOCAL_GL_MAX_VERTEX_UNIFORM_COMPONENTS:
+    case LOCAL_GL_MAX_FRAGMENT_UNIFORM_COMPONENTS:
+    case LOCAL_GL_MAX_VARYING_COMPONENTS:
+    case LOCAL_GL_MAX_TRANSFORM_FEEDBACK_SEPARATE_COMPONENTS:
+    case LOCAL_GL_MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS:
+    case LOCAL_GL_MAX_TRANSFORM_FEEDBACK_SEPARATE_ATTRIBS:
+    case LOCAL_GL_MAX_SAMPLES:
+    case LOCAL_GL_MAX_ELEMENT_INDEX:
+    case LOCAL_GL_MAX_VERTEX_OUTPUT_COMPONENTS:
+    case LOCAL_GL_MAX_FRAGMENT_INPUT_COMPONENTS:
+    case LOCAL_GL_MAX_DRAW_BUFFERS:
+    case LOCAL_GL_MAX_COLOR_ATTACHMENTS:
+    case LOCAL_GL_MAX_VIEWS_OVR:
+      return true;
+    default:
+      return false;
+  }
+}
+
+static bool CloakfoxValidCapacity(const double configured) {
+  return std::isfinite(configured) && configured >= 0 &&
+         std::floor(configured) == configured;
+}
+
+static double CloakfoxBoundCapacity(const double native,
+                                   const double configured) {
+  if (!CloakfoxValidCapacity(configured)) return native;
+  return std::min(native, configured);
+}
+
+static std::optional<std::array<double, 2>> CloakfoxConfiguredPair(
+    const GLenum pname, const bool isWebGL2, const bool integer) {
+  const auto configured = MaskConfig::GetNested(
+      isWebGL2 ? "webGl2:parameters" : "webGl:parameters",
+      std::to_string(pname));
+  if (!configured || !configured->is_array() || configured->size() != 2) {
+    return std::nullopt;
+  }
+  std::array<double, 2> pair;
+  for (size_t i = 0; i < pair.size(); ++i) {
+    if (!(*configured)[i].is_number()) return std::nullopt;
+    pair[i] = (*configured)[i].get<double>();
+    if (!std::isfinite(pair[i]) || pair[i] < 0 ||
+        (integer && !CloakfoxValidCapacity(pair[i]))) {
+      return std::nullopt;
+    }
+  }
+  return pair;
+}
+
+static std::array<float, 2> CloakfoxBoundRange(
+    const std::array<float, 2>& native,
+    const std::array<double, 2>& configured) {
+  if (configured[0] > configured[1]) return native;
+  const double lower = std::max(double(native[0]), configured[0]);
+  const double upper = std::min(double(native[1]), configured[1]);
+  if (lower > upper) return native;
+  return {static_cast<float>(lower), static_cast<float>(upper)};
 }
 
