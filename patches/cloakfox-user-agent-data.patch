+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// https://wicg.github.io/ua-client-hints/#interface
+// Exposed only for an enabled Chromium UA override; Firefox personas retain
+// Firefox's original surface. Values never come from the host machine.
+dictionary NavigatorUABrandVersion {
+  DOMString brand;
+  DOMString version;
+};
+
+dictionary UALowEntropyJSON {
+  sequence<NavigatorUABrandVersion> brands;
+  boolean mobile;
+  DOMString platform;
+};
+
+dictionary UADataValues : UALowEntropyJSON {
+  DOMString architecture;
+  DOMString bitness;
+  sequence<DOMString> formFactors;
+  sequence<NavigatorUABrandVersion> fullVersionList;
+  DOMString model;
+  DOMString platformVersion;
+  DOMString uaFullVersion;
+  boolean wow64;
+};
+
+[Exposed=(Window,Worker), Func="NavigatorUAData::IsEnabled"]
+interface NavigatorUAData {
+  // Gecko 146 does not support general FrozenArray in WebIDL. A native
+  // object getter returns the frozen array, preserving its JS contract.
+  [Throws] readonly attribute object brands;
+  readonly attribute boolean mobile;
+  readonly attribute DOMString platform;
+  [NewObject, Throws] Promise<UADataValues> getHighEntropyValues(sequence<DOMString> hints);
+  [Throws] UALowEntropyJSON toJSON();
+};
+
+interface mixin NavigatorUA {
+  [SecureContext, Func="NavigatorUAData::IsEnabled"]
+  readonly attribute NavigatorUAData userAgentData;
+};
