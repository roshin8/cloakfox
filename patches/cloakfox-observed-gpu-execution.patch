+// found in the LICENSE file.
+
+#ifndef COMPILER_TRANSLATOR_TREEOPS_CLOAKFOXCLAMPTEXTUREBIAS_H_
+#define COMPILER_TRANSLATOR_TREEOPS_CLOAKFOXCLAMPTEXTUREBIAS_H_
+
+#include "compiler/translator/Compiler.h"
+#include "compiler/translator/tree_util/IntermNode_util.h"
+#include "compiler/translator/tree_util/IntermTraverse.h"
+
+#include <cmath>
+
+namespace sh
+{
+namespace cloakfox
+{
+// Use the parsed builtin operator, never its spelling: author overloads,
+// macros, explicit LOD and gradient operations retain their native semantics.
+class TextureBiasClamper final : public TIntermTraverser
+{
+  public:
+    TextureBiasClamper(TCompiler *compiler, float limit)
+        : TIntermTraverser(false, false, true), mCompiler(compiler), mLimit(limit)
+    {}
+
+  private:
+    bool visitAggregate(Visit, TIntermAggregate *node) override
+    {
+        switch (node->getOp())
+        {
+            case EOpTexture2DBias:
+            case EOpTexture2DProjBias:
+            case EOpTextureCubeBias:
+            case EOpTexture3DBias:
+            case EOpTexture3DProjBias:
+            case EOpTextureBias:
+            case EOpTextureProjBias:
+            case EOpTextureOffsetBias:
+            case EOpTextureProjOffsetBias:
+                break;
+            default:
+                return true;
+        }
+
+        auto *arguments = node->getSequence();
+        ASSERT(!arguments->empty());
+        TIntermTyped *bias = arguments->back()->getAsTyped();
+        ASSERT(bias && bias->isScalar() && bias->getBasicType() == EbtFloat);
+
+        const auto constant = [](float value) {
+            auto *data = new TConstantUnion();
+            data->setFConst(value);
+            return new TIntermConstantUnion(data, TType(EbtFloat, EbpHigh, EvqConst));
+        };
+        // Retain the original expression exactly once. Post-order traversal
+        // clamps nested texture calls before moving this argument beneath clamp.
+        TIntermSequence clampArguments = {bias, constant(-mLimit), constant(mLimit)};
+        TIntermTyped *clamped = CreateBuiltInFunctionCallNode(
+            "clamp", &clampArguments, mCompiler->getSymbolTable(), mCompiler->getShaderVersion());
+        clamped->setLine(bias->getLine());
+        arguments->back() = clamped;
+        return true;
+    }
+
+    TCompiler *const mCompiler;
+    const float mLimit;
+};
+}  // namespace cloakfox
+
+inline bool CloakfoxClampTextureBias(TCompiler *compiler, TIntermBlock *root, float limit)
+{
+    if (!(limit > 0.0f) || !std::isfinite(limit))
+    {
+        return true;
+    }
+    cloakfox::TextureBiasClamper traverser(compiler, limit);
+    root->traverse(&traverser);
+    return compiler->validateAST(root);
+}
+}  // namespace sh
+
+#endif
