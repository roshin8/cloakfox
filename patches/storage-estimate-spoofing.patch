diff --git a/dom/quota/StorageManager.cpp b/dom/quota/StorageManager.cpp
--- a/dom/quota/StorageManager.cpp
+++ b/dom/quota/StorageManager.cpp
@@ -7,6 +7,7 @@
 #include <cstdint>
 #include <cstdlib>
 
+#include "MaskConfig.hpp"
 #include "ErrorList.h"
 #include "MainThreadUtils.h"
 #include "fs/FileSystemRequestHandler.h"
@@ -767,8 +768,16 @@
 already_AddRefed<Promise> StorageManager::Persisted(ErrorResult& aRv) {
   MOZ_ASSERT(mGlobal);
 
-  return ExecuteOpOnMainOrWorkerThread(mGlobal,
-                                       RequestResolver::Type::Persisted, aRv);
+  // Cloakfox: always return false when persisted-status spoofing is enabled
+  if (MaskConfig::GetBool("storage:persisted:disabled").value_or(false)) {
+    RefPtr<Promise> promise = Promise::Create(mGlobal, aRv);
+    if (aRv.Failed()) return nullptr;
+    promise->MaybeResolve(false);
+    return promise.forget();
+  }
+
+  return ExecuteOpOnMainOrWorkerThread(mGlobal, RequestResolver::Type::Persisted,
+                                       aRv);
 }
 
 already_AddRefed<Promise> StorageManager::Persist(ErrorResult& aRv) {
@@ -781,6 +790,18 @@
 already_AddRefed<Promise> StorageManager::Estimate(ErrorResult& aRv) {
   MOZ_ASSERT(mGlobal);
 
+  // Cloakfox: return spoofed estimate values if configured
+  if (auto quota = MaskConfig::GetUint64("storage:quota")) {
+    RefPtr<Promise> promise = Promise::Create(mGlobal, aRv);
+    if (aRv.Failed()) return nullptr;
+    StorageEstimate estimate;
+    estimate.mQuota.Construct(quota.value());
+    estimate.mUsage.Construct(
+        MaskConfig::GetUint64("storage:usage").value_or(0));
+    promise->MaybeResolve(estimate);
+    return promise.forget();
+  }
+
   return ExecuteOpOnMainOrWorkerThread(mGlobal, RequestResolver::Type::Estimate,
                                        aRv);
 }
