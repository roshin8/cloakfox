+// Load only the shipped face. No font-list lookup, host fallback or platform
+// scaled-font object participates in this producer. Failed loads keep the
+// existing protected text path, including on sandboxed workers.
+CanonicalCanvasText* CanvasRenderingContext2D::GetCanonicalCanvasText() {
+  if (mCanonicalTextLoadAttempted) return mCanonicalText.get();
+  mCanonicalTextLoadAttempted = true;
+  const nsString& gre = gfxVars::GREDirectory();
+  if (gre.IsEmpty()) return nullptr;
+  nsCOMPtr<nsIFile> file;
+  if (NS_FAILED(NS_NewLocalFile(gre, getter_AddRefs(file))) ||
+      NS_FAILED(file->Append(u"fonts"_ns)) ||
+      NS_FAILED(file->Append(u"DejaVuSans.ttf"_ns))) return nullptr;
+  int64_t size = 0;
+  if (NS_FAILED(file->GetFileSize(&size)) || size <= 0 || size > 16 * 1024 * 1024)
+    return nullptr;
+  PRFileDesc* descriptor = nullptr;
+  if (NS_FAILED(file->OpenNSPRFileDesc(PR_RDONLY, 0, &descriptor))) return nullptr;
+  std::vector<char> bytes(static_cast<size_t>(size));
+  size_t done = 0;
+  while (done < bytes.size()) {
+    int32_t n = PR_Read(descriptor, bytes.data() + done,
+                        static_cast<int32_t>(bytes.size() - done));
+    if (n <= 0) break;
+    done += n;
+  }
+  PR_Close(descriptor);
+  if (done != bytes.size()) return nullptr;
+  static hb_unicode_funcs_t* unicode =
+      mozilla_harfbuzz_glue_set_up_unicode_funcs();
+  mCanonicalText = MakeUnique<CanonicalCanvasText>(bytes.data(), bytes.size(), unicode);
+  return mCanonicalText.get();
+}
+
+// Restrict v1 to an unstyled generic family. Author FontFace names and CSS
+// feature/variation/caps/spacing/vertical/bidi cases stay on guarded fallback.
+static bool CanonicalCanvasSimpleFont(const nsCString& aFont) {
+  constexpr auto suffix = "px sans-serif"_ns;
+  if (!StringEndsWith(aFont, suffix) || aFont.Length() == suffix.Length())
+    return false;
+  for (size_t i = 0; i < aFont.Length() - suffix.Length(); ++i) {
+    if ((aFont[i] < '0' || aFont[i] > '9') && aFont[i] != '.') return false;
+  }
+  return true;
+}
