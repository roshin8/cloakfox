+// Cloakfox: the UI font name coherent with the persona's claimed OS, or
+// nullptr when no persona is active (callers keep their native default).
+// Returns a static string. All targets ship in the bundled font pack, so they
+// resolve on any host. Read per-call (not a process-global static) so it
+// follows the per-container persona — same access pattern as
+// FontSpacingSeedManager::GetSeed.
+//
+// Also called from gfxMacPlatformFontList.mm (CSS2 system-font keywords). That
+// file can't include MaskConfig.hpp because nlohmann/json needs exceptions,
+// which are disabled for Objective-C++ in this directory — hence this helper.
+static const char* CloakfoxPersonaUIFont() {
+  auto platform = MaskConfig::GetString("navigator.platform");
+  if (!platform) {
+    return nullptr;
+  }
+  const std::string& p = *platform;
+  auto isPrefix = [&p](const char* p2) {
+    size_t n = std::strlen(p2);
+    return p.size() >= n &&
+           std::equal(p2, p2 + n, p.begin(), [](char a, char b) {
+             return std::tolower(static_cast<unsigned char>(a)) ==
+                    std::tolower(static_cast<unsigned char>(b));
+           });
+  };
+  if (isPrefix("win")) {
+    return "Segoe UI";
   }
+  if (isPrefix("mac")) {
+    return "Helvetica";
+  }
+  if (isPrefix("linux") || isPrefix("x11")) {
+    return "DejaVu Sans";
+  }
+  return nullptr;
 }
 
+// Cloakfox: exported for gfxMacPlatformFontList.mm. Falls back to the Mac
+// default so the call site stays a single unconditional assignment.
+const char* CloakfoxSystemFontName() {
+  const char* name = CloakfoxPersonaUIFont();
+  return name ? name : "-apple-system";
+}
+
 static void GetSystemUIFontFamilies(
     FontVisibilityProvider* aFontVisibilityProvider,
     [[maybe_unused]] nsAtom* aLangGroup, nsTArray<nsCString>& aFamilies) {
+  // Cloakfox: resolve the CSS `system-ui` generic to a persona-coherent font.
+  // Otherwise getComputedStyle() on `font-family: system-ui` reports the REAL
+  // host's UI font (SF/Helvetica on macOS, Segoe UI on Windows, Cantarell/
+  // DejaVu on Linux), contradicting navigator.platform.
+  if (const char* personaFont = CloakfoxPersonaUIFont()) {
+    aFamilies.AppendElement()->AssignASCII(personaFont);
+    return;
+  }
+
   // TODO: On macOS, use CTCreateUIFontForLanguage or such thing (though the
   // code below ends up using [NSFont systemFontOfSize: 0.0].
   nsFont systemFont;

