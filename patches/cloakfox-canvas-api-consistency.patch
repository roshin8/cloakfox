-void CanvasFingerprintManager::ApplyCanvasNoise(uint8_t* data, uint32_t length,
-                                                 uint32_t seed) {
-  if (seed == 0 || length == 0 || !data) return;
+static void ApplyCanvasNoiseBytes(uint8_t* data, uint32_t length,
+                                  uint32_t seed) {
+  if (length == 0 || !data) return;
   uint32_t state = seed;
   for (uint32_t i = 0; i + 3 < length; i += 4) {
     state = (state * 1664525u + 1013904223u);
     // High bits keep seeds separated by 1024 from sharing a noise mask.
     if (state & 0x40000000) {
       // Protect every usable RGB channel, retaining alpha and exact zeroes.
-      // This is format-agnostic: works for both RGBA (getImageData) and
-      // BGRA (GetImageBuffer/toDataURL). Skipping zero channels preserves
-      // clearRect transparency and avoids the CreepJS post-clear trap.
+      // Callers provide byte RGB channels with unchanged alpha. Canonical
+      // straight RGBA keeps 2D exports and typed readback consistent.
+      // Skipping zero channels preserves exact clears.
       for (uint32_t c = 0; c < 3; c++) {
         int32_t val = static_cast<int32_t>(data[i + c]);
         if (val == 0) continue;
@@ -45,6 +45,44 @@
             (state & 0x80000000) ? std::min(val + 1, 255) : std::max(val - 1, 1));
       }
     }
+  }
+}
+
+void CanvasFingerprintManager::ApplyCanvasNoise(uint8_t* data, uint32_t length,
+                                                 uint32_t seed) {
+  if (seed) ApplyCanvasNoiseBytes(data, length, seed);
+}
+
+// The LCG has period 2^32, so source indices can wrap modulo 2^32.
+static uint32_t AdvanceCanvasNoiseSeed(uint32_t seed, uint32_t pixels) {
+  uint32_t multiplier = 1664525u, increment = 1013904223u;
+  while (pixels) {
+    if (pixels & 1) seed = seed * multiplier + increment;
+    increment *= multiplier + 1;
+    multiplier *= multiplier;
+    pixels >>= 1;
+  }
+  return seed;
+}
+
+void CanvasFingerprintManager::ApplyCanvasNoiseRect(
+    uint8_t* data, uint32_t width, uint32_t height, uint32_t stride,
+    uint32_t canvasWidth, uint32_t sourceX, uint32_t sourceY, uint32_t seed) {
+  if (!seed || !data || !width || !height || !canvasWidth ||
+      sourceX >= canvasWidth || width > canvasWidth - sourceX ||
+      uint64_t(width) * 4 > stride) {
+    return;
+  }
+  // Callers own the allocation and validate the written rectangle. Use a wide
+  // source index before reducing to the PRNG period; never advance through
+  // destination padding or clipped-out pixels.
+  for (uint32_t row = 0; row < height; ++row) {
+    const uint32_t firstPixel = uint32_t(
+        (uint64_t(sourceY) + row) * canvasWidth + sourceX);
+    // A valid nonzero canvas seed can advance to state zero. Only the
+    // original seed selects disabled policy; zero is valid inside the LCG.
+    ApplyCanvasNoiseBytes(data + size_t(row) * stride, width * 4,
+                          AdvanceCanvasNoiseSeed(seed, firstPixel));
   }
 }
 
