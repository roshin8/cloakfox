+// Use the immutable owning global's origin attributes, including in workers.
+// Preference normalization must apply to configure() as well as support queries.
+static bool CloakfoxNormalizeHardwarePreference(nsIGlobalObject* aGlobal) {
+  if (!aGlobal || !StaticPrefs::cloakfox_enabled()) return false;
+  auto* principal = aGlobal->PrincipalOrNull();
+  if (!principal || principal->IsSystemPrincipal()) return false;
+  const auto config = CloakfoxSiteSeed::ExactConfig(
+      principal->OriginAttributesRef().mUserContextId);
+  const auto value = config.find("mediaCapabilities:spoof");
+  return value != config.end() && value->is_boolean() && value->get<bool>();
+}
+
 template <typename T>
 void ApplyResistFingerprintingImpl(const RefPtr<T>& aConfig,
                                    nsIGlobalObject* aGlobal) {
   // When resisting fingerprinting, don't reveal information about the host
   // hardware.
   if (nsContentUtils::ShouldResistFingerprinting(
-          aGlobal, RFPTarget::MediaCapabilities)) {
+          aGlobal, RFPTarget::MediaCapabilities) ||
+      CloakfoxNormalizeHardwarePreference(aGlobal)) {
     if (aConfig->mHardwareAcceleration != HardwareAcceleration::No_preference) {
       LOGW(
           "Resist fingerprinting (MediaCapabilities) enabled, overriding "
           "hardware preference");
       aConfig->mHardwareAcceleration = HardwareAcceleration::No_preference;
     }
   }
 }
