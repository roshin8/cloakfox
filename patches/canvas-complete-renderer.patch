+
+bool Device::HasCanvasPrivacyOwner(const gfx::CanvasPrivacyMetadata& aOwner) const {
+  return aOwner.version == gfx::kCanvasPrivacyVersion &&
+         mGpuPrivacyPolicy.version == gfx::kCanvasPrivacyVersion &&
+         (aOwner.ownerHi || aOwner.ownerLo) &&
+         aOwner.userContextId == mGpuPrivacyPolicy.userContextId &&
+         aOwner.ownerHi == mGpuPrivacyPolicy.ownerHi &&
+         aOwner.ownerLo == mGpuPrivacyPolicy.ownerLo;
+}
+
+bool Device::AcceptExternalGpuInput(gfx::CanvasPrivacyMetadata aSource) {
+  aSource = gfx::NormalizeCanvasPrivacyMetadata(aSource);
+  const bool verified = gfx::CanImportCanonicalCanvasPixels(aSource);
+  const bool sameOwner =
+      aSource.version == gfx::kCanvasPrivacyVersion &&
+      mGpuPrivacyPolicy.version == gfx::kCanvasPrivacyVersion &&
+      aSource.userContextId == mGpuPrivacyPolicy.userContextId &&
+      aSource.ownerHi == mGpuPrivacyPolicy.ownerHi &&
+      aSource.ownerLo == mGpuPrivacyPolicy.ownerLo;
+  const bool accepted = verified && (aSource.version == 0 || sameOwner);
+  if (!accepted) aSource.sources |= uint32_t(gfx::CanvasPixelSource::Unknown);
+  RecordExternalGpuSource(aSource);
+  return !mCanonicalGpu || accepted;
+}
+
+void Device::RecordExternalGpuSource(gfx::CanvasPrivacyMetadata aSource) {
+  aSource = gfx::NormalizeCanvasPrivacyMetadata(aSource);
+  // Validate the individual producer before union: later canonical output
+  // must not lend its marker to a same-owner native GPU/media input.
+  const bool canImport = gfx::CanImportCanonicalCanvasPixels(aSource);
+  if (canImport && aSource.version == 0) {
+    // Never reclassify an aggregate union: raster and media were individually
+    // verified, and may be mixed without borrowing proof from one another.
+    mOwnerlessGpuSources |= aSource.sources;
+    return;
+  }
+  if (!canImport) {
+    aSource.sources |= uint32_t(gfx::CanvasPixelSource::Unknown);
+  }
+  if (!mHasExternalGpuSources) {
+    mHasExternalGpuSources = true;
+    mExternalGpuSources = aSource;
+  } else {
+    mExternalGpuSources = gfx::MergeCanvasPrivacyMetadata(mExternalGpuSources, aSource);
+  }
+}
+
+uint32_t Device::ExternalGpuSourcesFor(const gfx::CanvasPrivacyMetadata& aOwner) const {
+  if (!mHasExternalGpuSources) return mOwnerlessGpuSources;
+  uint32_t sources = mOwnerlessGpuSources | mExternalGpuSources.sources;
+  if (!gfx::CanImportCanonicalCanvasPixels(mExternalGpuSources) ||
+      mExternalGpuSources.version != gfx::kCanvasPrivacyVersion ||
+      aOwner.version != gfx::kCanvasPrivacyVersion ||
+      mExternalGpuSources.userContextId != aOwner.userContextId ||
+      mExternalGpuSources.ownerHi != aOwner.ownerHi ||
+      mExternalGpuSources.ownerLo != aOwner.ownerLo) {
+    sources |= uint32_t(gfx::CanvasPixelSource::Unknown);
+  }
+  return sources;
+}
+
