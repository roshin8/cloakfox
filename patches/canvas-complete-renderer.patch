+static canonical::ColorPolicy CanonicalColorPolicy(
+    const layers::PlanarYCbCrData& d) {
+  using namespace canonical;
+  ColorPolicy policy{canonical::Matrix::BT709, Primaries::SRGB, Transfer::BT709,
+                     d.mColorRange == ColorRange::FULL};
+  switch (d.mYUVColorSpace) {
+    case YUVColorSpace::BT601:
+      policy.matrix = canonical::Matrix::BT601;
+      break;
+    case YUVColorSpace::BT2020:
+      policy.matrix = canonical::Matrix::BT2020;
+      break;
+    case YUVColorSpace::Identity:
+      policy.matrix = canonical::Matrix::Identity;
+      break;
+    default:
+      break;
+  }
+  switch (d.mColorPrimaries) {
+    case ColorSpace2::BT601_525:
+      policy.primaries = Primaries::BT601_525;
+      break;
+    case ColorSpace2::DISPLAY_P3:
+      policy.primaries = Primaries::P3;
+      break;
+    case ColorSpace2::BT2020:
+      policy.primaries = Primaries::BT2020;
+      break;
+    case ColorSpace2::UNKNOWN:
+      if (d.mYUVColorSpace == YUVColorSpace::BT2020)
+        policy.primaries = Primaries::BT2020;
+      else if (d.mYUVColorSpace == YUVColorSpace::BT601)
+        policy.primaries = Primaries::BT601_525;
+      break;
+    default:
+      break;
+  }
+  switch (d.mTransferFunction) {
+    case TransferFunction::SRGB:
+      policy.transfer = Transfer::SRGB;
+      break;
+    case TransferFunction::PQ:
+      policy.transfer = Transfer::PQ;
+      break;
+    case TransferFunction::HLG:
+      policy.transfer = Transfer::HLG;
+      break;
+    case TransferFunction::LINEAR:
+      policy.transfer = Transfer::Linear;
+      break;
+    default:
+      break;
+  }
+  return policy;
+}
