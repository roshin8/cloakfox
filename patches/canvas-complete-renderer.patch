+static CloakfoxBitmapExtraction CloakfoxBitmapExportPolicy(
+    bool aEnabled, bool aContent, bool aCanonicalRequested,
+    const gfx::CanvasPrivacyMetadata& aSource,
+    const gfx::CanvasPrivacyMetadata& aOwner, uint32_t aFallbackSeed) {
+  if (!aEnabled || !aContent) return CloakfoxBitmapExtraction::Native;
