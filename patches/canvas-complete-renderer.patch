+    if (total != size || !CC_SHA256_Final(hash, &digest)) return false;
+    static constexpr char hex[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof(hash); ++i) {
+      if (expectedHex[2 * i] != hex[hash[i] >> 4] ||
+          expectedHex[2 * i + 1] != hex[hash[i] & 15])
