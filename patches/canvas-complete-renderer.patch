+                                (pixel[2] >> 3);
+        memcpy(row + x * 2, &packed, sizeof(packed));
+      } else {
+        row[x * 4] = pixel[rgb ? 0 : 2];
+        row[x * 4 + 1] = pixel[1];
+        row[x * 4 + 2] = pixel[rgb ? 2 : 0];
+        row[x * 4 + 3] = alpha ? a : 255;
+      }
+    }
+  }
+  return NS_OK;
 }
 
+nsresult CanonicalizeRGBSurface(uint8_t* output, int32_t stride, IntSize size,
+                                SurfaceFormat format, ColorSpace2 primaries,
+                                TransferFunction transfer, bool premultiplied) {
+  const bool rgb =
+      format == SurfaceFormat::R8G8B8A8 || format == SurfaceFormat::R8G8B8X8;
+  const bool alpha =
+      format == SurfaceFormat::R8G8B8A8 || format == SurfaceFormat::B8G8R8A8;
+  if (!output || size.width <= 0 || size.height <= 0 ||
+      int64_t(stride) < int64_t(size.width) * 4 ||
+      (!rgb && format != SurfaceFormat::B8G8R8A8 &&
+       format != SurfaceFormat::B8G8R8X8))
+    return NS_ERROR_INVALID_ARG;
+  // Preserve byte-exact authored sRGB, including hidden RGB under zero alpha.
+  if ((primaries == ColorSpace2::UNKNOWN || primaries == ColorSpace2::SRGB ||
+       primaries == ColorSpace2::BT709) &&
+      transfer == TransferFunction::SRGB)
+    return NS_OK;
+  layers::PlanarYCbCrData d;
+  d.mYUVColorSpace = YUVColorSpace::Identity;
+  d.mColorPrimaries = primaries;
+  d.mTransferFunction = transfer;
+  d.mColorRange = ColorRange::FULL;
+  const auto policy = CanonicalColorPolicy(d);
+  for (int32_t y = 0; y < size.height; y++) {
+    auto* row = output + size_t(y) * stride;
+    for (int32_t x = 0; x < size.width; x++) {
+      auto* pixel = row + x * 4;
+      const uint8_t a = alpha ? pixel[3] : 255;
+      if (!a) continue;
+      const double denominator = premultiplied ? a : 255;
+      const auto transformed = canonical::Transform(
+          pixel[rgb ? 0 : 2] / denominator, pixel[1] / denominator,
+          pixel[rgb ? 2 : 0] / denominator, policy);
+      for (unsigned c = 0; c < 3; c++)
+        pixel[rgb ? c : 2 - c] =
+            premultiplied ? uint8_t((uint32_t(transformed[c]) * a + 127) / 255)
+                          : transformed[c];
+    }
+  }
+  return NS_OK;
+}
