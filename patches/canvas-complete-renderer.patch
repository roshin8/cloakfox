+void OffscreenCanvas::CaptureCanvasPrivacyPolicy() {
+  if (!StaticPrefs::cloakfox_enabled()) return;
+  nsIPrincipal* principal =
+      GetRelevantGlobal() ? GetRelevantGlobal()->PrincipalOrNull() : nullptr;
+  if (!principal || principal->IsSystemPrincipal()) return;
+  const uint32_t userContextId =
+      principal->OriginAttributesRef().mUserContextId;
+  // Font selection must use the sending canvas owner even if an unused
+  // OffscreenCanvas crosses workers before any text context is requested.
+  // This is the same derivation used by nsPresContext for HTML/SVG fonts.
+  auto* settings = GetCookieJarSettings();
+  const uint32_t fontSeed = CloakfoxSiteSeed::Derive(
+      userContextId, "fonts:spacing_seed", settings);
+  mCloakfoxFontIdentity = Some((uint64_t(userContextId) << 32) | fontSeed);
+  // Freeze the requested renderer before config/owner readiness. Missing
+  // ownership keeps provenance unknown; it must never select a host renderer.
+  mCanonicalCanvasBackingPolicy =
+      StaticPrefs::cloakfox_experimental_canvas_pipeline();
+  const auto owner =
+      CloakfoxSiteSeed::OwnerKey(userContextId, GetCookieJarSettings());
+  if (!owner) return;
+  mCanvasPrivacyPolicy = {gfx::kCanvasPrivacyVersion, userContextId,
+                          (*owner)[0], (*owner)[1],
+                          uint32_t(gfx::CanvasPixelSource::Unknown)};
+}
