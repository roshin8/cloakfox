+gfx::CanvasPrivacyMetadata ClientWebGLContext::GetCanvasPrivacyMetadata() const {
+  auto metadata = mCloakfoxGpuPrivacyPolicy;
+  metadata.sources |= mCloakfoxGpuImportedSources;
+  metadata.sources |= uint32_t(gfx::CanvasPixelSource::GPU);
+  if (mNotLost && mNotLost->info.options.cloakfoxCanonicalGpu) {
+    metadata.sources |= uint32_t(gfx::CanvasPixelSource::CanonicalGPU);
+  } else {
+    // Imported canonical pixels cannot certify this context's native shader
+    // arithmetic or an absent/lost backend.
+    metadata.sources |= uint32_t(gfx::CanvasPixelSource::Unknown);
+  }
+  return gfx::NormalizeCanvasPrivacyMetadata(metadata);
+}
