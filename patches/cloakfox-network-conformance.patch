+  COMMON_SOCKET_CONTROL_ASSERT_ON_OWNING_THREAD();
+  aSettings.Truncate();
+  if (!mFd) return NS_OK;
+  nsCString buffer;
+  buffer.SetLength(65535);
+  unsigned int length = 0;
+  if (SSL_CloakfoxGetApplicationSettings(mFd,
+      reinterpret_cast<unsigned char*>(buffer.BeginWriting()), &length,
+      buffer.Length()) != SECSuccess) return NS_ERROR_FAILURE;
+  buffer.Truncate(length);
+  aSettings.Assign(buffer);
+  return NS_OK;
+}
