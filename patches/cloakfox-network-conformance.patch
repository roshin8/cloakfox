+nsresult Http2Session::ApplyPeerSetting(uint16_t id, uint32_t value) {
+    switch (id) {
+      case SETTINGS_TYPE_HEADER_TABLE_SIZE:
+        LOG3(("Compression header table setting received: %d\n", value));
+        this->mCompressor.SetMaxBufferSize(value);
+        break;
+
+      case SETTINGS_TYPE_ENABLE_PUSH:
+        LOG3(("Client received an ENABLE Push SETTING. Odd.\n"));
+        // nop
+        break;
+
+      case SETTINGS_TYPE_MAX_CONCURRENT:
+        this->mMaxConcurrent = value;
+        glean::spdy::settings_max_streams.AccumulateSingleSample(value);
+        this->ProcessPending();
+        break;
+
+      case SETTINGS_TYPE_INITIAL_WINDOW: {
+        // ALPS and ordinary SETTINGS share the RFC 9113 upper bound.
+        if (value > 0x7fffffff) {
+          return this->SessionError(FLOW_CONTROL_ERROR);
+        }
+        int32_t delta = value - this->mServerInitialStreamWindow;
+        this->mServerInitialStreamWindow = value;
+
+        // SETTINGS only adjusts stream windows. Leave the session window alone.
+        // We need to add the delta to all open streams (delta can be negative)
+        for (const auto& stream : this->mStreamTransactionHash.Values()) {
+          stream->UpdateServerReceiveWindow(delta);
+        }
+      } break;
+
+      case SETTINGS_TYPE_MAX_FRAME_SIZE: {
+        if ((value < kMaxFrameData) || (value >= 0x01000000)) {
+          LOG3(("Received invalid max frame size 0x%X", value));
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        // We stick to the default for simplicity's sake, so nothing to change
+      } break;
+
+      case SETTINGS_TYPE_ENABLE_CONNECT_PROTOCOL: {
+        if (value == 1) {
+          LOG3(("Enabling extended CONNECT"));
+          this->mPeerAllowsExtendedCONNECT = true;
+        } else if (value > 1) {
+          LOG3(("Peer sent invalid value for ENABLE_CONNECT_PROTOCOL %d",
+                value));
+          return this->SessionError(PROTOCOL_ERROR);
+        } else if (this->mPeerAllowsExtendedCONNECT) {
+          LOG3(("Peer tried to re-disable extended CONNECT"));
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        this->mHasTransactionWaitingForExtendedCONNECT = true;
+      } break;
+
+      case SETTINGS_WEBTRANSPORT_MAX_SESSIONS: {
+        // If the value is 0, the server doesn't want to accept webtransport
+        // session. An error will ultimately be returned when the transaction
+        // attempts to create a webtransport session.
+        LOG3(("SETTINGS_WEBTRANSPORT_MAX_SESSIONS set to %u", value));
+        this->mWebTransportMaxSessions = value;
+      } break;
+
+      case SETTINGS_WEBTRANSPORT_INITIAL_MAX_DATA: {
+        if (!this->mPeerAllowsExtendedCONNECT) {
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        this->mInitialWebTransportMaxData = value;
+      } break;
+
+      case SETTINGS_WEBTRANSPORT_INITIAL_MAX_STREAM_DATA_UNI: {
+        if (!this->mPeerAllowsExtendedCONNECT) {
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        this->mInitialWebTransportMaxStreamDataUnidi = value;
+      } break;
+
+      case SETTINGS_WEBTRANSPORT_INITIAL_MAX_STREAM_DATA_BIDI: {
+        if (!this->mPeerAllowsExtendedCONNECT) {
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        this->mInitialWebTransportMaxStreamDataBidi = value;
+      } break;
+
+      case SETTINGS_WEBTRANSPORT_INITIAL_MAX_STREAMS_UNI: {
+        if (!this->mPeerAllowsExtendedCONNECT) {
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        this->mInitialWebTransportMaxStreamsUnidi = value;
+      } break;
+
+      case SETTINGS_WEBTRANSPORT_INITIAL_MAX_STREAMS_BIDI: {
+        if (!this->mPeerAllowsExtendedCONNECT) {
+          return this->SessionError(PROTOCOL_ERROR);
+        }
+        this->mInitialWebTransportMaxStreamsBidi = value;
+      } break;
+
+      default:
+        LOG3(("Received an unknown SETTING id %d. Ignoring.", id));
+        break;
+    }
+  return NS_OK;
+}
+
+nsresult Http2Session::ApplyApplicationSettings(nsITLSSocketControl* ssl) {
+  nsAutoCString data;
+  nsresult rv = ssl->GetPeerApplicationSettings(data);
+  if (NS_FAILED(rv)) return rv;
+  const auto* bytes = reinterpret_cast<const uint8_t*>(data.BeginReading());
+  size_t offset = 0;
+  while (offset < data.Length()) {
+    if (data.Length() - offset < kFrameHeaderBytes) return SessionError(PROTOCOL_ERROR);
+    const uint32_t length = (uint32_t(bytes[offset]) << 16) |
+                            (uint32_t(bytes[offset + 1]) << 8) | bytes[offset + 2];
+    const uint8_t type = bytes[offset + 3], flags = bytes[offset + 4];
+    const uint32_t stream = NetworkEndian::readUint32(bytes + offset + 5) & 0x7fffffff;
+    offset += kFrameHeaderBytes;
+    if (length > kMaxFrameData || length > data.Length() - offset) return SessionError(PROTOCOL_ERROR);
+    if (type == FRAME_TYPE_SETTINGS) {
+      if (stream || (flags & kFlag_ACK) || length % 6) return SessionError(PROTOCOL_ERROR);
+      for (size_t entry = 0; entry < length; entry += 6) {
+        rv = ApplyPeerSetting(NetworkEndian::readUint16(bytes + offset + entry),
+                              NetworkEndian::readUint32(bytes + offset + entry + 2));
+        if (NS_FAILED(rv)) return rv;
+      }
+    } else if (type <= FRAME_TYPE_CONTINUATION) {
+      // ALPS prohibits ordinary HTTP2 data/control frames besides SETTINGS.
+      return SessionError(PROTOCOL_ERROR);
+    } else if (type == 0x89) {
+      // ACCEPT_CH is advisory. Parse its framing; this browser does not opt
+      // into unsolicited client hints merely because a TLS extension asks.
+      if (stream || flags) return SessionError(PROTOCOL_ERROR);
+      size_t cursor = 0;
+      while (cursor < length) {
+        for (unsigned int field = 0; field < 2; ++field) {
+          if (length - cursor < 2) return SessionError(PROTOCOL_ERROR);
+          const uint16_t size = NetworkEndian::readUint16(bytes + offset + cursor);
+          cursor += 2;
+          if (size > length - cursor) return SessionError(PROTOCOL_ERROR);
+          cursor += size;
+        }
+      }
+    }
+    offset += length;
+  }
+  // ALPS SETTINGS are not ordinary stream frames: no SETTINGS ACK is sent
+  // and the peer still sends its mandatory HTTP2 SETTINGS preface.
+  mApplicationSettingsApplied = true;
+  return NS_OK;
+}
