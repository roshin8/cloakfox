+
+/* static */ void
+RoverfoxStorageManager::UpdateCppFirstPrefCache(const nsCString& prefName,
+                                               const nsCString& value) {
+  MOZ_ASSERT(NS_IsMainThread());
+  MutexAutoLock lock(GetLocalCacheMutex());
+  if (auto entry = GetLocalCache().Lookup(prefName);
+      entry && entry.Data().Equals(value)) {
+    return;
+  }
+  if (value.IsEmpty()) {
+    GetLocalCache().Remove(prefName);
+  } else {
+    GetLocalCache().InsertOrUpdate(prefName, nsCString(value));
+  }
+  if (!StringBeginsWith(prefName, "cloakfox.s.cloak_cfg_"_ns)) {
+    return;
+  }
+  auto cfg = nlohmann::json::parse(value.get(), nullptr, false);
+  if (cfg.is_object()) {
+    auto seed = cfg.find("math:trig_seed");
+    if (seed != cfg.end() && seed->is_number_unsigned() &&
+        seed->get<uint64_t>() <= UINT32_MAX) {
+      GetMathSeedCache().InsertOrUpdate(prefName, seed->get<uint32_t>());
+      return;
+    }
+  }
+  GetMathSeedCache().Remove(prefName);
+}
+
+/* static */ std::optional<uint32_t>
+RoverfoxStorageManager::GetCachedMathSeed(uint32_t userContextId) {
+  nsAutoCString prefName;
+  prefName.AppendPrintf("cloakfox.s.cloak_cfg_%u", userContextId);
+  MutexAutoLock lock(GetLocalCacheMutex());
+  if (auto entry = GetMathSeedCache().Lookup(prefName)) {
+    return entry.Data();
+  }
+  return std::nullopt;
 }
 
