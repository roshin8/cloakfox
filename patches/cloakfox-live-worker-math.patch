+      args.rval().set(result);
+      return true;
+    }
     uint32_t hash = uint32_t(bits) ^ uint32_t(bits >> 32) ^ seed;
     hash = (hash ^ (hash >> 16)) * uint32_t(2246822507);
     hash = (hash ^ (hash >> 13)) * uint32_t(3266489909);
@@ -6843,10 +6873,10 @@
