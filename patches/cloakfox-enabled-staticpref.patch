diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -2401,16 +2401,29 @@
 # hidden from the Async Clipboard read paths (Firefox-authored content read
 # back from the in-process clipboard cache is unaffected).
 - name: clipboard.readCustomFormatsFromClipboard.enabled
   type: RelaxedAtomicBool
   value: @IS_NIGHTLY_BUILD@
   mirror: always
 
 #---------------------------------------------------------------------------
+# Prefs starting with "cloakfox."
+#---------------------------------------------------------------------------
+
+# Cloakfox master switch. false = present the real, unspoofed identity
+# everywhere (documented in cloakfox.cfg). RelaxedAtomicBool so the C++
+# spoofers can read it off the main thread — worker and socket (H2/H3)
+# threads — not just the main thread.
+- name: cloakfox.enabled
+  type: RelaxedAtomicBool
+  value: true
+  mirror: always
+
+#---------------------------------------------------------------------------
 # Prefs starting with "consoleservice."
 #---------------------------------------------------------------------------
 
 #if defined(ANDROID)
   # Disable sending console to logcat on release builds.
 -   name: consoleservice.logcat
     type: RelaxedAtomicBool
     value: @IS_NOT_RELEASE_OR_BETA@
