+// Prepare only the configured snapshot. This grants no permission and does
+// not touch a device/provider. Callers must still use the normal site prompt.
+bool nsGeolocationRequest::PrepareSyntheticPosition() {
+  if (mSyntheticPosition) return true;
+  if (nsIPrincipal* principal = GetPrincipal()) {
+    const auto raw = CloakConfigOverlay_Get(
+        principal->OriginAttributesRef().mUserContextId);
+    if (!raw.empty() && nlohmann::json::accept(raw)) {
+      const auto cfg = nlohmann::json::parse(raw);
+      if (cfg.contains("geolocation:latitude") &&
+          cfg.contains("geolocation:longitude") &&
+          cfg.contains("geolocation:accuracy") &&
+          cfg["geolocation:latitude"].is_number() &&
+          cfg["geolocation:longitude"].is_number() &&
+          cfg["geolocation:accuracy"].is_number()) {
+        const double lat = cfg["geolocation:latitude"].get<double>();
+        const double lon = cfg["geolocation:longitude"].get<double>();
+        const double accuracy = cfg["geolocation:accuracy"].get<double>();
+        if (std::isfinite(lat) && std::abs(lat) <= 90 &&
+            std::isfinite(lon) && std::abs(lon) <= 180 &&
+            std::isfinite(accuracy) && accuracy >= 1000) {
+          RefPtr<nsGeoPosition> position = new nsGeoPosition(
+              lat, lon, UnspecifiedNaN<double>(), accuracy,
+              UnspecifiedNaN<double>(), UnspecifiedNaN<double>(),
+              UnspecifiedNaN<double>(), PR_Now() / PR_USEC_PER_MSEC);
+          mSyntheticPosition = position;
+          return true;
+        }
+      }
+    }
+  }
+
+  return false;
+}
