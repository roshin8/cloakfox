+// Call the original native Math function so argument conversion, exceptional
+// values and caller-owned errors keep SpiderMonkey's behavior. Reserved slots
+// are traced by the GC and are not properties visible to worker scripts.
+static bool CloakfoxWorkerMath(JSContext* aCx, unsigned aArgc, JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  JS::RootedValue original(
+      aCx, js::GetFunctionNativeReserved(&args.callee(), 0));
+  JS::RootedValue thisValue(aCx, args.thisv());
+  JS::RootedValue result(aCx);
+  if (!JS::Call(aCx, thisValue, original, JS::HandleValueArray(args), &result)) {
+    return false;
+  }
+  const double value = result.toNumber();
+  if (StaticPrefs::cloakfox_enabled() && std::isfinite(value) &&
+      std::trunc(value) != value) {
+    const uint64_t bits = BitwiseCast<uint64_t>(value);
+    const uint32_t seed = static_cast<uint32_t>(
+        js::GetFunctionNativeReserved(&args.callee(), 1).toNumber());
+    uint32_t hash = uint32_t(bits) ^ uint32_t(bits >> 32) ^ seed;
+    hash = (hash ^ (hash >> 16)) * uint32_t(2246822507);
+    hash = (hash ^ (hash >> 13)) * uint32_t(3266489909);
+    hash ^= hash >> 16;
+    result.setDouble(value + (double(hash) / 4294967296.0 - 0.5) * 1e-12);
+  }
+  args.rval().set(result);
+  return true;
+}
+
+static bool InstallCloakfoxWorkerMath(JSContext* aCx,
+                                      JS::HandleObject aGlobal,
+                                      uint32_t aSeed) {
+  JS::RootedValue mathValue(aCx);
+  if (!JS_GetProperty(aCx, aGlobal, "Math", &mathValue)) {
+    return false;
+  }
+  JS::RootedObject math(aCx, &mathValue.toObject());
+  static constexpr const char* methods[] = {
+      "sin", "cos", "tan", "asin", "acos", "atan", "atan2",
+      "sinh", "cosh", "tanh", "asinh", "acosh", "atanh",
+      "exp", "expm1", "log", "log2", "log10", "log1p",
+      "sqrt", "cbrt", "hypot", "pow"};
+  for (const char* name : methods) {
+    JS::RootedValue original(aCx);
+    if (!JS_GetProperty(aCx, math, name, &original)) {
+      return false;
+    }
+    JSFunction* originalFunction = JS_GetObjectFunction(&original.toObject());
+    JSFunction* function = js::NewFunctionWithReserved(
+        aCx, CloakfoxWorkerMath, JS_GetFunctionArity(originalFunction), 0, name);
+    if (!function) {
+      return false;
+    }
+    JS::RootedObject object(aCx, JS_GetFunctionObject(function));
+    js::SetFunctionNativeReserved(object, 0, original);
+    js::SetFunctionNativeReserved(object, 1, JS::NumberValue(aSeed));
+    if (!JS_DefineProperty(aCx, math, name, object, 0)) {
+      return false;
+    }
+  }
+  return true;
+}
