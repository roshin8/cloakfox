+
+already_AddRefed<Promise> MediaDevices::GetCloakfoxAudioDevices(
+    CallerType aCallerType, ErrorResult& aRv) {
+  nsCOMPtr<nsIGlobalObject> global = xpc::NativeGlobal(GetWrapper());
+  RefPtr<Promise> promise = Promise::Create(global, aRv);
+  if (aRv.Failed()) return nullptr;
+  if (aCallerType != CallerType::System) {
+    promise->MaybeRejectWithNotAllowedError("Audio inventory is browser-only.");
+    return promise.forget();
+  }
+  // Physical inventory only. This never opens a stream or grants permission.
+  MediaManager::Get()->GetPhysicalDevices()->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [promise](RefPtr<const MediaDeviceSetRefCnt> aDevices) {
+        nsTArray<CloakfoxAudioDevice> devices;
+        for (const auto& device : *aDevices) {
+          const bool microphone =
+              device->mMediaSource == MediaSourceEnum::Microphone;
+          const bool speaker = device->mKind == MediaDeviceKind::Audiooutput;
+          if (!microphone && !speaker) continue;
+          auto& entry = *devices.AppendElement();
+          entry.mDeviceId = device->mRawID;
+          entry.mLabel = device->mRawName;
+          entry.mKind = microphone ? u"audioinput"_ns : u"audiooutput"_ns;
+        }
+        promise->MaybeResolve(devices);
+      },
+      [promise](RefPtr<MediaMgrError>&&) {
+        promise->MaybeRejectWithNotReadableError("Could not list audio devices.");
+      });
+  return promise.forget();
 }
 
