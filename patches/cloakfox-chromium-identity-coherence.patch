 bool NavigatorUAData::IsDesktopChromiumIdentity(const nsAString& aUserAgent) {
   const std::string ua = NS_ConvertUTF16toUTF8(aUserAgent).get();
   return IsChromiumUA(ua) && ua.find("Android") == std::string::npos &&
          ua.find("Mobile") == std::string::npos;
 }
 
