+void Navigator::GetVendor(nsAString& aVendor) {
+  aVendor.Truncate();
+  if (!StaticPrefs::cloakfox_enabled() || !mWindow ||
+      !mWindow->GetExtantDoc() ||
+      mWindow->GetExtantDoc()->NodePrincipal()->IsSystemPrincipal()) {
