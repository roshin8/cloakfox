+  if (mozilla::StaticPrefs::cloakfox_enabled() && MaskConfig::MVoices()) {
+    LOG(LogLevel::Debug,
+        ("nsSynthVoiceRegistry::NotifyVoicesError ignored: configured voices"));
+    return NS_OK;
