+// Keep native clipboard defaults and chrome handlers, while preventing content
+// listeners from observing user clipboard events or the usual shortcut chords.
+static bool IsClipboardSignalEvent(const WidgetEvent* aEvent) {
+  switch (aEvent->mMessage) {
+    case eCopy:
+    case eCut:
+    case ePaste:
+      return true;
+    case eKeyDown:
+    case eKeyPress:
+    case eKeyUp: {
+      const WidgetKeyboardEvent* key = aEvent->AsKeyboardEvent();
+      if (key->IsAlt()) {
+        return false;
+      }
+      // Printable keypress events have keyCode=0; match their character too.
+      const uint32_t character = key->mCharCode;
+      const bool clipboardCharacter =
+          character == 'c' || character == 'C' || character == 'x' ||
+          character == 'X' || character == 'v' || character == 'V';
+      if (key->IsAccel() &&
+          (key->mKeyCode == NS_VK_C || key->mKeyCode == NS_VK_X ||
+           key->mKeyCode == NS_VK_V || clipboardCharacter)) {
+        return true;
+      }
+      // Conventional alternative clipboard shortcuts on Windows and Linux.
+      return (key->mKeyCode == NS_VK_INSERT &&
+              (key->IsControl() || key->IsShift())) ||
+             (key->mKeyCode == NS_VK_DELETE && key->IsShift() &&
+              !key->IsControl() && !key->IsMeta());
+    }
+    default:
+      return false;
+  }
+}
