+// Browser widgets and system about: documents must never enter synchronous
+// page-persona storage while constructing their native touch listeners.
+static std::optional<uint32_t> CloakfoxContentTouchPoints(nsIDocShell* aDocShell) {
+  if (!aDocShell || !StaticPrefs::cloakfox_enabled()) return std::nullopt;
+  const auto* document = aDocShell->GetExtantDocument();
+  auto* bc = aDocShell->GetBrowsingContext();
+  if (!document || document->NodePrincipal()->IsSystemPrincipal() ||
+      (bc && bc->IsChrome())) return std::nullopt;
+  // An existing content document without an owner must not reveal the host.
+  if (!bc) return uint32_t{0};
+  const auto raw = CloakConfigOverlay_Get(bc->OriginAttributesRef().mUserContextId);
+  const auto config = nlohmann::json::parse(raw, nullptr, false);
+  if (!config.is_object()) return uint32_t{0};
+  const auto value = config.find("navigator:maxTouchPoints");
+  if (value == config.end() || !value->is_number_unsigned() ||
+      value->get<uint64_t>() > UINT32_MAX) return uint32_t{0};
+  return value->get<uint32_t>();
+}
