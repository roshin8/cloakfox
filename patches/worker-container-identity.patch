   worker->mDefaultLocale = std::move(defaultLocale);
+
+  // Cloakfox: warm this container's cloak_cfg into RoverfoxStorageManager's
+  // mutex-protected cache while we are still on the main thread.
+  //
+  // The worker's navigator getters resolve their persona with an EXPLICIT
+  // userContextId (they cannot use CloakConfigOverlay_CurrentUserContextId(),
+  // which returns 0 off the main thread). That lookup ultimately reads
+  // Preferences, which is main-thread-only, so off-thread reads are served
+  // from the cache instead — but only if something populated it first.
+  // Without this warm-up the worker silently fell back to container 0 and
+  // reported a DIFFERENT persona than its own window: a self-contradiction,
+  // and cross-container correlation since it exposed ctx 0's identity.
+  if (NS_IsMainThread()) {
+    nsAutoString cfgKey;
+    cfgKey.AppendPrintf("cloak_cfg_%u",
+                        worker->GetOriginAttributes().mUserContextId);
+    nsAutoString ignored;
+    (void)RoverfoxStorageManager::GetString(cfgKey, ignored);
+  }
 
