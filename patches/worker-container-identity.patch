+// Cloakfox: this worker's own container. CloakConfigOverlay_CurrentUserContextId()
+// returns 0 off the main thread, so the context-blind MaskConfig getters would
+// resolve container 0's persona for EVERY worker — a worker/window
+// contradiction plus cross-container correlation. The worker's own origin
+// attributes are valid on any thread, so pass them explicitly.
+static uint32_t CloakfoxWorkerUcid() {
+  if (WorkerPrivate* wp = GetCurrentThreadWorkerPrivate()) {
+    return wp->GetOriginAttributes().mUserContextId;
+  }
+  return 0;
+}
