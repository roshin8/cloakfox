+using Json = nlohmann::json;
+static uint32_t Container(nsPIDOMWindowInner* aWindow) {
+  return aWindow->GetBrowsingContext()->OriginAttributesRef().mUserContextId;
+}
+static Json Overlay(nsPIDOMWindowInner* aWindow) {
+  auto json =
+      Json::parse(CloakConfigOverlay_Get(Container(aWindow)), nullptr, false);
+  return json.is_object() ? std::move(json) : Json::object();
+}
+Maybe<nsString> CloakfoxScreenAccess::ReadUserAgent(
+    nsPIDOMWindowInner* aWindow) {
+  if (!NS_IsMainThread() || !aWindow || !aWindow->GetBrowsingContext())
+    return Nothing();
+  nsString ua;
+  if (NavigatorManager::GetUserAgent(Container(aWindow), ua)) return Some(ua);
+  auto cfg = Overlay(aWindow);
+  auto at = cfg.find("navigator.userAgent");
+  if (at != cfg.end() && at->is_string()) {
+    ua.Assign(NS_ConvertUTF8toUTF16(at->get<std::string>().c_str()));
+    return Some(ua);
+  }
+  if (NS_FAILED(Navigator::GetUserAgent(aWindow, aWindow->GetExtantDoc(),
+                                        Nothing(), ua)))
+    return Nothing();
+  return Some(ua);
+}
+bool CloakfoxScreenAccess::IsOriginAllowed(const nsACString& aOrigin) {
+  nsAutoCString saved;
+  Preferences::GetCString("cloakfox.compat.screen_management.origins", saved);
+  auto origins = Json::parse(std::string(saved.BeginReading(), saved.Length()),
+                             nullptr, false);
+  if (!origins.is_array()) return false;
+  for (const auto& entry : origins) {
+    if (!entry.is_string()) continue;
+    const std::string value = entry.get<std::string>();
+    if (value.find('*') != std::string::npos ||
+        value.find('\0') != std::string::npos)
+      continue;
+    nsCOMPtr<nsIURI> uri;
+    if (NS_FAILED(NS_NewURI(getter_AddRefs(uri),
+                            nsDependentCString(value.c_str()))) ||
+        !uri->SchemeIs("https"))
+      continue;
+    nsAutoCString credentials, path, host;
+    if (NS_FAILED(uri->GetUserPass(credentials)) || !credentials.IsEmpty() ||
+        NS_FAILED(uri->GetPathQueryRef(path)) || !path.EqualsLiteral("/") ||
+        NS_FAILED(uri->GetHost(host)) || host.IsEmpty())
+      continue;
+    nsCOMPtr<nsIPrincipal> principal =
+        BasePrincipal::CreateContentPrincipal(uri, {});
+    nsAutoCString origin;
+    if (principal && NS_SUCCEEDED(principal->GetOriginNoSuffix(origin)) &&
+        origin.Equals(aOrigin))
+      return true;
+  }
+  return false;
+}
+bool CloakfoxScreenAccess::IsEligible(nsPIDOMWindowInner* aWindow) {
+  if (!NS_IsMainThread() || !aWindow || nsGlobalWindowInner::Cast(aWindow)->IsChromeWindow() ||
+      !StaticPrefs::cloakfox_enabled() ||
+      !Preferences::GetBool("cloakfox.compat.screen_management", false) ||
+      !aWindow->GetBrowsingContext() ||
+      !nsGlobalWindowInner::Cast(aWindow)->IsSecureContext())
+    return false;
+  Document* doc = aWindow->GetExtantDoc();
+  nsIPrincipal* principal = doc ? doc->NodePrincipal() : nullptr;
+  nsAutoCString origin;
+  nsCOMPtr<nsIURI> uri = principal ? principal->GetURI() : nullptr;
+  if (!principal || !BasePrincipal::Cast(principal)->IsContentPrincipal() || !uri ||
+      !uri->SchemeIs("https") ||
+      NS_FAILED(principal->GetOriginNoSuffix(origin)) ||
+      !IsOriginAllowed(origin))
+    return false;
+  auto ua = ReadUserAgent(aWindow);
+  return ua && NavigatorUAData::IsDesktopChromiumIdentity(*ua);
+}
+bool CloakfoxScreenAccess::IsEnabled(JSContext*, JSObject* aGlobal) {
+  return NS_IsMainThread() && IsEligible(xpc::WindowOrNull(aGlobal));
+}
+static Maybe<int32_t> Integer(const Json& aCfg, const char* aKey) {
+  auto at = aCfg.find(aKey);
+  if (at == aCfg.end() || !at->is_number()) return Nothing();
+  const double value = at->get<double>();
+  if (!std::isfinite(value) || std::trunc(value) != value ||
+      value < INT32_MIN || value > INT32_MAX)
+    return Nothing();
+  return Some(static_cast<int32_t>(value));
+}
+static int32_t Positive(const Json& aCfg, const char* aKey, int32_t aDefault) {
+  auto value = Integer(aCfg, aKey);
+  return value && *value > 0 ? *value : aDefault;
+}
+Maybe<CloakfoxScreenPresentation> CloakfoxScreenPresentation::Read(
+    nsPIDOMWindowInner* aWindow, uint32_t aScreenIndex) {
+  if (!aWindow || !aWindow->IsFullyActive() ||
+      !CloakfoxScreenAccess::IsEligible(aWindow))
+    return Nothing();
+  auto* win = nsGlobalWindowInner::Cast(aWindow);
+  CloakfoxScreenPresentation result;
+  result.mScreenCount = win->GetCloakfoxVirtualScreenCount();
+  result.mScreenIndex = aScreenIndex;
+  if (aScreenIndex >= result.mScreenCount) return Nothing();
+  const auto cfg = Overlay(aWindow);
+  result.mDepth = Positive(cfg, "screen.colorDepth",
+                           Positive(cfg, "screen.pixelDepth", 24));
+  if (nsGlobalWindowInner::UseCloakfoxLetterboxing(aWindow->GetExtantDoc())) {
+    CSSIntSize size =
+        aWindow->GetBrowsingContext()->Top()->GetTopInnerSizeForRFP();
+    if (size.width > 0 && size.height > 0)
+      result.mRect = {0, 0, size.width, size.height};
+    result.mAvailRect = result.mRect;
+    if (auto* pc = aWindow->GetExtantDoc()->GetPresContext())
+      result.mDevicePixelRatio =
+          nsRFPService::GetDevicePixelRatioAtZoom(pc->GetFullZoom());
+    result.mOrientation = nsRFPService::ViewportSizeToOrientationType(
+        result.mRect.Width(), result.mRect.Height());
+  } else {
+    result.mRect = {Integer(cfg, "screen.left").valueOr(0),
+                    Integer(cfg, "screen.top").valueOr(0),
+                    Positive(cfg, "screen.width", 1920),
+                    Positive(cfg, "screen.height", 1080)};
+    int32_t left = Integer(cfg, "screen.availLeft").valueOr(result.mRect.x);
+    int32_t top = Integer(cfg, "screen.availTop").valueOr(result.mRect.y);
+    int32_t width = Positive(cfg, "screen.availWidth", result.mRect.Width());
+    int32_t height = Positive(cfg, "screen.availHeight", result.mRect.Height());
+    if (left < result.mRect.x || top < result.mRect.y ||
+        int64_t(left) + width >
+            int64_t(result.mRect.x) + result.mRect.Width() ||
+        int64_t(top) + height >
+            int64_t(result.mRect.y) + result.mRect.Height()) {
+      result.mAvailRect = result.mRect;
+    } else
+      result.mAvailRect = {left, top, width, height};
+    auto dpr = cfg.find("window.devicePixelRatio");
+    if (dpr != cfg.end() && dpr->is_number()) {
+      double value = dpr->get<double>();
+      if (std::isfinite(value) && value > 0) result.mDevicePixelRatio = value;
+    }
+    auto type = cfg.find("screen:orientation:type");
+    if (type != cfg.end() && type->is_string()) {
+      if (*type == "landscape-secondary")
+        result.mOrientation = OrientationType::Landscape_secondary;
+      else if (*type == "portrait-primary")
+        result.mOrientation = OrientationType::Portrait_primary;
+      else if (*type == "portrait-secondary")
+        result.mOrientation = OrientationType::Portrait_secondary;
+    }
+    result.mAngle =
+        result.mOrientation == OrientationType::Landscape_secondary ||
+                result.mOrientation == OrientationType::Portrait_secondary
+            ? 180
+            : 0;
+  }
+  // Validate the entire topology, not only this index, before narrowing.
+  if (int64_t(result.mRect.x) +
+              int64_t(result.mRect.Width()) * result.mScreenCount >
+          INT32_MAX ||
+      int64_t(result.mRect.y) + result.mRect.Height() > INT32_MAX) {
+    const uint32_t count = result.mScreenCount;
+    result = CloakfoxScreenPresentation{};
+    result.mScreenCount = count;
+    result.mScreenIndex = aScreenIndex;
+  }
+  const int64_t shift = int64_t(aScreenIndex) * result.mRect.Width();
+  result.mRect.x = int32_t(int64_t(result.mRect.x) + shift);
+  result.mAvailRect.x = int32_t(int64_t(result.mAvailRect.x) + shift);
+  return Some(result);
+}
+}  // namespace mozilla::dom
