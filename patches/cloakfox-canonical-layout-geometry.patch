+
+void nsPresContext::CaptureCloakfoxCanonicalLayout() {
+  mCloakfoxGeometry = MakeUnique<CloakfoxCanonicalGeometry::Lifecycle>();
+  auto* bc = mDocument->GetBrowsingContext();
+  auto systemZoom = LookAndFeel::SystemZoomSettings();
+  const uint32_t ucid = mDocument->NodePrincipal()->OriginAttributesRef().mUserContextId;
+  const auto cfg = CloakfoxSiteSeed::ExactConfig(ucid);
+  // External SVG <use>/paint-server resource documents share their display
+  // document's device context. Their text must use that document's canonical
+  // font preferences too, otherwise resource bounds would reintroduce host
+  // minimum-font metrics into admitted parent SVG geometry.
+  auto* displayDocument = mDocument->GetDisplayDocument();
+  auto* displayContext = displayDocument ? displayDocument->GetPresContext() : nullptr;
+  const bool inherited = displayContext && displayContext->CloakfoxCanonicalLayout();
+  nsAutoString site;
+  if (auto* settings = mDocument->CookieJarSettings()) settings->GetPartitionKey(site);
+  auto* parentDocument = mDocument->GetInProcessParentDocument();
+  auto* parentContext = parentDocument ? parentDocument->GetPresContext() : nullptr;
+  const bool supported = Preferences::GetBool("cloakfox.enabled", true) &&
+      Preferences::GetBool("cloakfox.experimental.canvas_pipeline", false) &&
+      CloakfoxCanonicalGeometry::Requested(cfg, ucid) &&
+      !mDocument->NodePrincipal()->IsSystemPrincipal() &&
+      IsDynamic() && !IsPrintingOrPrintPreview() && bc &&
+      !mDocument->GetDisplayDocument() && !bc->GetInRDMPane() &&
+      bc->FullZoom() == 1.0f && bc->TextZoom() == 1.0f &&
+      systemZoom.mFullZoom == 1.0f && systemZoom.mTextZoom == 1.0f &&
+      bc->OverrideDPPX() == 0.0f &&
+      gfxPlatform::GetPlatform()->GetDefaultContentBackend() == gfx::BackendType::SKIA &&
+      gfxPlatform::GetPlatform()->ScreenReferenceDrawTarget()->GetBackendType() ==
+          gfx::BackendType::SKIA &&
+      CloakfoxSiteSeed::OwnerKey(ucid, mDocument->CookieJarSettings()).has_value();
+  const bool root = supported && bc->IsTop();
+  const bool child = supported && !bc->IsTop() && parentContext &&
+      parentContext->mCloakfoxGeometry && parentContext->mCloakfoxGeometry->Valid() &&
+      parentContext->mCloakfoxCanonicalLayout &&
+      parentDocument->NodePrincipal()->OriginAttributesRef().mUserContextId == ucid &&
+      parentContext->mCloakfoxGeometrySite == site &&
+      parentContext->mCloakfoxGeometryConfig == cfg.dump().c_str();
+  const bool enabled = root || child;
+  mCloakfoxCanonicalOutput = root;
+  mCloakfoxGeometryParent = child ? parentDocument : nullptr;
+  mCloakfoxCanonicalLayout = enabled || inherited;
+  mCloakfoxGeometry->Capture(enabled);
+  if (enabled) {
+    mCloakfoxGeometryConfig.Assign(cfg.dump().c_str());
+    mDocument->CookieJarSettings()->GetPartitionKey(mCloakfoxGeometrySite);
+    mDeviceContext->EnableCloakfoxCanonicalLayout();
+  }
+}
+
+float nsPresContext::CloakfoxOutputResolution() const {
+  return mCloakfoxCanonicalOutput ? mDeviceContext->CloakfoxPhysicalScale() : 1.0f;
+}
