+nsSize nsPresContext::CloakfoxViewportSize(const LayoutDeviceIntSize& size) const {
+  const float scale = CloakfoxOutputResolution();
+  return nsSize(NSToCoordRound(float(size.width) * AppUnitsPerDevPixel() / scale),
+                NSToCoordRound(float(size.height) * AppUnitsPerDevPixel() / scale));
+}
+
+void nsPresContext::BeginCloakfoxCanonicalLayout() {
+  if (mCloakfoxGeometry) mCloakfoxGeometry->BeginLayout();
+}
+
+void nsPresContext::RevokeCloakfoxCanonicalGeometry() {
+  if (mCloakfoxGeometry) mCloakfoxGeometry->Revoke();
+}
+
+bool nsPresContext::CloakfoxCanonicalGeometryReady() {
+  if (!mCloakfoxGeometry || !mCloakfoxGeometry->Ready()) return false;
+  const uint32_t ucid = mDocument->NodePrincipal()->OriginAttributesRef().mUserContextId;
+  auto* bc = mDocument->GetBrowsingContext();
+  nsAutoString site;
+  mDocument->CookieJarSettings()->GetPartitionKey(site);
+  if (!bc || (!bc->IsTop() && !mCloakfoxGeometryParent) ||
+      bc->GetInRDMPane() || bc->OverrideDPPX() != 0.0f ||
+      bc->FullZoom() != 1.0f || bc->TextZoom() != 1.0f ||
+      site != mCloakfoxGeometrySite ||
+      !Preferences::GetBool("cloakfox.enabled", true) ||
+      !Preferences::GetBool("cloakfox.experimental.canvas_pipeline", false) ||
+      mCloakfoxGeometryConfig != CloakfoxSiteSeed::ExactConfig(ucid).dump().c_str() ||
+      mFullZoom != 1.0f || mTextZoom != 1.0f || mInRDMPane ||
+      IsPrintingOrPrintPreview() || AppUnitsPerDevPixel() != AppUnitsPerCSSPixel() ||
+      mDeviceContext->AppUnitsPerDevPixel() != AppUnitsPerCSSPixel() ||
+      !mPresShell || mPresShell->GetResolution() != CloakfoxOutputResolution()) {
+    RevokeCloakfoxCanonicalGeometry();
+    return false;
+  }
+  if (mCloakfoxCanonicalOutput) {
+    LayoutDeviceIntSize physicalSize;
+    if (!nsLayoutUtils::GetDocumentViewerSize(this, physicalSize)) return false;
+    const nsSize expectedSize = CloakfoxViewportSize(physicalSize);
+    // A widget/viewer resize can arrive after an earlier layout completes.
+    // Never publish exact geometry from a stale physical-pixel viewport, or
+    // while a differently sized layout is still pending. A transient mismatch
+    // stays protected without permanently revoking this captured owner.
+    if (GetVisibleArea().Size() != expectedSize ||
+        mPresShell->MaybePendingLayoutViewportSize() != expectedSize) {
+      return false;
+    }
+  }
+  if (mCloakfoxGeometryParent) {
+    auto* parent = mDocument->GetInProcessParentDocument();
+    if (parent != mCloakfoxGeometryParent || !parent->GetPresContext()) {
+      RevokeCloakfoxCanonicalGeometry();
+      return false;
+    }
+    // Initial child layout can complete before its parent's first reflow.
+    // Remain protected until both generations are complete. A revoked parent
+    // never resurrects, and exact-owner/site checks above remain mandatory.
+    if (!parent->GetPresContext()->CloakfoxCanonicalGeometryReady()) return false;
+  }
+  return true;
+}
+
+void nsPresContext::CompleteCloakfoxCanonicalLayout() {
+  if (mCloakfoxGeometry) {
+    mCloakfoxGeometry->Complete(mFullZoom == 1.0f && mTextZoom == 1.0f &&
+        !mInRDMPane && !IsPrintingOrPrintPreview() && mPresShell &&
+        mPresShell->GetResolution() == CloakfoxOutputResolution());
+    (void)CloakfoxCanonicalGeometryReady();
+  }
+}
