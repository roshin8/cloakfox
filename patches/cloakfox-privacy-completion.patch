 #include "BounceTrackingAllowList.h"
 #include "nsIPermissionManager.h"
+#include "mozilla/BasePrincipal.h"
+#include "mozilla/PermissionManager.h"
+#include "nsNetUtil.h"
 
 namespace mozilla {
+
+nsresult BounceTrackingAllowList::CheckForBaseDomain(
+    const nsACString& aBaseDomain, const OriginAttributes& aOriginAttributes,
+    bool& aIsAllowListed) {
+  nsresult rv = ContentBlockingAllowListCache::CheckForBaseDomain(
+      aBaseDomain, aOriginAttributes, aIsAllowListed);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (aIsAllowListed) {
+    return NS_OK;
+  }
+
+  // PermissionManager may intentionally share site permissions across
+  // containers. Encode this narrow exception's scope in its private type,
+  // using an attribute-free principal so global sharing prefs cannot rekey it.
+  nsAutoCString type("cloakfox-bounce:");
+  type.AppendInt(aOriginAttributes.mUserContextId);
+  type.Append(':');
+  type.AppendInt(aOriginAttributes.mPrivateBrowsingId);
+  nsAutoCString origin("https://");
+  origin.Append(aBaseDomain);
+  nsCOMPtr<nsIURI> uri;
+  rv = NS_NewURI(getter_AddRefs(uri), origin);
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsCOMPtr<nsIPrincipal> principal =
+      BasePrincipal::CreateContentPrincipal(uri, OriginAttributes{});
+  NS_ENSURE_TRUE(principal, NS_ERROR_FAILURE);
+  RefPtr<PermissionManager> permissions = PermissionManager::GetInstance();
+  NS_ENSURE_TRUE(permissions, NS_ERROR_FAILURE);
+  uint32_t capability = nsIPermissionManager::UNKNOWN_ACTION;
+  rv = permissions->TestExactPermissionFromPrincipal(principal, type,
+                                                     &capability);
+  NS_ENSURE_SUCCESS(rv, rv);
+  aIsAllowListed = capability == nsIPermissionManager::ALLOW_ACTION;
+  return NS_OK;
+}
 
