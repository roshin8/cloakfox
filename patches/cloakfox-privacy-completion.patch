+
+// Main-thread-only inventory: preference IPC may omit values larger than 4KiB,
+// including nearly every full persona. Keep the keys even if a valueless update
+// evicts their cache entries, so the small change epoch can refresh them.
+/* static */ nsTArray<nsCString>&
+RoverfoxStorageManager::ObservedConfigKeys() {
+  MOZ_ASSERT(NS_IsMainThread());
+  static nsTArray<nsCString> keys;
+  return keys;
+}
+
+// Preferences delivers cross-process changes on the main thread. Publish an
+// updated snapshot under the same lock used by worker reads; clearing a pref
+// must evict its previous value as well. No worker invokes Preferences or IPC.
+/* static */ void
+RoverfoxStorageManager::OnStoragePrefChanged(const char* prefName, void*) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (nsDependentCString(prefName).EqualsLiteral("cloakfox.font_identity_epoch")) {
+    // The epoch is not size-limited. Fetch authoritative values on this thread;
+    // workers only see the resulting mutex-protected snapshot. Clone the key
+    // inventory because sync IPC may spin a nested main-thread event loop.
+    const auto keys = ObservedConfigKeys().Clone();
+    for (const auto& key : keys) {
+      nsAutoCString value;
+      if (XRE_IsParentProcess()) {
+        Preferences::GetCString(key.get(), value);
+      } else {
+        auto* child = ContentChild::GetSingleton();
+        if (!child || child->IsShuttingDown() || !child->CanSend() ||
+            !child->SendRoverfoxStorageGet(key, &value)) continue;
+      }
+      MutexAutoLock lock(GetLocalCacheMutex());
+      if (value.IsEmpty()) GetLocalCache().Remove(key);
+      else GetLocalCache().InsertOrUpdate(key, nsCString(value));
+    }
+    return;
+  }
+  nsAutoCString value;
+  if (!XRE_IsParentProcess() &&
+      nsDependentCString(prefName).Find("cloakfox.s.cloak_cfg_") == 0) {
+    // A value crossing the IPC size threshold can arrive as a valueless pref
+    // update after its epoch. Resolve it authoritatively instead of erasing the
+    // fresh snapshot in that ordering. Real removals still return empty here.
+    auto* child = ContentChild::GetSingleton();
+    if (!child || child->IsShuttingDown() || !child->CanSend() ||
+        !child->SendRoverfoxStorageGet(nsDependentCString(prefName), &value)) return;
+  } else {
+    Preferences::GetCString(prefName, value);
+  }
+  MutexAutoLock lock(GetLocalCacheMutex());
+  if (value.IsEmpty()) {
+    GetLocalCache().Remove(nsDependentCString(prefName));
+  } else {
+    GetLocalCache().InsertOrUpdate(nsDependentCString(prefName), nsCString(value));
+  }
+}
+
+/* static */ void
+RoverfoxStorageManager::EnsureCacheObserver() {
+  if (!NS_IsMainThread()) return;
+  static bool registered = false;
+  if (registered) return;
+  registered = true;
+  Preferences::RegisterPrefixCallback(OnStoragePrefChanged, "cloakfox.s.");
+  Preferences::RegisterPrefixCallback(OnStoragePrefChanged, "roverfox.s.");
+  Preferences::RegisterCallback(OnStoragePrefChanged, "cloakfox.font_identity_epoch");
 }
 
