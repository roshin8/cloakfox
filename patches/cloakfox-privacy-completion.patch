+  if (strValue.IsEmpty() && NS_IsMainThread()) {
     Preferences::GetCString(prefName.get(), strValue);
   }
   // Sync IPC read from parent (cross-process fallback for workers)
   if (strValue.IsEmpty() && !XRE_IsParentProcess() && NS_IsMainThread()) {
     ContentChild* cc = ContentChild::GetSingleton();
     if (cc) {
       cc->SendRoverfoxStorageGet(prefName, &strValue);
       if (!strValue.IsEmpty()) {
         MutexAutoLock lock(GetLocalCacheMutex());
         GetLocalCache().InsertOrUpdate(prefName, nsCString(strValue));
       }
     }
   }
   if (!strValue.IsEmpty()) {
     nsresult parseRv;
     int64_t parsed = strValue.ToInteger64(&parseRv);
     if (NS_SUCCEEDED(parseRv) && parsed >= 0) {
       outValue = static_cast<uint32_t>(parsed);
       return true;
     }
   }
   return false;
 }
 
