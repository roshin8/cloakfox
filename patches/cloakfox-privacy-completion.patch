 /* static */ bool
 RoverfoxStorageManager::GetBool(const nsAString& key, bool& outValue) {
   // cpp-first priority check.
   {
     nsAutoCString cppFirst;
     if (TryGetCppFirstPref(key, cppFirst)) {
       outValue = (cppFirst.EqualsLiteral("1") ||
                   cppFirst.LowerCaseEqualsLiteral("true"));
       return true;
     }
   }
   nsCString prefName = MakePrefName(key);
   nsAutoCString strValue;
   {
     MutexAutoLock lock(GetLocalCacheMutex());
     if (auto entry = GetLocalCache().Lookup(prefName)) {
       strValue = entry.Data();
     }
   }
-  if (strValue.IsEmpty()) {
+  if (strValue.IsEmpty() && NS_IsMainThread()) {
     Preferences::GetCString(prefName.get(), strValue);
   }
   // Sync IPC read from parent (cross-process fallback for workers)
   if (strValue.IsEmpty() && !XRE_IsParentProcess() && NS_IsMainThread()) {
     ContentChild* cc = ContentChild::GetSingleton();
     if (cc) {
       cc->SendRoverfoxStorageGet(prefName, &strValue);
       if (!strValue.IsEmpty()) {
         MutexAutoLock lock(GetLocalCacheMutex());
         GetLocalCache().InsertOrUpdate(prefName, nsCString(strValue));
       }
     }
   }
