 /* static */ void
 RoverfoxStorageManager::PutString(const nsAString& key,
                                    const nsAString& value) {
   nsCString prefName = MakePrefName(key);
   nsAutoCString utf8Value;
   CopyUTF16toUTF8(value, utf8Value);
   SetPrefValue(prefName, utf8Value);
 }
 
 /* static */ bool
 RoverfoxStorageManager::GetString(const nsAString& key, nsAString& outValue) {
   // cpp-first priority check.
   {
     nsAutoCString cppFirst;
     if (TryGetCppFirstPref(key, cppFirst)) {
       CopyUTF8toUTF16(cppFirst, outValue);
       return true;
     }
   }
   nsCString prefName = MakePrefName(key);
   nsAutoCString utf8Value;
   {
     MutexAutoLock lock(GetLocalCacheMutex());
     if (auto entry = GetLocalCache().Lookup(prefName)) {
       utf8Value = entry.Data();
     }
   }
   // Preferences is main-thread-only. Worker threads must be served from the
   // mutex-protected cache above, which is warmed on the main thread when the
   // worker is created (see WarmContainerConfig). Without this guard a worker
   // reading a per-container key would touch Preferences off the main thread.
   if (utf8Value.IsEmpty() && NS_IsMainThread()) {
     Preferences::GetCString(prefName.get(), utf8Value);
     // Cache it so worker threads in this process can read the same value
     // without touching Preferences themselves.
     if (!utf8Value.IsEmpty()) {
       MutexAutoLock lock(GetLocalCacheMutex());
       GetLocalCache().InsertOrUpdate(prefName, nsCString(utf8Value));
     }
   }
   // Sync IPC read from parent (cross-process fallback for workers)
   if (utf8Value.IsEmpty() && !XRE_IsParentProcess() && NS_IsMainThread()) {
     ContentChild* cc = ContentChild::GetSingleton();
     if (cc) {
       cc->SendRoverfoxStorageGet(prefName, &utf8Value);
       if (!utf8Value.IsEmpty()) {
         MutexAutoLock lock(GetLocalCacheMutex());
         GetLocalCache().InsertOrUpdate(prefName, nsCString(utf8Value));
       }
     }
   }
   if (!utf8Value.IsEmpty()) {
     CopyUTF8toUTF16(utf8Value, outValue);
     return true;
   }
   return false;
 }
 
 /* static */ void
 RoverfoxStorageManager::Remove(const nsAString& key) {
   nsCString prefName = MakePrefName(key);
   {
     MutexAutoLock lock(GetLocalCacheMutex());
     GetLocalCache().Remove(prefName);
   }
   if (XRE_IsParentProcess()) {
     Preferences::ClearUser(prefName.get());
   }
 }
 
 }  // namespace dom
 }  // namespace mozilla
