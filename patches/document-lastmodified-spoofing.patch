 void Document::GetLastModified(nsAString& aLastModified) const {
+  // Cloakfox: return empty string rather than current-time fallback —
+  // leaking a fresh timestamp fingerprints the user's clock.
+  if (MaskConfig::GetBool("document:lastModified:hidden").value_or(false) &&
+      mLastModified.IsEmpty()) {
+    aLastModified.Truncate();
+    return;
+  }
   if (!mLastModified.IsEmpty()) {
     aLastModified.Assign(mLastModified);
   } else {
     GetFormattedTimeString(PR_Now(),
                            ShouldResistFingerprinting(RFPTarget::JSDateTimeUTC),
                            aLastModified);
   }
 }
