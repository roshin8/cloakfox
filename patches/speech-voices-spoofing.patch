+/* Cloakfox: Per-context speech voices manager */
+#ifndef mozilla_dom_SpeechVoicesManager_h
+#define mozilla_dom_SpeechVoicesManager_h
+
+#include "nsString.h"
+#include "nsTHashMap.h"
+#include "nsHashKeys.h"
+#include "nsTHashSet.h"
+#include "RoverfoxStorageManager.h"
+
+namespace mozilla {
+namespace dom {
+
+class SpeechVoicesManager {
+ public:
+  static void SetVoices(uint32_t aUserContextId, const nsAString& aVoiceList);
+  static bool HasVoices(uint32_t aUserContextId);
+  static bool IsVoiceAllowed(uint32_t aUserContextId,
+                              const nsAString& aVoiceName);
+  static void DisableFunction(uint32_t aId);
+  static bool IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+ private:
+  static nsString DisabledKeyForUserContext(uint32_t aId);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_SpeechVoicesManager_h
