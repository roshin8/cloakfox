         if self.state != HandshakeState::New {
             warn!("[{self}] Cannot enable ciphers in state {:?}", self.state);
             return Err(Error::Internal);
         }
 
         let all_ciphers = unsafe { ssl::SSL_GetImplementedCiphers() };
         let cipher_count = usize::from(unsafe { ssl::SSL_GetNumImplementedCiphers() });
         for i in 0..cipher_count {
             let p = all_ciphers.wrapping_add(i);
             secstatus_to_res(unsafe {
                 ssl::SSL_CipherPrefSet(self.fd, i32::from(*p), PRBool::from(false))
             })?;
         }
 
         for c in ciphers {
             secstatus_to_res(unsafe {
                 ssl::SSL_CipherPrefSet(self.fd, i32::from(*c), PRBool::from(true))
             })?;
         }
         Ok(())
+    }
+
+    /// Apply the implemented Chrome cipher ordering, respecting enabled policy.
+    /// Must run before the first handshake. Other Chrome TLS extensions remain
+    /// a separately advertised capability gap, not dummy extension payloads.
+    pub fn configure_chrome_profile(&mut self) -> Res<()> {
+        if self.state != HandshakeState::New { return Err(Error::Internal); }
+        let mut active = vec![0u16; usize::from(unsafe { ssl::SSL_GetNumImplementedCiphers() })];
+        let mut count = 0;
+        unsafe { ssl::SSL_CipherSuiteOrderGet(self.fd, active.as_mut_ptr(), &raw mut count) }?;
+        active.truncate(usize::try_from(count)?);
+        let preference = [0x1301, 0x1302, 0x1303];
+        active.sort_by_key(|cipher| preference.iter().position(|v| v == cipher).unwrap_or(preference.len()));
+        unsafe { ssl::SSL_CipherSuiteOrderSet(self.fd, active.as_ptr(), u16::try_from(active.len())?) }?;
+        self.set_option(ssl::Opt::Grease, true)?;
+        self.set_option(ssl::Opt::EnableChExtensionPermutation, true)
     }
 
     /// Set key exchange groups.
     ///
     /// # Errors
     ///
     /// If the underlying API fails (which shouldn't happen).
     pub fn set_groups(&mut self, groups: &[Group]) -> Res<()> {
         // SSLNamedGroup is a different size to Group, so copy one by one.
         let group_vec: Vec<_> = groups
             .iter()
             .map(|&g| ssl::SSLNamedGroup::Type::from(g))
             .collect();
 
         let ptr = group_vec.as_slice().as_ptr();
         secstatus_to_res(unsafe {
             ssl::SSL_NamedGroupConfig(self.fd, ptr, c_uint::try_from(group_vec.len())?)
         })
     }
 
