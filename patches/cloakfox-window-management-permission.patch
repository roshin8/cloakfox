 // https://w3c.github.io/permissions/#onchange-attribute and
 // https://w3c.github.io/permissions/#query-method
 RefPtr<PermissionStatus::SimplePromise> PermissionStatus::Init() {
+  // This virtual grant never reaches the permission manager or an OS prompt.
+  // Workers cannot inherit it, and existing queried statuses remain snapshots.
+  if (mName == PermissionName::Window_management) {
+    mState = PermissionState::Denied;
+    if (NS_IsMainThread()) {
+      nsPIDOMWindowInner* window = GetOwnerWindow();
+      if (window && window->IsFullyActive() &&
+          CloakfoxScreenAccess::IsEligible(window) &&
+          FeaturePolicyUtils::IsFeatureAllowed(window->GetExtantDoc(),
+                                              u"window-management"_ns)) {
+        mState = PermissionState::Granted;
+      }
+    }
+    return SimplePromise::CreateAndResolve(NS_OK, __func__);
+  }
   mSink = CreateSink();
   MOZ_ASSERT(mSink);
 
