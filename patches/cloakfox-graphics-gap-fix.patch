+  // Noise only pixels the backend actually wrote. PACK_SKIP_ROWS/PIXELS,
+  // row padding, untouched destination tails and failed reads stay exact.
+  const auto& rect = result.subrect;
+  const size_t rowBytes = size_t(rect.width) * 4;
+  for (int32_t row = 0; row < rect.height; ++row) {
