-// Cloakfox: per-container noise for gl.readPixels(), the other half of the
-// classic "webglHash" (the toDataURL/toBlob half is handled in
-// GetImageBuffer). Applied ONLY to 8-bit RGBA readback: float/integer formats
-// are used for GPU compute readback where perturbing values would corrupt
-// results rather than defend a fingerprint. Same canvas:seed as the 2D context
-// and GetImageBuffer, so a container's surfaces stay mutually consistent.
+// Noise only ordinary RGBA8 pixels actually written by the backend. Precise
+// reads are denied above or preserved exactly by the explicit compute opt-out.
+static uint32_t CloakfoxAdvanceCanvasSeed(uint32_t seed, uint32_t pixels) {
+  // Skip the same LCG used by ApplyCanvasNoise without walking row padding.
+  uint32_t multiplier = 1664525u, increment = 1013904223u;
+  while (pixels) {
+    if (pixels & 1) seed = seed * multiplier + increment;
+    increment *= multiplier + 1;
+    multiplier *= multiplier;
+    pixels >>= 1;
+  }
+  return seed;
+}
