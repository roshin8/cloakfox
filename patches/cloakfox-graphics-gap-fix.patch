 // ------------------------------ Readback -------------------------------
+// Precise/packed pixels are application data as well as a fingerprint surface.
+// Never perturb those values: strict privacy denies unprotected readbacks,
+// while the explicit compatibility override restores exact GPU compute data.
+// PBOs bypass CPU noise entirely and must obey the same policy.
+static bool CloakfoxBlockPixelReadback(GLenum format, GLenum type, bool pbo,
+                                      uint32_t userContextId) {
+  if (!StaticPrefs::cloakfox_enabled() ||
+      !MaskConfig::GetBool("webgl:typed_readback:disabled", userContextId)
+           .value_or(true)) {
+    return false;
+  }
+  // Unknown packing enums retain the normal driver's validation/error path.
+  if (!webgl::PackingInfoInfo::For({format, type})) return false;
+  return pbo || format != LOCAL_GL_RGBA || type != LOCAL_GL_UNSIGNED_BYTE;
+}
