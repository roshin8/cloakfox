+DOMHighResTimeStamp PerformanceTimingData::PresentHighRes(
+    Performance* aPerformance, DOMHighResTimeStamp aRawValue,
+    Maybe<DOMHighResTimeStamp>& aCache) const {
+  if (aRawValue == 0) {
+    return 0;
+  }
+  if (aCache.isNothing()) {
+    aCache.emplace(aPerformance->PresentTimestamp(aRawValue));
+  }
+  return aCache.value();
+}
+
+#define PRESENT_HIGH_RES(name)                                            \
+  DOMHighResTimeStamp PerformanceTimingData::name##HighRes(               \
+      Performance* aPerformance) {                                        \
+    return PresentHighRes(aPerformance, Raw##name##HighRes(aPerformance), \
+                          mPresented##name);                              \
+  }
+
+PRESENT_HIGH_RES(AsyncOpen)
+PRESENT_HIGH_RES(WorkerStart)
+PRESENT_HIGH_RES(FetchStart)
+PRESENT_HIGH_RES(RedirectStart)
+PRESENT_HIGH_RES(RedirectEnd)
+PRESENT_HIGH_RES(DomainLookupStart)
+PRESENT_HIGH_RES(DomainLookupEnd)
+PRESENT_HIGH_RES(ConnectStart)
+PRESENT_HIGH_RES(SecureConnectionStart)
+PRESENT_HIGH_RES(ConnectEnd)
+PRESENT_HIGH_RES(RequestStart)
+PRESENT_HIGH_RES(ResponseStart)
+PRESENT_HIGH_RES(FirstInterimResponseStart)
+PRESENT_HIGH_RES(FinalResponseHeadersStart)
+PRESENT_HIGH_RES(ResponseEnd)
+
+#undef PRESENT_HIGH_RES
+
 DOMTimeMilliSec PerformanceTiming::ResponseEnd() {
   return static_cast<int64_t>(mTimingData->ResponseEndHighRes(mPerformance));
 }
