+const CloakfoxTiming::Interval& PerformanceEventTiming::PresentedInterval()
+    const {
+  if (mCachedInterval.isNothing()) {
+    const DOMHighResTimeStamp reducedStart =
+        nsRFPService::ReduceTimePrecisionAsMSecs(
+            mStartTime, mPerformance->GetRandomTimelineSeed(),
+            mPerformance->GetRTPCallerType());
+    const DOMHighResTimeStamp reducedDuration =
+        nsRFPService::ReduceTimePrecisionAsMSecs(
+            mDuration, mPerformance->GetRandomTimelineSeed(),
+            mPerformance->GetRTPCallerType());
+    mCachedInterval.emplace(mPerformance->PresentInterval(
+        reducedStart, reducedStart + std::max(0.0, reducedDuration)));
+  }
+  return mCachedInterval.ref();
+}
+
+DOMHighResTimeStamp PerformanceEventTiming::StartTime() const {
+  return PresentedInterval().mStart;
+}
+
+DOMHighResTimeStamp PerformanceEventTiming::Duration() const {
+  return PresentedInterval().Duration();
+}
