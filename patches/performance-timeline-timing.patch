@@ -114,6 +115,15 @@ already_AddRefed<Performance> Performance::Get(JSContext* aCx,
   return performance.forget();
 }
 
+static CloakfoxTiming::Key LoadCloakfoxTimingKey(nsIGlobalObject* aGlobal) {
+  nsIPrincipal* principal = aGlobal->PrincipalOrNull();
+  if (!principal || principal->IsSystemPrincipal()) {
+    return {};
+  }
+  return CloakfoxTiming::LoadKey(
+      principal->OriginAttributesRef().mUserContextId);
+}
+
 Performance::Performance(nsIGlobalObject* aGlobal)
     : DOMEventTargetHelper(aGlobal),
       mResourceTimingBufferSize(kDefaultResourceTimingBufferSize),
@@ -122,7 +133,8 @@ Performance::Performance(nsIGlobalObject* aGlobal)
       mRTPCallerType(aGlobal->GetRTPCallerType()),
       mCrossOriginIsolated(aGlobal->CrossOriginIsolated()),
       mShouldResistFingerprinting(aGlobal->ShouldResistFingerprinting(
-          RFPTarget::ReduceTimerPrecision)) {}
+          RFPTarget::ReduceTimerPrecision)),
+      mCloakfoxTimingKey(LoadCloakfoxTimingKey(aGlobal)) {}
 
 Performance::~Performance() = default;
 
@@ -147,8 +159,37 @@ DOMHighResTimeStamp Performance::Now() {
     return rawTime;
   }
 
-  return nsRFPService::ReduceTimePrecisionAsMSecs(
-      rawTime, GetRandomTimelineSeed(), mRTPCallerType);
+  const DOMHighResTimeStamp reduced =
+      nsRFPService::ReduceTimePrecisionAsMSecs(
+          rawTime, GetRandomTimelineSeed(), mRTPCallerType);
+  return PresentTimestamp(reduced);
+}
+
+DOMHighResTimeStamp Performance::PresentTimestamp(
+    DOMHighResTimeStamp aRaw, uint64_t aStreamId) const {
+  if (mRTPCallerType == RTPCallerType::SystemPrincipal ||
+      !HasCloakfoxTimingKey() || !StaticPrefs::cloakfox_enabled() ||
+      !StaticPrefs::cloakfox_opt_timer_high_precision_jitter()) {
+    return aRaw;
+  }
+  return CloakfoxTiming::TransformTimestamp(aRaw, mCloakfoxTimingKey,
+                                             aStreamId);
+}
+
+CloakfoxTiming::Interval Performance::PresentInterval(
+    DOMHighResTimeStamp aStart, DOMHighResTimeStamp aEnd,
+    uint64_t aStreamId) const {
+  if (mRTPCallerType == RTPCallerType::SystemPrincipal ||
+      !HasCloakfoxTimingKey() || !StaticPrefs::cloakfox_enabled() ||
+      !StaticPrefs::cloakfox_opt_timer_high_precision_jitter()) {
+    return {aStart, aEnd};
+  }
+  return CloakfoxTiming::TransformInterval(aStart, aEnd,
+                                            mCloakfoxTimingKey, aStreamId);
+}
+
+bool Performance::HasCloakfoxTimingKey() const {
+  return mCloakfoxTimingKey.IsValid();
 }
 
 DOMHighResTimeStamp Performance::NowUnclamped() const {
