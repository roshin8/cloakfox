+
+DOMHighResTimeStamp Performance::PresentTimestamp(
+    DOMHighResTimeStamp aRaw, uint64_t aStreamId) const {
+  if (mRTPCallerType == RTPCallerType::SystemPrincipal ||
+      !HasCloakfoxTimingKey()) {
+    return aRaw;
+  }
+  return CloakfoxTiming::TransformTimestamp(aRaw, mCloakfoxTimingKey,
+                                             aStreamId);
+}
+
+CloakfoxTiming::Interval Performance::PresentInterval(
+    DOMHighResTimeStamp aStart, DOMHighResTimeStamp aEnd,
+    uint64_t aStreamId) const {
+  if (mRTPCallerType == RTPCallerType::SystemPrincipal ||
+      !HasCloakfoxTimingKey()) {
+    return {aStart, aEnd};
+  }
+  return CloakfoxTiming::TransformInterval(aStart, aEnd,
+                                            mCloakfoxTimingKey, aStreamId);
+}
+
+bool Performance::HasCloakfoxTimingKey() const {
+  return mCloakfoxTimingKey.IsValid();
