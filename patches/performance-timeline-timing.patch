+static CloakfoxTiming::Key LoadCloakfoxTimingKey(nsIGlobalObject* aGlobal) {
+  // Freeze the presentation mode for this global. Switching coordinates mid-
+  // timeline can move now() backwards and mix lazily read entry endpoints.
+  if (!StaticPrefs::cloakfox_enabled() ||
+      !StaticPrefs::cloakfox_opt_timer_high_precision_jitter()) {
+    return {};
+  }
+  nsIPrincipal* principal = aGlobal->PrincipalOrNull();
+  if (!principal || principal->IsSystemPrincipal()) {
+    return {};
+  }
+  auto* settings = CloakfoxSiteSeed::SettingsForGlobal(aGlobal);
+  const uint32_t ucid = principal->OriginAttributesRef().mUserContextId;
+  return {CloakfoxSiteSeed::Derive(ucid, "timing:session_key_hi", settings, "timing"),
+          CloakfoxSiteSeed::Derive(ucid, "timing:session_key_lo", settings, "timing")};
+}
