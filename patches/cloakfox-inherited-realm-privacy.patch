 webgpu::Instance* WorkerNavigator::GetGpu() {
+  // Workers have no window actor. Resolve their own origin attributes rather
+  // than the main-thread current-window container (which is 0 on workers).
+  if (MaskConfig::GetBool("navigator:webgpu:disabled", CloakfoxWorkerUcid())
+          .value_or(false)) {
+    return nullptr;
+  }
   if (!mWebGpu) {
     WorkerPrivate* workerPrivate = GetCurrentThreadWorkerPrivate();
     MOZ_ASSERT(workerPrivate);
 
     nsIGlobalObject* global = workerPrivate->GlobalScope();
     MOZ_ASSERT(global);
 
     mWebGpu = webgpu::Instance::Create(global);
