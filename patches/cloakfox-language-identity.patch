+void WorkerNavigator::GetLanguage(nsString& aLanguage) const {
+  nsTArray<nsString> languages;
+  GetLanguages(languages);
+  MOZ_ASSERT(!languages.IsEmpty());
+  aLanguage.Assign(languages[0]);
+}
+
+void WorkerNavigator::GetLanguages(nsTArray<nsString>& aLanguages) const {
+  WorkerPrivate* worker = GetCurrentThreadWorkerPrivate();
+  MOZ_ASSERT(worker);
+  if (!worker->UsesSystemPrincipal() &&
+      !worker->ShouldResistFingerprinting(RFPTarget::JSLocale) &&
+      Navigator::GetCloakfoxLanguages(worker->GetOriginAttributes().mUserContextId,
+                                     aLanguages)) {
+    return;
+  }
+  aLanguages = mProperties.mLanguages.Clone();
+}
