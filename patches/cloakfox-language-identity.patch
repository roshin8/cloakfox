 /**
  * Returns the first language from GetAcceptLanguages.
  *
  * Full details above in GetAcceptLanguages.
  */
+// A persona's language is per container, never a process LocaleService change.
+// Locale parsing/canonicalization is local and safe on worker threads too.
+/* static */
+bool Navigator::GetCloakfoxLanguages(uint32_t aUserContextId,
+                                    nsTArray<nsString>& aLanguages) {
+  if (!StaticPrefs::cloakfox_enabled()) return false;
+  nsTArray<nsString> configured;
+  const auto append = [&](const std::string& value) {
+    nsAutoCString tag(value.c_str());
+    tag.Trim(" \t\r\n");
+    tag.ReplaceChar('_', '-');
+    intl::Locale locale;
+    if (intl::LocaleParser::TryParse(tag, locale).isErr() ||
+        locale.Canonicalize().isErr()) return;
+    nsTArray<char> chars;
+    intl::nsTArrayToBufferAdapter<char> buffer(chars);
+    if (locale.ToString(buffer).isErr()) return;
+    nsString language = NS_ConvertUTF8toUTF16(
+        nsDependentCSubstring(chars.Elements(), chars.Length()));
+    if (!configured.Contains(language)) configured.AppendElement(language);
+  };
+  if (auto primary = MaskConfig::GetString("navigator.language", aUserContextId)) {
+    append(*primary);
+  }
+  if (auto accept = MaskConfig::GetString("headers.Accept-Language", aUserContextId)) {
+    nsAutoCString header(accept->c_str());
+    for (const nsDependentCSubstring& item :
+         nsCCharSeparatedTokenizer(header, ',').ToRange()) {
+      // HTTP quality weights are not part of NavigatorLanguage's BCP47 tags.
+      int32_t semicolon = item.FindChar(';');
+      nsAutoCString tag(semicolon < 0 ? item : Substring(item, 0, semicolon));
+      append(std::string(tag.get(), tag.Length()));
+    }
+  }
+  if (configured.IsEmpty()) return false;
+  aLanguages = std::move(configured);
+  return true;
+}
