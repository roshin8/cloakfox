+void PrefLanguagesChanged(const char* aPrefName, void* /* aClosure */) {
+  AssertIsOnMainThread();
+  if (aPrefName && StringBeginsWith(nsDependentCString(aPrefName), "cloakfox."_ns)) {
+    Maybe<uint32_t> container;
+    nsDependentCString pref(aPrefName);
+    if (!pref.EqualsLiteral("cloakfox.enabled")) {
+      const nsCString prefix("cloakfox.s.cloak_cfg_");
+      if (!StringBeginsWith(pref, prefix)) return;
+      nsAutoCString suffix(Substring(pref, prefix.Length()));
+      nsresult rv;
+      int64_t id = suffix.ToInteger64(&rv);
+      if (NS_FAILED(rv) || id < 0 || id > UINT32_MAX) return;
+      nsAutoCString canonical;
+      canonical.AppendPrintf("%u", static_cast<uint32_t>(id));
+      if (!suffix.Equals(canonical)) return;
+      container = Some(static_cast<uint32_t>(id));
+    }
+    // The IPC preference handler refreshes the worker-readable config mirror
+    // after pref observers run. Invalidate only once that mirror is current.
+    NS_DispatchToCurrentThread(NS_NewRunnableFunction(
+        "CloakfoxLanguageCacheChanged", [container]() {
+          nsTArray<nsString> nativeLanguages;
+          Navigator::GetAcceptLanguages(nativeLanguages, nullptr);
+          if (RuntimeService* runtime = RuntimeService::GetService()) {
+            runtime->UpdateAllWorkerLanguages(nativeLanguages, container);
+          }
+        }));
+    return;
