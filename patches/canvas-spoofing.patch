@@ -0,0 +1,82 @@
+/* Cloakfox: Per-context canvas fingerprint manager */
+#include "CanvasFingerprintManager.h"
+#include "nsPIDOMWindowInlines.h"
+
+#include <algorithm>
+#include "MaskConfig.hpp"
+#include "mozilla/dom/BrowsingContext.h"
