+// Cloakfox: noise the 6 components of a 2D affine matrix. Applied to
+// getCTM / getScreenCTM so SVG transform fingerprints differ per container.
+static gfx::Matrix CloakNoiseMatrix(gfx::Matrix m) {
+  auto seed = MaskConfig::GetUint32("canvas:seed");
+  if (!seed || seed.value() == 0) return m;
+  uint32_t s = seed.value();
+  auto n = [&s]() {
+    s = s * 1664525u + 1013904223u;
+    return (static_cast<float>(s) / 4294967295.0f - 0.5f) * 1e-4f;
+  };
+  m._11 += n(); m._12 += n();
+  m._21 += n(); m._22 += n();
+  m._31 += n(); m._32 += n();
+  return m;
 }
 
