+    const int64_t gl_y = static_cast<int64_t>(source_y) + row;
+    const int64_t image_y = framebuffer ? gl_y :
+        static_cast<int64_t>(GetDrawingBuffer()->Size().height()) - 1 - gl_y;
+    if (!base::IsValueInRangeForNumericType<int>(image_y))
+      continue;
