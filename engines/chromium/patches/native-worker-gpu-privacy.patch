+void WebGLRenderingContextBase::CloakfoxCommitPixelBytes(
+    uint8_t* data, const uint8_t* reference, uint8_t* destination,
+    GLsizei width, GLsizei height, int64_t pbo_offset) {
+  const auto params = GetPackPixelStoreParams();
+  unsigned bytes = 0, padding = 0, skip = 0;
+  if (WebGLImageConversion::ComputeImageSizeInBytes(
+          GL_RGBA, GL_UNSIGNED_BYTE, width, height, 1, params,
+          &bytes, &padding, &skip) != GL_NO_ERROR)
+    return;
+  const size_t stride = static_cast<size_t>(params.row_length > 0 ?
+                                             params.row_length : width) * 4 + padding;
+  // Two native reads start with opposite sentinel values. Only actual pixels
+  // overwrite both; clipped pixels and pack gaps retain different sentinels.
+  // The transform changes RGB low bits only, so compare the invariant high
+  // bits and alpha after protection. No framebuffer-size guess is needed,
+  // including texture mip/layer attachments and browser-owned XR buffers.
+  const auto written = [&](size_t start) {
+    return data[start + 3] == reference[start + 3] &&
+           (data[start] & 0xfe) == (reference[start] & 0xfe) &&
+           (data[start + 1] & 0xfe) == (reference[start + 1] & 0xfe) &&
+           (data[start + 2] & 0xfe) == (reference[start + 2] & 0xfe);
+  };
+  for (int row = 0; row < height; ++row) {
+    const size_t row_start = skip + static_cast<size_t>(row) * stride;
+    int column = 0;
+    while (column < width) {
+      if (!written(row_start + static_cast<size_t>(column) * 4)) {
+        ++column;
+        continue;
+      }
+      const int first = column++;
+      while (column < width &&
+             written(row_start + static_cast<size_t>(column) * 4))
+        ++column;
+      const size_t start = row_start + static_cast<size_t>(first) * 4;
+      const size_t count = static_cast<size_t>(column - first) * 4;
+      if (destination)
+        memcpy(destination + start, data + start, count);
+      else
+        ContextGL()->BufferSubData(GL_PIXEL_PACK_BUFFER, pbo_offset + start,
+                                   count, data + start);
+    }
+  }
