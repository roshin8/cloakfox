+namespace {
+bool OwnedInputFields(CefRefPtr<CefDictionaryValue> value,
+                      const std::set<std::string>& expected) {
+  if (!value) return false;
+  CefDictionaryValue::KeyList keys;
+  value->GetKeys(keys);
+  std::set<std::string> actual;
+  for (const auto& key : keys) actual.insert(key.ToString());
+  return actual == expected;
+}
+bool OwnedInputText(const CefString& text) {
+  if (text.length() > 4096) return false;
+  const auto units = text.ToString16();
+  for (size_t i = 0; i < units.size(); ++i) {
+    const auto c = units[i];
+    if ((c < 32 && c != 9 && c != 10 && c != 13) ||
+        (c >= 0x7f && c <= 0x9f) || (c >= 0xdc00 && c <= 0xdfff)) return false;
+    if (c >= 0xd800 && c <= 0xdbff) {
+      if (++i >= units.size() || units[i] < 0xdc00 || units[i] > 0xdfff) return false;
+    }
+  }
+  return true;
+}
+CefRefPtr<CefListValue> OwnedInputRange(const blink::WebRange& range) {
+  auto result = CefListValue::Create();
+  result->SetInt(0, range.StartOffset());
+  result->SetInt(1, range.EndOffset());
+  return result;
+}
+}  // namespace
+
+CefRefPtr<CefDictionaryValue> CefGetOwnedInputState(CefRefPtr<CefFrame> frame) {
+  CEF_REQUIRE_RT_RETURN(nullptr);
+  auto result = CefDictionaryValue::Create();
+  result->SetNull("field");
+  result->SetBool("editable", false);
+  result->SetBool("password", false);
+  for (const auto* key : {"selection", "composition", "caret"}) result->SetNull(key);
+  if (!frame || !frame->IsValid() || !frame->IsFocused()) return result;
+  auto* web = static_cast<CefFrameImpl*>(frame.get())->web_frame();
+  if (!web) return result;
+  const auto document = web->GetDocument();
+  const auto element = document.FocusedElement();
+  auto* controller = web->GetInputMethodController();
+  if (element.IsNull() || !element.IsConnected() || !controller ||
+      controller->TextInputType() == blink::kWebTextInputTypeNone ||
+      element.GetDomNodeId() <= 0) return result;
+  auto field = CefDictionaryValue::Create();
+  field->SetString("document", document.Token().ToString());
+  field->SetInt("node", element.GetDomNodeId());
+  result->SetDictionary("field", field);
+  result->SetBool("editable", true);
+  result->SetBool("password", controller->TextInputType() == blink::kWebTextInputTypePassword);
+  const auto selection = controller->GetSelectionOffsets();
+  if (!selection.IsNull()) result->SetList("selection", OwnedInputRange(selection));
+  const auto composition = controller->CompositionRange();
+  if (!composition.IsNull()) result->SetList("composition", OwnedInputRange(composition));
+  gfx::Rect caret;
+  if (selection.IsNull() || !web->FirstRectForCharacterRange(selection.EndOffset(), 0, caret)) {
+    // No field contents are materialized for the fallback or normal query.
+    caret = element.BoundsInWidget();
+    caret.set_width(0);
+  }
+  auto bounds = CefListValue::Create();
+  bounds->SetInt(0, std::clamp(caret.x(), -32768, 32768));
+  bounds->SetInt(1, std::clamp(caret.y(), -32768, 32768));
+  bounds->SetInt(2, std::clamp(caret.width(), 0, 4096));
+  bounds->SetInt(3, std::clamp(caret.height(), 0, 4096));
+  result->SetList("caret", bounds);
+  return result;
+}
+
+bool CefValidateOwnedInputCommand(CefRefPtr<CefDictionaryValue> command) {
+  if (!command || command->GetType("action") != VTYPE_STRING ||
+      command->GetType("field") != VTYPE_DICTIONARY) return false;
+  const auto action = command->GetString("action").ToString();
+  std::set<std::string> expected{"action", "field"};
+  if (action == "set" || action == "commit") expected.insert("text");
+  else if (action != "finish" && action != "cancel") return false;
+  if (action == "set") { expected.insert("selectionStart"); expected.insert("selectionEnd"); }
+  if (command->HasKey("replacement")) {
+    if (action != "set" && action != "commit") return false;
+    expected.insert("replacement");
+  }
+  if (!OwnedInputFields(command, expected)) return false;
+  auto field = command->GetDictionary("field");
+  if (!OwnedInputFields(field, {"document", "node"}) ||
+      field->GetType("document") != VTYPE_STRING || !field->GetString("document").length() ||
+      field->GetString("document").length() > 128 ||
+      field->GetType("node") != VTYPE_INT || field->GetInt("node") < 1) return false;
+  CefString text;
+  if (action == "set" || action == "commit") {
+    if (command->GetType("text") != VTYPE_STRING) return false;
+    text = command->GetString("text");
+    if (!OwnedInputText(text) || (action == "commit" && !text.length())) return false;
+  }
+  if (action == "set" && (command->GetType("selectionStart") != VTYPE_INT ||
+      command->GetType("selectionEnd") != VTYPE_INT || command->GetInt("selectionStart") < 0 ||
+      command->GetInt("selectionEnd") < command->GetInt("selectionStart") ||
+      command->GetInt("selectionEnd") > static_cast<int>(text.length()))) return false;
+  if (command->HasKey("replacement")) {
+    if (command->GetType("replacement") != VTYPE_LIST) return false;
+    auto range = command->GetList("replacement");
+    if (range->GetSize() != 2 || range->GetType(0) != VTYPE_INT || range->GetType(1) != VTYPE_INT ||
+        range->GetInt(0) < 0 || range->GetInt(1) < range->GetInt(0)) return false;
+  }
+  return true;
+}
+
+bool CefPerformOwnedInput(CefRefPtr<CefFrame> frame,
+                          CefRefPtr<CefDictionaryValue> command) {
+  CEF_REQUIRE_RT_RETURN(false);
+  if (!frame || !frame->IsValid() || !frame->IsFocused() ||
+      !CefValidateOwnedInputCommand(command)) return false;
+  const auto action = command->GetString("action").ToString();
+  auto field = command->GetDictionary("field");
+  CefString text;
+  if (action == "set" || action == "commit") text = command->GetString("text");
+  blink::WebRange replacement;
+  if (command->HasKey("replacement")) {
+    auto range = command->GetList("replacement");
+    replacement = blink::WebRange(range->GetInt(0), range->GetInt(1)-range->GetInt(0));
+  }
+  // Recheck the live object at final delivery in the renderer. The supplied
+  // IDs are never used to look up a node or restore a previously focused field.
+  auto* web = static_cast<CefFrameImpl*>(frame.get())->web_frame();
+  if (!web) return false;
+  const auto document = web->GetDocument();
+  const auto element = document.FocusedElement();
+  auto* controller = web->GetInputMethodController();
+  if (document.Token().ToString() != field->GetString("document").ToString() ||
+      element.IsNull() || !element.IsConnected() || element.GetDomNodeId() != field->GetInt("node") ||
+      !controller || controller->TextInputType() == blink::kWebTextInputTypeNone) return false;
+  if (action == "set") {
+    if (controller->TextInputType() == blink::kWebTextInputTypePassword) return false;
+    std::vector<ui::ImeTextSpan> spans;
+    if (text.length()) spans.emplace_back(ui::ImeTextSpan::Type::kComposition, 0, text.length());
+    return controller->SetComposition(blink::WebString(text.ToString16()), spans, replacement,
+        command->GetInt("selectionStart"), command->GetInt("selectionEnd"));
+  }
+  if (action == "commit")
+    return controller->CommitText(blink::WebString(text.ToString16()), {}, replacement, 0);
+  if (action == "finish")
+    return controller->FinishComposingText(blink::WebInputMethodController::kDoNotKeepSelection);
+  return controller->SetComposition(blink::WebString(), {}, blink::WebRange(), 0, 0);
+}
