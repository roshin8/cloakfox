+CefRefPtr<CefDictionaryValue> CefBrowserContext::ParseInitialPrivacySnapshot(const CefString& json) {
+  if (!json.length() || json.length() > 16384) return nullptr;
+  auto value = CefParseJSON(json, JSON_PARSER_RFC);
+  auto snapshot = value && value->GetType() == VTYPE_DICTIONARY ? value->GetDictionary() : nullptr;
+  if (!ExactFields(snapshot, {"schemaVersion", "container", "private", "revision", "seed",
+                             "canvasEnabled", "webgpuReadbackBlocked", "presentation"})) return nullptr;
+  if (snapshot->GetType("schemaVersion") != VTYPE_INT || snapshot->GetInt("schemaVersion") != 1 ||
+      snapshot->GetType("container") != VTYPE_STRING || snapshot->GetType("private") != VTYPE_BOOL ||
+      snapshot->GetType("revision") != VTYPE_INT || snapshot->GetInt("revision") < 1 ||
+      snapshot->GetType("seed") != VTYPE_STRING || snapshot->GetType("canvasEnabled") != VTYPE_BOOL ||
+      snapshot->GetType("webgpuReadbackBlocked") != VTYPE_BOOL ||
+      snapshot->GetType("presentation") != VTYPE_DICTIONARY) return nullptr;
+  const auto container = snapshot->GetString("container").ToString();
+  int owner = 0;
+  if (container.empty() || container.front() == '0' ||
+      container.find_first_not_of("0123456789") != std::string::npos ||
+      !base::StringToInt(container, &owner) || owner < 1) return nullptr;
+  const auto seed = snapshot->GetString("seed").ToString();
+  if (seed.size() != 64 || seed.find_first_not_of("0123456789abcdef") != std::string::npos) return nullptr;
+  auto presentation = snapshot->GetDictionary("presentation");
+  if (presentation->GetSize()) {
+    if (!ExactFields(presentation, {"navigator", "language", "timezone", "hardwareConcurrency",
+                                    "deviceMemory", "locale", "languages", "timezoneId"})) return nullptr;
+    for (const auto* key : {"navigator", "language", "timezone"})
+      if (presentation->GetType(key) != VTYPE_BOOL) return nullptr;
+    if (presentation->GetType("hardwareConcurrency") != VTYPE_INT ||
+        presentation->GetInt("hardwareConcurrency") < 1 || presentation->GetInt("hardwareConcurrency") > 128 ||
+        presentation->GetType("deviceMemory") != VTYPE_INT ||
+        !std::set<int>{4,8}.count(presentation->GetInt("deviceMemory")) ||
+        presentation->GetType("locale") != VTYPE_STRING || presentation->GetType("languages") != VTYPE_STRING ||
+        presentation->GetType("timezoneId") != VTYPE_STRING) return nullptr;
+    const std::set<std::pair<std::string,std::string>> regions{
+      {"en-US","en-US,en"},{"en-GB","en-GB,en"},{"de-DE","de-DE,de"},
+      {"fr-FR","fr-FR,fr"},{"ja-JP","ja-JP,ja"}};
+    if (!regions.count({presentation->GetString("locale").ToString(),presentation->GetString("languages").ToString()}) ||
