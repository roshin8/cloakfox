+#ifndef SRC_DAWN_NATIVE_METAL_CLOAKFOXPIXELNOISE_H_
+#define SRC_DAWN_NATIVE_METAL_CLOAKFOXPIXELNOISE_H_
+namespace dawn::native::metal {
+// Native-only HMAC-SHA256, matching CloakfoxCanvasReadback. The input is the
+// little-endian 64-bit x/y followed by canonical RGB high bits. Only copied
+// opaque pixels change; source textures, alpha and linear-layout gaps do not.
+inline constexpr char kCloakfoxPixelNoise[] = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+constant uint cfK[64] = {
+0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
+0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
+0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
+0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
+0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
+0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
+0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
+0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u};
+uint cfR(uint x,uint n){return (x>>n)|(x<<(32u-n));}
+uint cfSwap(uint x){return ((x&255u)<<24)|((x&65280u)<<8)|((x>>8)&65280u)|(x>>24);}
+void cfInit(thread uint* h){
+ h[0]=0x6a09e667u;h[1]=0xbb67ae85u;h[2]=0x3c6ef372u;h[3]=0xa54ff53au;
+ h[4]=0x510e527fu;h[5]=0x9b05688cu;h[6]=0x1f83d9abu;h[7]=0x5be0cd19u;
+}
+void cfBlock(thread uint* h,thread uint* w){
+ for(uint i=16;i<64;i++){
+  uint a=w[i-15],b=w[i-2];
+  w[i]=(cfR(b,17)^cfR(b,19)^(b>>10))+w[i-7]+(cfR(a,7)^cfR(a,18)^(a>>3))+w[i-16];
+ }
+ uint a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],j=h[7];
+ for(uint i=0;i<64;i++){
+  uint t=j+(cfR(e,6)^cfR(e,11)^cfR(e,25))+((e&f)^((~e)&g))+cfK[i]+w[i];
+  uint u=(cfR(a,2)^cfR(a,13)^cfR(a,22))+((a&b)^(a&c)^(b&c));
+  j=g;g=f;f=e;e=d+t;d=c;c=b;b=a;a=t+u;
+ }
+ h[0]+=a;h[1]+=b;h[2]+=c;h[3]+=d;h[4]+=e;h[5]+=f;h[6]+=g;h[7]+=j;
+}
+struct CfParams {
+ ulong offset;uint bytesPerRow,rowsPerImage;
+ uint width,height,depth,originX,originY,bgra;uint key[8];
+};
+kernel void cloakfoxPixelNoise(device uchar* bytes [[buffer(0)]],
+ constant CfParams& p [[buffer(1)]],uint3 pos [[thread_position_in_grid]]){
+ if(pos.x>=p.width||pos.y>=p.height||pos.z>=p.depth)return;
+ ulong address=p.offset+(ulong(pos.z)*p.rowsPerImage+pos.y)*p.bytesPerRow+ulong(pos.x)*4u;
+ device uchar* pixel=bytes+address;
+ if(pixel[3]!=255)return;
+ uint r=p.bgra?2u:0u,b=p.bgra?0u:2u;
+ uint highR=uint(pixel[r])&254u,highG=uint(pixel[1])&254u,highB=uint(pixel[b])&254u;
+ uint h[8],inner[8],w[64];cfInit(h);
+ for(uint i=0;i<16;i++)w[i]=(i<8?p.key[i]:0u)^0x36363636u;
+ cfBlock(h,w);
+ for(uint i=0;i<16;i++)w[i]=0u;
+ w[0]=cfSwap(p.originX+pos.x);w[2]=cfSwap(p.originY+pos.y);
+ w[4]=(highR<<24)|(highG<<16)|(highB<<8)|128u;w[15]=664u;
+ cfBlock(h,w);for(uint i=0;i<8;i++)inner[i]=h[i];
+ cfInit(h);for(uint i=0;i<16;i++)w[i]=(i<8?p.key[i]:0u)^0x5c5c5c5cu;
+ cfBlock(h,w);
+ for(uint i=0;i<16;i++)w[i]=i<8?inner[i]:0u;
+ w[8]=0x80000000u;w[15]=768u;cfBlock(h,w);
+ pixel[r]=uchar(highR|((h[0]>>24)&1u));
+ pixel[1]=uchar(highG|((h[0]>>16)&1u));
+ pixel[b]=uchar(highB|((h[0]>>8)&1u));
+}
+)MSL";
+}  // namespace dawn::native::metal
