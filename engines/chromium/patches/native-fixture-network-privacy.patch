+bool ChromeContentBrowserClientCef::AllowWebSocketForBrowserContext(
+    content::BrowserContext* context, const GURL& url) {
+  CEF_REQUIRE_UIT();
+  auto cef_context = CefBrowserContext::FromBrowserContext(context);
+  if (!cef_context) {
+    const auto& cache_path = Profile::FromBrowserContext(context)->GetPath();
+    if (!cache_path.empty()) cef_context = CefBrowserContext::FromCachePath(cache_path);
+  }
+  auto snapshot = cef_context ? cef_context->initial_privacy_snapshot() : nullptr;
+  if (!snapshot || !snapshot->HasKey("fixtureOrigin")) return true;
+  const GURL origin(snapshot->GetString("fixtureOrigin").ToString());
+  return url.is_valid() && url.SchemeIs("ws") && url.host() == origin.host() &&
+      url.EffectiveIntPort() == origin.EffectiveIntPort() &&
+      !url.has_username() && !url.has_password();
+}
