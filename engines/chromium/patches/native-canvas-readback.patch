+// Copyright 2026 Cloakfox contributors. BSD-3-Clause.
+#include "third_party/blink/renderer/core/canvas_interventions/cloakfox_canvas.h"
+
+#include <array>
+#include <optional>
+#include <string>
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "crypto/hmac.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/workers/worker_global_scope.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/network/blink_schemeful_site.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+
+namespace blink {
+namespace {
+using Key = std::array<uint8_t, 32>;
+std::optional<Key> SiteKey(ExecutionContext* context) {
+  const auto key = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "cloakfox-canvas-key");
+  if (key.size() != 64 || !context)
+    return std::nullopt;
+  std::optional<BlinkSchemefulSite> owner_site;
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    // Browser-provided committed storage identity survives frame detachment.
+    // Force the accessor's partitioned view without changing storage policy.
+    owner_site = window->GetStorageKey()
+                     .CopyWithForceEnabledThirdPartyStoragePartitioning()
+                     .GetTopLevelSite();
+  } else if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    const auto* origin = worker->top_level_frame_security_origin();
+    if (origin && !origin->IsOpaque())
+      owner_site = BlinkSchemefulSite(scoped_refptr<const SecurityOrigin>(origin));
+  }
+  // Shared/service worker ownership and opaque origins require separate
+  // browser-provided partition identity plumbing; do not collapse to "null".
+  if (!owner_site || owner_site->IsOpaque())
+    return std::nullopt;
+  const auto site = std::string("cloakfox-canvas-v1:") + owner_site->Serialize().Utf8();
+  return crypto::hmac::SignSha256(base::as_byte_span(key), base::as_byte_span(site));
+}
+void Transform(const Key& key, const SkPixmap& pixels, int sx, int sy) {
+  // Preserve other formats and color spaces until those paths are validated.
+  if (pixels.colorType() != kRGBA_8888_SkColorType ||
+      (pixels.colorSpace() && !pixels.colorSpace()->isSRGB()))
+    return;
+  for (int y = 0; y < pixels.height(); ++y) {
+    for (int x = 0; x < pixels.width(); ++x) {
+      auto* p = static_cast<uint8_t*>(pixels.writable_addr(x, y));
+      // Preserve alpha, blank pixels and premultiplication rounding behavior.
+      if (p[3] != 255)
+        continue;
+      const int64_t ax = static_cast<int64_t>(sx) + x;
+      const int64_t ay = static_cast<int64_t>(sy) + y;
+      if (ax < 0 || ay < 0)
+        continue;
+      std::array<uint8_t, 19> input{};
+      for (int i = 0; i < 8; ++i) {
+        input[i] = static_cast<uint64_t>(ax) >> (i * 8);
+        input[8 + i] = static_cast<uint64_t>(ay) >> (i * 8);
+      }
+      for (int c = 0; c < 3; ++c)
+        input[16 + c] = p[c] & 0xfe;
+      const auto bits = crypto::hmac::SignSha256(key, input);
+      for (int c = 0; c < 3; ++c)
+        p[c] = (p[c] & 0xfe) | (bits[c] & 1);
+    }
+  }
+}
+}  // namespace
+
+void CloakfoxCanvasReadback(ExecutionContext* context, const SkPixmap& pixels,
+                            int sx, int sy) {
+  if (const auto key = SiteKey(context))
+    Transform(*key, pixels, sx, sy);
+}
+
+scoped_refptr<StaticBitmapImage> CloakfoxCanvasExport(
+    ExecutionContext* context, scoped_refptr<StaticBitmapImage> image) {
+  const auto key = SiteKey(context);
+  if (!key || !image)
+    return image;
+  const auto paint = image->PaintImageForCurrentFrame();
+  const auto original_info = paint.GetSkImageInfo();
+  if (original_info.colorType() != kRGBA_8888_SkColorType &&
+      original_info.colorType() != kBGRA_8888_SkColorType)
+    return image;
+  if (original_info.colorSpace() && !original_info.colorSpace()->isSRGB())
+    return image;
+  const auto info = original_info.makeColorType(kRGBA_8888_SkColorType)
+                       .makeAlphaType(kUnpremul_SkAlphaType);
+  const auto size = info.computeMinByteSize();
+  if (SkImageInfo::ByteSizeOverflowed(size))
+    return nullptr;
+  auto data = SkData::MakeUninitialized(size);
+  SkPixmap pixels(info, data->writable_data(), info.minRowBytes());
+  if (!paint.readPixels(info, pixels.writable_addr(), pixels.rowBytes(), 0, 0))
+    return nullptr;
+  Transform(*key, pixels, 0, 0);
+  return UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromData(info, std::move(data), pixels.rowBytes()));
+}
+}  // namespace blink
